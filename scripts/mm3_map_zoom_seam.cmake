# Apply speed zoom to the map's common world scale, after native scale setup
# and before any roads or markers. Preserve all original guest instructions.
function(mm3_add_map_zoom source_variable function_name)
    set(content "${${source_variable}}")
    set(reset_original [=[loc_0011CA25: ;
    PUSH32(esp, ebp);]=])
    set(reset_replacement [=[loc_0011CA25: ;
    mm3_map_zoom_reset(ecx);
    PUSH32(esp, ebp);]=])
    set(update_original [=[loc_0011D1E8: ;
    PUSH32(esp, ebp);]=])
    set(update_replacement [=[loc_0011D1E8: ;
    mm3_map_zoom_update(ecx, MEMF(esp + 0x10));
    PUSH32(esp, ebp);]=])
    set(apply_original [=[loc_0011D8F6: ;
    PUSH32(esp, edi);]=])
    set(apply_replacement [=[loc_0011D8F6: ;
    mm3_map_zoom_apply(ebx, MEM32(ebp + -4));
    PUSH32(esp, edi);]=])
    string(FIND "${content}" "\r\n" crlf_position)
    if(crlf_position LESS 0)
        set(newline "\n")
    else()
        set(newline "\r\n")
        foreach(block reset update apply)
            string(REPLACE "\n" "\r\n" ${block}_original "${${block}_original}")
            string(REPLACE "\n" "\r\n" ${block}_replacement "${${block}_replacement}")
        endforeach()
    endif()
    if(function_name STREQUAL "sub_0011CA25")
        set(block reset)
    elseif(function_name STREQUAL "sub_0011D1E8")
        set(block update)
    elseif(function_name STREQUAL "sub_0011D808")
        set(block apply)
    else()
        message(FATAL_ERROR "MM3 map zoom: unsupported owner ${function_name}")
    endif()
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    string(FIND "${content}" "void ${function_name}(void)" owner_start)
    if(NOT owner_count EQUAL 1 OR owner_start LESS 0)
        message(FATAL_ERROR "MM3 map zoom: missing or duplicate ${function_name}")
    endif()
    string(SUBSTRING "${content}" ${owner_start} -1 owner_tail)
    string(FIND "${owner_tail}" "\nvoid " owner_end)
    if(owner_end LESS 0)
        set(body "${owner_tail}")
    else()
        string(SUBSTRING "${owner_tail}" 0 ${owner_end} body)
    endif()
    string(FIND "${body}" "${${block}_original}" position)
    if(position LESS 0)
        message(FATAL_ERROR "MM3 map zoom: original ${block} boundary changed")
    endif()
    string(LENGTH "${${block}_original}" length)
    math(EXPR after "${position} + ${length}")
    string(SUBSTRING "${body}" ${after} -1 tail)
    string(FIND "${tail}" "${${block}_original}" duplicate)
    if(NOT duplicate LESS 0)
        message(FATAL_ERROR "MM3 map zoom: duplicate ${block} boundary")
    endif()
    string(REPLACE "${${block}_original}" "${${block}_replacement}" transformed "${body}")
    string(REPLACE "${body}" "${transformed}" content "${content}")
    set(declarations "#include <stdint.h>${newline}extern void mm3_map_zoom_reset(uint32_t);${newline}extern void mm3_map_zoom_update(uint32_t, float);${newline}extern void mm3_map_zoom_apply(uint32_t, uint32_t);${newline}")
    string(FIND "${content}" "extern void mm3_map_zoom_reset(" declared)
    if(declared LESS 0)
        set(content "${declarations}${content}")
    endif()
    set(${source_variable} "${content}" PARENT_SCOPE)
endfunction()
