# The GameCamera owns the large top-screen Arrow mesh. Skip its isolated
# submission block while retaining the camera's player visibility loop and
# native saved registers/return. Minimap turn icons and world markers stay native.
function(mm3_hide_navigation_arrows source_variable)
    set(content "${${source_variable}}")
    set(owner sub_001EC352)
    set(original [=[    _fa = (uint32_t)(MEM32(esi + 0xE8)) & 0xFFFFFFFFu; _fb = (uint32_t)(ebx) & 0xFFFFFFFFu;
    _fas = (int32_t)(int32_t)(_fa); _fbs = (int32_t)(int32_t)(_fb); /* cmp MEM32(esi + 0xE8), ebx (32-bit) */
    PUSH32(esp, edi);
    if (CMP_EQ(_fa, _fb)) goto loc_001EC3AC; /* je: equal / zero */]=])
    string(REPLACE "    if (CMP_EQ(_fa, _fb)) goto loc_001EC3AC; /* je: equal / zero */"
        "    goto loc_001EC3AC; /* Top navigation arrow hidden. */" replacement "${original}")
    string(REGEX MATCHALL "void ${owner}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    if(NOT owner_count EQUAL 1)
        message(FATAL_ERROR "MM3 HUD cleanup: missing or duplicate ${owner}")
    endif()
    string(FIND "${content}" "void ${owner}(void)" owner_start)
    string(SUBSTRING "${content}" ${owner_start} -1 owner_tail)
    string(FIND "${owner_tail}" "\nvoid " owner_end)
    if(owner_end LESS 0)
        set(body "${owner_tail}")
    else()
        string(SUBSTRING "${owner_tail}" 0 ${owner_end} body)
    endif()
    string(FIND "${content}" "\r\n" crlf)
    if(NOT crlf LESS 0)
        string(REPLACE "\n" "\r\n" original "${original}")
        string(REPLACE "\n" "\r\n" replacement "${replacement}")
    endif()
    string(FIND "${body}" "${original}" position)
    if(position LESS 0)
        message(FATAL_ERROR "MM3 HUD cleanup: original camera Arrow boundary changed or already patched")
    endif()
    string(LENGTH "${original}" length)
    math(EXPR after "${position} + ${length}")
    string(SUBSTRING "${body}" ${after} -1 tail)
    string(FIND "${tail}" "${original}" duplicate)
    if(NOT duplicate LESS 0)
        message(FATAL_ERROR "MM3 HUD cleanup: duplicate camera Arrow boundary")
    endif()
    string(REPLACE "${original}" "${replacement}" transformed "${body}")
    string(REPLACE "${body}" "${transformed}" content "${content}")
    set(${source_variable} "${content}" PARENT_SCOPE)
endfunction()
