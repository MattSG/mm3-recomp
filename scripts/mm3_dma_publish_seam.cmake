# Route two recovered XDK queue publications through the runtime's register
# semantics. Keep guest registers, flags, software-channel stores and the
# final reads in both original wait loops intact.
function(mm3_add_dma_publish source_variable function_name)
    set(content "${${source_variable}}")
    if(function_name STREQUAL "sub_00344900")
        set(store "    MEM32(eax + 0x40) = esi;")
        set(published "    xbox_Nv2aDmaPublish(eax + 0x40u, esi);")
        set(wait_label "loc_00344940: ;")
    elseif(function_name STREQUAL "sub_003449B0")
        set(store "    MEM32(eax + 0x40) = edx;")
        set(published "    xbox_Nv2aDmaPublish(eax + 0x40u, edx);")
        set(wait_label "loc_003449F0: ;")
    else()
        message(FATAL_ERROR "MM3 DMA publication: unsupported owner ${function_name}")
    endif()
    set(owner "void ${function_name}(void)")
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    string(FIND "${content}" "${owner}" owner_start)
    if(NOT owner_count EQUAL 1 OR owner_start LESS 0)
        message(FATAL_ERROR "MM3 DMA publication: missing or duplicate ${function_name}")
    endif()
    string(SUBSTRING "${content}" ${owner_start} -1 tail)
    string(FIND "${tail}" "\nvoid " owner_end)
    if(owner_end LESS 0)
        set(body "${tail}")
    else()
        string(SUBSTRING "${tail}" 0 ${owner_end} body)
    endif()
    string(REPLACE " ;" "" label_pattern "${wait_label}")
    string(REGEX MATCHALL "${label_pattern}" labels "${body}")
    list(LENGTH labels label_count)
    string(FIND "${body}" "${store}" store_start)
    string(FIND "${body}" "${wait_label}" wait_start)
    if(store_start LESS 0 OR wait_start LESS store_start OR NOT label_count EQUAL 1)
        message(FATAL_ERROR "MM3 DMA publication: original ${function_name} store/wait changed")
    endif()
    string(LENGTH "${store}" store_length)
    math(EXPR after_store "${store_start} + ${store_length}")
    string(SUBSTRING "${body}" ${after_store} -1 after_body)
    string(FIND "${after_body}" "${store}" another_store)
    if(NOT another_store LESS 0)
        message(FATAL_ERROR "MM3 DMA publication: duplicate ${function_name} store")
    endif()
    string(FIND "${content}" "\r\n" crlf_position)
    if(crlf_position LESS 0)
        set(newline "\n")
    else()
        set(newline "\r\n")
    endif()
    set(wait_read "${wait_label}${newline}    ecx = MEM32(eax + 0x3240);")
    string(FIND "${body}" "${wait_read}" read_start)
    if(read_start LESS 0)
        message(FATAL_ERROR "MM3 DMA publication: original ${function_name} final wait read changed")
    endif()
    string(REPLACE "${store}" "${published}" transformed "${body}")
    string(REPLACE "${wait_read}"
        "${wait_label}${newline}    xbox_Nv2aDmaWait(eax);${newline}    ecx = MEM32(eax + 0x3240);"
        transformed "${transformed}")
    string(REPLACE "${body}" "${transformed}" content "${content}")
    string(FIND "${content}" "extern void xbox_Nv2aDmaPublish(" declared)
    if(declared LESS 0)
        set(declarations "#include <stdint.h>${newline}extern void xbox_Nv2aDmaPublish(uint32_t put_va, uint32_t value);${newline}extern void xbox_Nv2aDmaWait(uint32_t pfifo_base_va);${newline}")
        set(content "${declarations}${content}")
    endif()
    set(${source_variable} "${content}" PARENT_SCOPE)
endfunction()
