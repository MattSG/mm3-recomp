cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../scripts/mm3_collision_call_seam.cmake")

# Locate the actual lifted owners rather than assuming a generated chunk name.
# Each fixture is independently read from generated code, not from the seam.
if(DEFINED FIXTURE_PATH)
    file(READ "${FIXTURE_PATH}" original)
else()
file(GLOB chunks "${CMAKE_CURRENT_LIST_DIR}/../src/recomp/gen/recomp_*.c")
set(original "")
foreach(owner sub_0013FE96 sub_0014E808)
    set(found FALSE)
    foreach(chunk IN LISTS chunks)
        file(STRINGS "${chunk}" definitions REGEX "^void ${owner}[(]void[)]$")
        if(NOT definitions)
            continue()
        endif()
        if(found)
            message(FATAL_ERROR "Duplicate generated collision owner ${owner}")
        endif()
        file(READ "${chunk}" source)
        string(REPLACE "\r\n" "\n" source "${source}")
        string(FIND "${source}" "void ${owner}(void)" begin)
        string(SUBSTRING "${source}" ${begin} -1 tail)
        string(FIND "${tail}" "\n}\n" end)
        if(end LESS 0)
            message(FATAL_ERROR "No complete generated collision owner ${owner}")
        endif()
        math(EXPR length "${end} + 3")
        string(SUBSTRING "${tail}" 0 ${length} body)
        string(APPEND original "${body}\n")
        set(found TRUE)
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Generate MM3 code before running this test: missing ${owner}")
    endif()
endforeach()
# An identical call outside either owner must remain untouched.
string(APPEND original [=[void unrelated(void)
{
    RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x0013FEB6u);
}
]=])
endif()

if(DEFINED REJECT_CASE)
    if(REJECT_OWNER STREQUAL "sub_0014E808")
        set(site 0014E8B6)
        set(return_va 0014E8B9)
    else()
        set(REJECT_OWNER sub_0013FE96)
        set(site 0013FEB6)
        set(return_va 0013FEB9)
    endif()
    if(REJECT_CASE STREQUAL "missing_owner")
        string(REPLACE "void ${REJECT_OWNER}(void)" "void different(void)" original "${original}")
    elseif(REJECT_CASE STREQUAL "duplicate_owner")
        string(APPEND original "void ${REJECT_OWNER}(void)\n{}\n")
    elseif(REJECT_CASE STREQUAL "missing_call")
        string(REPLACE "0x${site}u" "0x00123456u" original "${original}")
    elseif(REJECT_CASE STREQUAL "duplicate_call")
        string(REPLACE "void ${REJECT_OWNER}(void)\n{"
            "void ${REJECT_OWNER}(void)\n{\n    RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x${site}u);"
            original "${original}")
    elseif(REJECT_CASE STREQUAL "method")
        string(REPLACE "MEM32(eax + 0x5C)" "MEM32(eax + 0x64)" original "${original}")
    elseif(REJECT_CASE STREQUAL "return")
        string(REPLACE "PUSH32(esp, 0x${return_va}u)" "PUSH32(esp, 0x00123456u)" original "${original}")
    elseif(REJECT_CASE STREQUAL "callee")
        string(REPLACE "RECOMP_ABI_CALL(0x001C7E60u, sub_001C7E60)"
            "RECOMP_ABI_CALL(0x001C7E64u, sub_001C7E64)" original "${original}")
    elseif(REJECT_CASE STREQUAL "push")
        string(REPLACE "    PUSH32(esp, eax);" "    /* argument push removed */" original "${original}")
    elseif(REJECT_CASE STREQUAL "cleanup")
        string(REPLACE "loc_${return_va}: ;" "loc_${return_va}: ;\n    esp += 12;" original "${original}")
    elseif(REJECT_CASE STREQUAL "already_fixed")
        string(REPLACE "RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x${site}u)"
            "RECOMP_ICALL_SAFE_AT_CC(_icall_target, _icall_esp, 0x${site}u)" original "${original}")
    elseif(REJECT_CASE STREQUAL "unsupported")
        set(REJECT_OWNER sub_0013FF6E)
    else()
        message(FATAL_ERROR "Unknown rejection case")
    endif()
    mm3_fix_collision_calls(original ${REJECT_OWNER})
    message(FATAL_ERROR "Invalid collision seam accepted")
endif()

foreach(line_endings LF CRLF)
    set(expected "${original}")
    if(line_endings STREQUAL "CRLF")
        string(REPLACE "\n" "\r\n" expected "${expected}")
    endif()
    set(transformed "${expected}")
    mm3_fix_collision_calls(transformed sub_0013FE96)
    mm3_fix_collision_calls(transformed sub_0014E808)
    string(REGEX MATCHALL "RECOMP_ICALL_SAFE_AT_CC[(]" calls "${transformed}")
    list(LENGTH calls call_count)
    if(NOT call_count EQUAL 3)
        message(FATAL_ERROR "Expected exactly three collision caller-cleanup fixes")
    endif()
    set(restored "${transformed}")
    foreach(site 0013FEB6 0013FEE5 0014E8B6)
        string(REPLACE "RECOMP_ICALL_SAFE_AT_CC(_icall_target, _icall_esp, 0x${site}u)"
            "RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x${site}u)" restored "${restored}")
    endforeach()
    if(NOT restored STREQUAL expected)
        message(FATAL_ERROR "Collision seam changed other guest instructions")
    endif()
endforeach()
set(fixture_path "${CMAKE_CURRENT_BINARY_DIR}/mm3_collision_seam_fixture.c")
file(WRITE "${fixture_path}" "${original}")
foreach(owner sub_0013FE96 sub_0014E808)
    foreach(reject_case missing_owner duplicate_owner missing_call duplicate_call method return callee push cleanup already_fixed unsupported)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DREJECT_CASE=${reject_case}" "-DREJECT_OWNER=${owner}" "-DFIXTURE_PATH=${fixture_path}"
            -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE rejected
            OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(rejected EQUAL 0 OR NOT error MATCHES "MM3 collision argument cleanup")
            message(FATAL_ERROR "Invalid ${owner} ${reject_case} seam was not rejected: ${error}")
        endif()
    endforeach()
endforeach()
message(STATUS "PASS: three collision call fixes, exact guest instructions, unrelated calls, LF/CRLF and 22 invalid owner/argument/reuse anchors")
