From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Graham <matt.sg@hotmail.com>
Date: Sun, 25 Oct 2026 23:19:58 +0000
Subject: [PATCH 12/12] tests: kernel_geometry links libm only where it exists

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/kernel_geometry/CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/kernel_geometry/CMakeLists.txt b/tests/kernel_geometry/CMakeLists.txt
index 17c508fc..d771923e 100644
--- a/tests/kernel_geometry/CMakeLists.txt
+++ b/tests/kernel_geometry/CMakeLists.txt
@@ -9,6 +9,8 @@ add_executable(recomp_kernel_geometry test_kernel_geometry.c
     ../../src/kernel/guest_read.c
     ../../src/kernel/thick_line.c)
 target_include_directories(recomp_kernel_geometry PRIVATE ../../src ../../src/kernel)
-target_link_libraries(recomp_kernel_geometry PRIVATE m)
+if(NOT MSVC)
+    target_link_libraries(recomp_kernel_geometry PRIVATE m)
+endif()
 enable_testing()
 add_test(NAME recomp_kernel_geometry COMMAND recomp_kernel_geometry)
