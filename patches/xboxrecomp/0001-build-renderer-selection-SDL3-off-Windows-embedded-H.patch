diff --git a/CMakeLists.txt b/CMakeLists.txt
index 427f5d8c..552d7b27 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,21 +1,54 @@
 cmake_minimum_required(VERSION 3.20)
 project(xboxrecomp VERSION 0.14.0 LANGUAGES C)
 
+# Recompiled x86 code relies on what MSVC does anyway: signed arithmetic wraps
+# like the CPU's, and guest memory is read through whatever pointer type an
+# instruction implies. GCC and Clang optimise both away as undefined
+# behaviour unless told not to.
+if(NOT MSVC)
+    add_compile_options(-fwrapv -fno-strict-aliasing)
+endif()
+
 # Xbox Static Recompilation Runtime Library
 # Provides link-time libraries for statically recompiled Xbox games.
 # Pattern: extract emulator subsystems (xemu) into reusable static libraries.
 #
-# Libraries:
-#   xbox_kernel    - Xbox kernel replacement layer (147 imports → Win32)
-#   xbox_d3d8      - D3D8 → D3D11 graphics compatibility
-#   xbox_dsound    - DirectSound → software mixer compatibility
-#   xbox_input     - Xbox gamepad → XInput compatibility
-#   xbox_apu       - MCPX APU audio emulation (extracted from xemu)
-#   xbox_nv2a      - NV2A GPU emulation (extracted from xemu)
+# Runtime modules and their transitive host dependencies are declared below.
+# Link the xboxrecomp interface target rather than relying on a snapshot count.
 
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED ON)
 
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
+
+# The host renderer. D3D11 is Windows-only and the default there; SDL3_GPU
+# (Vulkan, Direct3D 12 or Metal through SDL3) is the one choice elsewhere.
+# SDL3_GPU also moves the window and its input to SDL3, and off Windows the
+# audio output and game controllers too.
+if(WIN32)
+    set(_xbr_renderer_default D3D11)
+else()
+    set(_xbr_renderer_default SDL3_GPU)
+endif()
+set(XBOXRECOMP_RENDERER "${_xbr_renderer_default}" CACHE STRING "Host renderer: D3D11 or SDL3_GPU")
+set_property(CACHE XBOXRECOMP_RENDERER PROPERTY STRINGS D3D11 SDL3_GPU)
+if(XBOXRECOMP_RENDERER STREQUAL "SDL3_GPU")
+    set(XBOXRECOMP_SDL3 ON)
+    include(Sdl3)
+    include(Dxc)
+elseif(XBOXRECOMP_RENDERER STREQUAL "D3D11")
+    if(NOT WIN32)
+        message(FATAL_ERROR "XBOXRECOMP_RENDERER=D3D11 needs Windows; use SDL3_GPU")
+    endif()
+    set(XBOXRECOMP_SDL3 OFF)
+else()
+    message(FATAL_ERROR "XBOXRECOMP_RENDERER must be D3D11 or SDL3_GPU, not ${XBOXRECOMP_RENDERER}")
+endif()
+message(STATUS "xboxrecomp renderer: ${XBOXRECOMP_RENDERER}")
+if(XBOXRECOMP_SDL3)
+    add_compile_definitions(XBOXRECOMP_SDL3=1)
+endif()
+
 # Common definitions for all targets
 add_compile_definitions(
     WIN32_LEAN_AND_MEAN
@@ -53,9 +86,15 @@ add_subdirectory(src/usb)
 # Input: Xbox gamepad → XInput
 add_subdirectory(src/input)
 
+# Network: Ethernet controller, NAT and peer tunnel
+add_subdirectory(src/net)
+
 # Shared FMV player (Media Foundation -> D3D8 texture)
 add_subdirectory(src/video)
 
+# Host bring-up: MMIO routing to the APU/USB/NV2A models, window and device
+add_subdirectory(src/host)
+
 # ── Umbrella target ───────────────────────────────────────────
 
 # Convenience target that links all runtime libraries
@@ -65,9 +104,11 @@ set(XBOXRECOMP_LIBS
     xbox_dsound
     xbox_input
     xbox_usb
+    xbox_net
     xbox_apu
     xbox_nv2a
     xbox_video
+    xbox_host
 )
 add_library(xboxrecomp INTERFACE)
 if(UNIX AND NOT APPLE)
diff --git a/cmake/Dxc.cmake b/cmake/Dxc.cmake
new file mode 100644
index 00000000..732423ba
--- /dev/null
+++ b/cmake/Dxc.cmake
@@ -0,0 +1,37 @@
+# The DirectX Shader Compiler, which builds the SDL3 GPU renderer's HLSL into
+# SPIR-V (Vulkan) and DXIL (Direct3D 12). The Windows SDK's dxc has no SPIR-V
+# back end, so the pinned official release is downloaded unless
+# XBOXRECOMP_DXC names a dxc built with SPIR-V support. (Its Linux build runs on
+# glibc 2.35, Ubuntu 22.04; later releases need 2.38.)
+#
+# Sets XBOXRECOMP_DXC (cache) to the dxc executable.
+if(XBOXRECOMP_DXC)
+    return()
+endif()
+include(FetchContent)
+if(POLICY CMP0135)
+    cmake_policy(SET CMP0135 NEW)   # archive timestamps: extraction time
+endif()
+set(_dxc_release https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.8.2505.1)
+if(CMAKE_HOST_WIN32)
+    FetchContent_Declare(dxc
+        URL ${_dxc_release}/dxc_2025_07_14.zip
+        URL_HASH SHA256=9ad895a6b039e3a8f8c22a1009f866800b840a74b50db9218d13319e215ea8a4)
+    set(_dxc_exe bin/x64/dxc.exe)
+elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
+    FetchContent_Declare(dxc
+        URL ${_dxc_release}/linux_dxc_2025_07_14.x86_64.tar.gz
+        URL_HASH SHA256=f2213da1fc99dc8778c8823078e16ba97c7f80f86a1d4520ab1adf4b462bc48c)
+    set(_dxc_exe bin/dxc)
+else()
+    message(FATAL_ERROR "No pinned dxc for this host: set XBOXRECOMP_DXC to a dxc built with SPIR-V support")
+endif()
+FetchContent_MakeAvailable(dxc)
+set(_dxc "${dxc_SOURCE_DIR}/${_dxc_exe}")
+execute_process(COMMAND "${_dxc}" --version RESULT_VARIABLE _dxc_status OUTPUT_QUIET ERROR_VARIABLE _dxc_error)
+if(NOT _dxc_status EQUAL 0)
+    message(FATAL_ERROR "The downloaded dxc does not run here (${_dxc_error}): "
+                        "set XBOXRECOMP_DXC to a dxc built with SPIR-V support")
+endif()
+set(XBOXRECOMP_DXC "${_dxc}" CACHE FILEPATH "dxc with SPIR-V support" FORCE)
+message(STATUS "dxc: ${XBOXRECOMP_DXC}")
diff --git a/cmake/EmbedText.cmake b/cmake/EmbedText.cmake
new file mode 100644
index 00000000..1fd90844
--- /dev/null
+++ b/cmake/EmbedText.cmake
@@ -0,0 +1,23 @@
+# Writes the concatenation of INPUTS (files, separated by |) to OUT as a C string
+# constant named NAME, one string literal per source line, so no literal
+# reaches a compiler's length limit. OUT is replaced only when it changes.
+#
+#   cmake -DNAME=s_hlsl -DOUT=out.inc "-DINPUTS=a.hlsl|b.hlsl" -P EmbedText.cmake
+#
+# (| separates INPUTS: a ; would not survive add_custom_command.)
+if(NOT NAME OR NOT OUT OR NOT INPUTS)
+    message(FATAL_ERROR "EmbedText.cmake needs NAME, OUT and INPUTS")
+endif()
+string(REPLACE "|" ";" INPUTS "${INPUTS}")
+set(text "")
+foreach(input IN LISTS INPUTS)
+    file(READ "${input}" chunk)
+    string(APPEND text "${chunk}")
+endforeach()
+string(REPLACE "\r" "" text "${text}")
+string(REPLACE "\\" "\\\\" text "${text}")
+string(REPLACE "\"" "\\\"" text "${text}")
+string(REPLACE "\n" "\\n\"\n\"" text "${text}")
+file(WRITE "${OUT}.tmp" "/* Generated by cmake/EmbedText.cmake. Do not edit. */\nstatic const char ${NAME}[] =\n\"${text}\";\n")
+execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
+file(REMOVE "${OUT}.tmp")
diff --git a/cmake/Nv2aHlsl.cmake b/cmake/Nv2aHlsl.cmake
new file mode 100644
index 00000000..ec4104f2
--- /dev/null
+++ b/cmake/Nv2aHlsl.cmake
@@ -0,0 +1,62 @@
+# The NV2A renderer's HLSL (src/video/shaders): the parts in the order the
+# D3D11 renderer compiles them, and xbr_embed_nv2a_hlsl(<target>), which gives
+# a target that compiles src/video/nv2a_d3d11.c the generated nv2a_hlsl.inc it
+# includes. Used by src/video and by the tests that build the renderer
+# directly. Port selection: docs/technical/shader-overrides.md.
+get_filename_component(_xbr_hlsl_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
+set(NV2A_HLSL_DIR ${_xbr_hlsl_root}/src/video/shaders)
+set(NV2A_HLSL_PARTS
+    ${NV2A_HLSL_DIR}/nv2a_bindings.hlsli
+    ${NV2A_HLSL_DIR}/nv2a_varyings.hlsli
+    ${NV2A_HLSL_DIR}/nv2a_vertex.hlsl
+    ${NV2A_HLSL_DIR}/nv2a_combiner.hlsl
+    ${NV2A_HLSL_DIR}/nv2a_present.hlsl
+    ${NV2A_HLSL_DIR}/nv2a_clear.hlsl
+    ${NV2A_HLSL_DIR}/nv2a_y16.hlsl)
+# Optional application-owned replacements, by the shipped fragment filename.
+# Select before adding the toolkit. Unspecified fragments retain shared sources.
+if(XBOXRECOMP_NV2A_SHADER_DIR)
+    if(NOT IS_ABSOLUTE "${XBOXRECOMP_NV2A_SHADER_DIR}" OR
+       NOT IS_DIRECTORY "${XBOXRECOMP_NV2A_SHADER_DIR}")
+        message(FATAL_ERROR "XBOXRECOMP_NV2A_SHADER_DIR must be an existing absolute directory")
+    endif()
+    file(GLOB_RECURSE _xbr_shader_dependencies CONFIGURE_DEPENDS
+        "${XBOXRECOMP_NV2A_SHADER_DIR}/*.hlsl" "${XBOXRECOMP_NV2A_SHADER_DIR}/*.hlsli")
+    set(_xbr_selected_parts)
+    foreach(_part IN LISTS NV2A_HLSL_PARTS)
+        get_filename_component(_name "${_part}" NAME)
+        if(EXISTS "${XBOXRECOMP_NV2A_SHADER_DIR}/${_name}")
+            list(APPEND _xbr_selected_parts "${XBOXRECOMP_NV2A_SHADER_DIR}/${_name}")
+        else()
+            list(APPEND _xbr_selected_parts "${_part}")
+        endif()
+    endforeach()
+    set(NV2A_HLSL_PARTS ${_xbr_selected_parts})
+else()
+    set(_xbr_shader_dependencies)
+endif()
+# Depth conversion is a caller-owned extension, not a shipped approximation.
+set(NV2A_DEPTH_VIEW_SHADER "")
+if(XBOXRECOMP_NV2A_SHADER_DIR AND EXISTS "${XBOXRECOMP_NV2A_SHADER_DIR}/nv2a_y16d.hlsl")
+    set(NV2A_DEPTH_VIEW_SHADER "${XBOXRECOMP_NV2A_SHADER_DIR}/nv2a_y16d.hlsl")
+    list(APPEND NV2A_HLSL_PARTS "${NV2A_DEPTH_VIEW_SHADER}")
+endif()
+set(NV2A_HLSL_DEPENDS ${NV2A_HLSL_PARTS} ${_xbr_shader_dependencies})
+
+set(_XBR_EMBED_TEXT ${_xbr_hlsl_root}/cmake/EmbedText.cmake)
+
+function(xbr_embed_nv2a_hlsl target)
+    if(NV2A_DEPTH_VIEW_SHADER)
+        target_compile_definitions(${target} PRIVATE XBOXRECOMP_DEPTH_VIEW_SHADER=1)
+    endif()
+    set(gen ${CMAKE_CURRENT_BINARY_DIR}/${target}_generated)
+    string(JOIN "|" parts ${NV2A_HLSL_PARTS})
+    add_custom_command(OUTPUT ${gen}/nv2a_hlsl.inc
+        COMMAND ${CMAKE_COMMAND} -DNAME=s_hlsl -DOUT=${gen}/nv2a_hlsl.inc
+                "-DINPUTS=${parts}" -P ${_XBR_EMBED_TEXT}
+        DEPENDS ${NV2A_HLSL_DEPENDS} ${_XBR_EMBED_TEXT}
+        COMMENT "Embedding the D3D11 renderer's HLSL for ${target}"
+        VERBATIM)
+    target_sources(${target} PRIVATE ${gen}/nv2a_hlsl.inc)
+    target_include_directories(${target} PRIVATE ${gen})
+endfunction()
diff --git a/cmake/Nv2aSdlgpu.cmake b/cmake/Nv2aSdlgpu.cmake
new file mode 100644
index 00000000..f16b2e65
--- /dev/null
+++ b/cmake/Nv2aSdlgpu.cmake
@@ -0,0 +1,102 @@
+# The SDL3 GPU renderer's shaders and dependencies, for any target that builds
+# src/video/nv2a_sdlgpu.c (the runtime itself and the tests of that backend).
+#
+#   xbr_sdlgpu_shaders(<gen_dir> <out_var>)
+#       Compiles each shaders/sdlgpu/ compile unit with DXC into
+#       <gen_dir>/sdlgpu/<name>.<format>.h (SPIR-V; DXIL on Windows) and sets
+#       <out_var> to the list of headers. nv2a_sdlgpu.c includes them.
+#
+#   xbr_nv2a_sdlgpu_target(<target>)
+#       Gives <target> the generated headers, SDL3 (SDL3::SDL3) and the include
+#       path nv2a_sdlgpu.c needs, with XBOXRECOMP_SDL3=1 defined, as the runtime
+#       does. The caller's own source includes nv2a_sdlgpu.c and supplies the
+#       host callbacks it leaves out (see tests/nv2a_sdlgpu_test_host.h).
+#
+# Uses the runtime's own rules (cmake/Sdl3.cmake, cmake/Dxc.cmake,
+# cmake/Nv2aHlsl.cmake); nothing is copied here.
+include_guard(GLOBAL)
+
+get_filename_component(_xbr_sdlgpu_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
+include(${_xbr_sdlgpu_root}/cmake/Nv2aHlsl.cmake)
+
+function(xbr_sdlgpu_shaders gen out)
+    set(_sdl_shaders
+        "ub ub_vs vs"
+        "combiner ps_main ps"
+        "combiner ps_wdepth ps"
+        "combiner ps_main ps ps_main_flat FLATQ=nointerpolation"
+        "combiner ps_wdepth ps ps_wdepth_flat FLATQ=nointerpolation"
+        "present present_vs vs"
+        "present present_ps ps"
+        "clear clear_vs vs"
+        "clear clear_ps ps"
+        "y16 y16_vs vs"
+        "y16 y16_ps ps")
+    if(NV2A_DEPTH_VIEW_SHADER)
+        list(APPEND _sdl_shaders "y16d y16d_ps ps")
+    endif()
+    set(_formats spirv)
+    if(WIN32)
+        list(APPEND _formats dxil)
+    endif()
+    set(_shader_headers)
+    foreach(_spec IN LISTS _sdl_shaders)
+        string(REPLACE " " ";" _spec "${_spec}")
+        list(GET _spec 0 _unit)
+        list(GET _spec 1 _entry)
+        list(GET _spec 2 _stage)
+        set(_name ${_entry})
+        set(_defines)
+        list(LENGTH _spec _n)
+        if(_n GREATER 3)
+            list(GET _spec 3 _name)
+            list(GET _spec 4 _define)
+            set(_defines -D ${_define})
+        endif()
+        # Resolve the same selected fragments as D3D11's embedded source.
+        set(_unit_input "${NV2A_HLSL_DIR}/sdlgpu/${_unit}.hlsl")
+        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_unit_input}")
+        file(READ "${_unit_input}" _unit_text)
+        foreach(_part IN LISTS NV2A_HLSL_PARTS)
+            get_filename_component(_part_name "${_part}" NAME)
+            string(REPLACE "\"../${_part_name}\"" "\"${_part}\"" _unit_text "${_unit_text}")
+        endforeach()
+        set(_unit_source "${gen}/units/${_unit}.hlsl")
+        file(CONFIGURE OUTPUT "${_unit_source}" CONTENT "${_unit_text}" @ONLY)
+        string(TOUPPER ${_stage} _STAGE)
+        foreach(_format IN LISTS _formats)
+            set(_out ${gen}/sdlgpu/${_name}.${_format}.h)
+            if(_format STREQUAL "spirv")
+                set(_flags -spirv -fspv-target-env=vulkan1.0 -fvk-use-dx-layout)
+            else()
+                set(_flags)
+            endif()
+            add_custom_command(OUTPUT ${_out}
+                COMMAND ${CMAKE_COMMAND} -E make_directory ${gen}/sdlgpu
+                COMMAND ${XBOXRECOMP_DXC} -nologo -HV 2018 -Wno-ignored-attributes
+                        -T ${_stage}_6_0 -E ${_entry} -D SDLGPU -D STAGE_${_STAGE} ${_defines}
+                        ${_flags} -Fh ${_out} -Vn ${_name}_${_format}
+                        ${_unit_source}
+                DEPENDS ${_unit_source} ${_unit_input} ${NV2A_HLSL_DEPENDS}
+                COMMENT "dxc ${_name} (${_format})"
+                VERBATIM)
+            list(APPEND _shader_headers ${_out})
+        endforeach()
+    endforeach()
+    set(${out} ${_shader_headers} PARENT_SCOPE)
+endfunction()
+
+function(xbr_nv2a_sdlgpu_target target)
+    if(NV2A_DEPTH_VIEW_SHADER)
+        target_compile_definitions(${target} PRIVATE XBOXRECOMP_DEPTH_VIEW_SHADER=1)
+    endif()
+    include(${_xbr_sdlgpu_root}/cmake/Dxc.cmake)
+    include(${_xbr_sdlgpu_root}/cmake/Sdl3.cmake)
+    set(_gen ${CMAKE_CURRENT_BINARY_DIR}/${target}_generated)
+    xbr_sdlgpu_shaders(${_gen} _headers)
+    target_sources(${target} PRIVATE ${_headers})
+    target_include_directories(${target} PRIVATE ${_gen}
+        ${_xbr_sdlgpu_root}/src ${_xbr_sdlgpu_root}/src/video)
+    target_link_libraries(${target} PRIVATE SDL3::SDL3)
+    target_compile_definitions(${target} PRIVATE XBOXRECOMP_SDL3=1)
+endfunction()
diff --git a/cmake/Sdl3.cmake b/cmake/Sdl3.cmake
new file mode 100644
index 00000000..0efd58cf
--- /dev/null
+++ b/cmake/Sdl3.cmake
@@ -0,0 +1,33 @@
+# SDL3 for the SDL3 GPU renderer, its window and (off Windows) audio and pads.
+# An installed SDL3 (3.2 or newer) is used when CMake finds one; otherwise the
+# pinned release is downloaded and built as a static library.
+#
+# Defines the target SDL3::SDL3.
+if(TARGET SDL3::SDL3)
+    return()
+endif()
+find_package(SDL3 3.2 CONFIG QUIET)
+if(SDL3_FOUND)
+    message(STATUS "SDL3: using installed ${SDL3_VERSION}")
+    return()
+endif()
+include(FetchContent)
+if(POLICY CMP0135)
+    cmake_policy(SET CMP0135 NEW)   # archive timestamps: extraction time
+endif()
+set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+set(SDL_STATIC ON CACHE BOOL "" FORCE)
+set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
+set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(SDL_TESTS OFF CACHE BOOL "" FORCE)
+set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
+find_package(Git REQUIRED)
+FetchContent_Declare(SDL3
+    URL https://github.com/libsdl-org/SDL/releases/download/release-3.4.16/SDL3-3.4.16.tar.gz
+    URL_HASH SHA256=7322236cd12090c3eb40b9728be4d49c76f66ad17d04369584d4ecad5cf77c68
+    PATCH_COMMAND "${GIT_EXECUTABLE}" apply --ignore-whitespace "${CMAKE_CURRENT_LIST_DIR}/sdl3-d3d12-descriptors.patch")
+FetchContent_MakeAvailable(SDL3)
+if(NOT TARGET SDL3::SDL3 AND TARGET SDL3::SDL3-static)
+    add_library(SDL3::SDL3 ALIAS SDL3-static)
+endif()
+message(STATUS "SDL3: building 3.4.16 from source")
diff --git a/cmake/sdl3-d3d12-descriptors.patch b/cmake/sdl3-d3d12-descriptors.patch
new file mode 100644
index 00000000..8e12d826
--- /dev/null
+++ b/cmake/sdl3-d3d12-descriptors.patch
@@ -0,0 +1,27 @@
+--- a/src/gpu/d3d12/SDL_gpu_d3d12.c
++++ b/src/gpu/d3d12/SDL_gpu_d3d12.c
+@@ -5073,9 +5073,22 @@
+ {
+     D3D12GraphicsPipeline *graphicsPipeline = commandBuffer->currentGraphicsPipeline;
+
+-    /* Acquire GPU descriptor heaps if we haven't yet */
+-    if (commandBuffer->gpuDescriptorHeaps[0] == NULL) {
++    /* Reserve the whole draw before binding tables: switching heaps midway
++     * invalidates tables already bound, even when each individual copy fits. */
++    Uint32 samplers = graphicsPipeline->header.num_vertex_samplers + graphicsPipeline->header.num_fragment_samplers;
++    Uint32 views = samplers + graphicsPipeline->header.num_vertex_storage_textures +
++        graphicsPipeline->header.num_fragment_storage_textures + graphicsPipeline->header.num_vertex_storage_buffers +
++        graphicsPipeline->header.num_fragment_storage_buffers;
++    if (commandBuffer->gpuDescriptorHeaps[0] == NULL ||
++        views > commandBuffer->gpuDescriptorHeaps[0]->maxDescriptors - commandBuffer->gpuDescriptorHeaps[0]->currentDescriptorIndex ||
++        samplers > commandBuffer->gpuDescriptorHeaps[1]->maxDescriptors - commandBuffer->gpuDescriptorHeaps[1]->currentDescriptorIndex) {
+         D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
++        commandBuffer->needVertexSamplerBind = true;
++        commandBuffer->needVertexStorageTextureBind = true;
++        commandBuffer->needVertexStorageBufferBind = true;
++        commandBuffer->needFragmentSamplerBind = true;
++        commandBuffer->needFragmentStorageTextureBind = true;
++        commandBuffer->needFragmentStorageBufferBind = true;
+     }
+
+     D3D12_CPU_DESCRIPTOR_HANDLE cpuHandles[MAX_TEXTURE_SAMPLERS_PER_STAGE];
diff --git a/include/xbox/xboxrecomp.h b/include/xbox/xboxrecomp.h
index a5fee2f0..4561fd69 100644
--- a/include/xbox/xboxrecomp.h
+++ b/include/xbox/xboxrecomp.h
@@ -8,7 +8,7 @@
  *   1. Build xboxrecomp as a static library (cmake --build)
  *   2. Link against the 'xboxrecomp' umbrella target (or individual libs)
  *   3. Implement the required callbacks (see "Game Integration Points" below)
- *   4. Call xbox_memory_init() to set up the 64MB Xbox address space
+ *   4. Call xbox_MemoryLayoutInit() with the original XBE to load its memory image
  *   5. Call xbox_kernel_init() / xbox_kernel_bridge_init() to wire up kernel imports
  *
  * Libraries provided:
@@ -34,9 +34,9 @@
  *
  * Global state (defined in xbox_memory_layout.c):
  *   extern ptrdiff_t g_xbox_mem_offset;  // Native-to-Xbox VA offset
- *   extern uint32_t  g_eax, g_ecx, g_edx, g_esp;  // Volatile registers
- *   extern uint32_t  g_ebx, g_esi, g_edi;          // Callee-saved registers
- *   extern uint32_t  g_seh_ebp;                      // SEH frame pointer
