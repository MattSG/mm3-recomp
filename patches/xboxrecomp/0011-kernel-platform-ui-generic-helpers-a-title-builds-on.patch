@@ -0,0 +1,13 @@
+/* Kochanek–Bartels Hermite evaluation for one spline segment.
+ *
+ * p[0..3] are the segment's control points (p[1] and p[2] bracket the segment).
+ * u runs 0..1 across it. bias, tension and continuity are the Kochanek–Bartels
+ * shape parameters; zero for all three gives the Catmull-Rom curve. */
+#ifndef KB_SPLINE_H
+#define KB_SPLINE_H
+
+typedef struct { float x, y, z; } KbPoint;
+
+KbPoint kb_segment_point(const KbPoint p[4], float u, float bias, float tension, float continuity);
+
+#endif
diff --git a/src/kernel/nv2a_pb_recovery.c b/src/kernel/nv2a_pb_recovery.c
new file mode 100644
index 00000000..13c0cfb5
--- /dev/null
+++ b/src/kernel/nv2a_pb_recovery.c
@@ -0,0 +1,44 @@
+#include "nv2a_pb_recovery.h"
+#include "nv2a_pb.h"
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <stdio.h>
+#include <string.h>
+
+/* The stop handler's range must be a whole word inside contiguous guest RAM. */
+static int pb_word_in_window(uint32_t va)
+{
+    return (va & 3u) == 0 && va - XBOX_CONTIG_BASE <= XBOX_CONTIG_SIZE - 4u;
+}
+
+void nv2a_pb_recover_semaphore_stop(uint32_t from, uint32_t to, const char *reason)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    static unsigned reports;
+    uint32_t last, releases;
+    int found = 0;
+    (void)reason;
+    if (from >= to || !pb_word_in_window(from) || !pb_word_in_window(to - 4u))
+        return;
+    last = nv2a_pb_exec_semaphore_last_value();
+    /* Heuristic: an odd value just past the last release can mistake payload
+     * for a command. Keep it opt-in until malformed submissions are fixed. */
+    for (uint32_t va = from; va + 4u < to; va += 4u) {
+        uint32_t word, value;
+        memcpy(&word, mem + va, 4);
+        if (word != 0x00041D70u)
+            continue;
+        memcpy(&value, mem + va + 4u, 4);
+        if ((value & 1u) && (int32_t)(value - last) > 0 && value - last <= 128u) {
+            last = value;
+            found = 1;
+        }
+    }
+    if (!found)
+        return;
+    releases = nv2a_pb_exec_semaphore_releases();
+    nv2a_pb_exec_method(0, 0x1D70u, last);
+    if (reports++ < 8)
+        fprintf(stderr, "[NV2A_PB] stop recovery fence=0x%08X released=%d\n",
+            last, nv2a_pb_exec_semaphore_releases() != releases);
+}
diff --git a/src/kernel/nv2a_pb_recovery.h b/src/kernel/nv2a_pb_recovery.h
new file mode 100644
index 00000000..b3c4344e
--- /dev/null
+++ b/src/kernel/nv2a_pb_recovery.h
@@ -0,0 +1,15 @@
+/* Opt-in stop recovery for a malformed push-buffer submission.
+ *
+ * After a submission stops on data that is not a command, this searches the
+ * skipped words for a semaphore release (method 0x1D70 with an odd value one
+ * to 128 past the last release) and executes the last one found, so a title
+ * waiting on that fence is not stuck. It guesses, so it is never a default:
+ * register it with nv2a_pb_set_stop_handler only where the title needs it. */
+#ifndef NV2A_PB_RECOVERY_H
+#define NV2A_PB_RECOVERY_H
+
+#include <stdint.h>
+
+void nv2a_pb_recover_semaphore_stop(uint32_t from, uint32_t to, const char *reason);
+
+#endif
diff --git a/src/kernel/nv2a_wbc_flush.c b/src/kernel/nv2a_wbc_flush.c
new file mode 100644
index 00000000..246ad7b2
--- /dev/null
+++ b/src/kernel/nv2a_wbc_flush.c
@@ -0,0 +1,63 @@
+/* XDK write-back-cache kick for the NV2A command stream.
+ *
+ * The retail routine fences guest writes, sets NV_PFB_WBC_FLUSH and waits for
+ * the executor to acknowledge by clearing it. A byte-lag threshold cannot prove
+ * the executor has consumed a reused push-buffer or produced a result the guest
+ * is about to read, so every kick waits for the acknowledgement. */
+#include "nv2a_wbc_flush.h"
+#include "../nv2a/nv2a_regs.h"
+#include "platform/xbox_winnt.h"
+#include "xbox_memory_layout.h"
+#include <stdio.h>
+#include <xmmintrin.h>
+
+/* Device object: the NV2A register block pointer lives at device+0x17C8. */
+#define NV2A_DEVICE_REGS_OFFSET 0x17C8u
+/* PFB base plus NV_PFB_WBC: the flush word is in the register block. */
+#define NV2A_PFB_WBC_ADDRESS (0x00100000u + NV_PFB_WBC)
+
+static uint32_t wbc_guest32(uint32_t va)
+{
+    return *(volatile uint32_t *)((uintptr_t)va + (uintptr_t)xbox_GetMemoryOffset());
+}
+
+static void wbc_guest32_store(uint32_t va, uint32_t value)
+{
+    *(volatile uint32_t *)((uintptr_t)va + (uintptr_t)xbox_GetMemoryOffset()) = value;
+}
+
+/* The ack thread clears the bit between segments. A dead thread would spin
+ * forever with no sign in the log, so report the wait every two seconds. It
+ * keeps waiting: leaving early would let the title reuse push-buffer space the
+ * executor has not read yet. */
+static void wbc_wait_ack(uint32_t flush_va)
+{
+    LARGE_INTEGER freq, start, now;
+    LONGLONG last;
+    unsigned reports = 0;
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&start);
+    last = start.QuadPart;
+    while (wbc_guest32(flush_va) & NV_PFB_WBC_FLUSH) {
+        QueryPerformanceCounter(&now);
+        if (now.QuadPart - last >= 2 * freq.QuadPart) {
+            last = now.QuadPart;
+            fprintf(stderr, "[KICK_WAIT] ack bit 0x10000 at 0x%08X still set after %.1f s (report %u)\n",
+                    flush_va, (double)(now.QuadPart - start.QuadPart) / freq.QuadPart,
+                    ++reports);
+        }
+    }
+}
+
+void xbox_Nv2aWbcFlush(uint32_t device_ptr_va, uint32_t *object_out, uint32_t *value_out)
+{
+    uint32_t object = wbc_guest32(wbc_guest32(device_ptr_va) + NV2A_DEVICE_REGS_OFFSET);
+    uint32_t flush = object + NV2A_PFB_WBC_ADDRESS;
+    uint32_t value;
+    _mm_sfence();
+    value = wbc_guest32(flush) | NV_PFB_WBC_FLUSH;
+    wbc_guest32_store(flush, value);
+    wbc_wait_ack(flush);
+    if (object_out) *object_out = object;
+    if (value_out) *value_out = value;
+}
