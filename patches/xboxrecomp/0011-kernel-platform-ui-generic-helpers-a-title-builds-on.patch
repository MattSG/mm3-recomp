diff --git a/src/platform/line_server.c b/src/platform/line_server.c
new file mode 100644
index 00000000..5e31e98b
--- /dev/null
+++ b/src/platform/line_server.c
@@ -0,0 +1,144 @@
+#include "line_server.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include "platform/xbox_winnt.h"
+#include <errno.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <unistd.h>
+#endif
+
+#if !defined(_WIN32)
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+#endif
+
+static LineServerAnswer s_answer;
+#if defined(_WIN32)
+static char s_pipe_name[96];
+#endif
+
+#if defined(_WIN32)
+static DWORD WINAPI pipe_thread(void *unused)
+{
+    for (;;) {
+        HANDLE pipe = CreateNamedPipeA(s_pipe_name, PIPE_ACCESS_DUPLEX,
+            PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+            1, 2048, 2048, 0, NULL);
+        if (pipe == INVALID_HANDLE_VALUE) return 1;
+        if (ConnectNamedPipe(pipe, NULL) || GetLastError() == ERROR_PIPE_CONNECTED) {
+            char command[128] = {0}, reply[2048];
+            DWORD bytes;
+            if (ReadFile(pipe, command, sizeof(command) - 1, &bytes, NULL)) {
+                command[bytes] = 0;
+                s_answer(command, reply, sizeof(reply));
+                if (WriteFile(pipe, reply, (DWORD)strlen(reply), &bytes, NULL))
+                    FlushFileBuffers(pipe); /* do not discard an unread reply on disconnect */
+            }
+        }
+        DisconnectNamedPipe(pipe);
+        CloseHandle(pipe);
+    }
+}
+#else
+static char socket_path[sizeof(((struct sockaddr_un *)0)->sun_path)];
+
+static void socket_unlink(void)
+{
+    unlink(socket_path);
+}
+
+static int socket_path_init(const char *name)
+{
+    const char *dir = getenv("XDG_RUNTIME_DIR");
+    int n;
+    if (!dir || !*dir) dir = "/tmp";
+    n = snprintf(socket_path, sizeof(socket_path), "%s/%s-%lu.sock",
+                 dir, name, (unsigned long)getpid());
+    if (n < 0 || (size_t)n >= sizeof(socket_path)) return 0;
+    atexit(socket_unlink);
+    return 1;
+}
+
+/* Request: bytes up to the first newline, or until the client half-closes.
+ * Reply: the text, then the connection closes (the client reads to EOF). */
+static void serve_connection(int fd)
+{
+    char command[128] = {0}, reply[2048];
+    size_t used = 0, sent = 0, len;
+    ssize_t got;
+    /* A client that sends neither a newline nor a half-close must not hold the
+     * single accept loop; the timeout drops it. */
+    struct timeval idle = {2, 0};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &idle, sizeof idle);
+    while (used < sizeof(command) - 1 &&
+           (got = recv(fd, command + used, sizeof(command) - 1 - used, 0)) != 0) {
+        if (got < 0) {
+            if (errno == EINTR) continue;
+            break;
+        }
+        used += (size_t)got;
+        if (memchr(command, '\n', used)) break;
+    }
+    command[used] = 0;
+    command[strcspn(command, "\r\n")] = 0;
+    s_answer(command, reply, sizeof(reply));
+    len = strlen(reply);
+    while (sent < len) {
+        ssize_t w = send(fd, reply + sent, len - sent, MSG_NOSIGNAL);
+        if (w < 0 && errno == EINTR) continue;
+        if (w <= 0) break;
+        sent += (size_t)w;
+    }
+}
+
+static DWORD WINAPI socket_thread(void *unused)
+{
+    struct sockaddr_un addr;
+    int listener;
+    (void)unused;
+    listener = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (listener < 0) return 1;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    snprintf(addr.sun_path, sizeof(addr.sun_path), "%s", socket_path);
+    unlink(socket_path); /* stale file, if a dead process left one behind */
+    if (bind(listener, (struct sockaddr *)&addr, sizeof(addr)) != 0 || listen(listener, 4) != 0) {
+        close(listener);
+        return 1;
+    }
+    for (;;) {
+        int fd = accept(listener, NULL, NULL);
+        if (fd < 0) {
+            if (errno == EINTR || errno == ECONNABORTED) continue;
+            close(listener);
+            return 1;
+        }
+        serve_connection(fd);
+        close(fd);
+    }
+}
+#endif
+
+int line_server_start(const char *name, LineServerAnswer answer)
+{
+    HANDLE thread;
+    s_answer = answer;
+#if defined(_WIN32)
+    snprintf(s_pipe_name, sizeof(s_pipe_name), "\\\\.\\pipe\\%s-%lu", name, GetCurrentProcessId());
+    thread = CreateThread(NULL, 0, pipe_thread, NULL, 0, NULL);
+#else
+    if (!socket_path_init(name)) return 0;
+    thread = CreateThread(NULL, 0, socket_thread, NULL, 0, NULL);
+#endif
+    if (!thread) return 0;
+    CloseHandle(thread);
+    return 1;
+}
diff --git a/src/platform/line_server.h b/src/platform/line_server.h
new file mode 100644
index 00000000..50402eb3
--- /dev/null
+++ b/src/platform/line_server.h
@@ -0,0 +1,18 @@
+/* Local control server: one request line in, one reply out, per connection.
+ *
+ * Windows serves a message-mode named pipe, \\.\pipe\<name>-<pid>. Other hosts
+ * serve a Unix stream socket, $XDG_RUNTIME_DIR/<name>-<pid>.sock (else /tmp),
+ * removed at exit. A request is read up to the first newline, or until the
+ * client half-closes; the reply is written and the connection closed. The
+ * answer callback owns the protocol. */
+#ifndef PLATFORM_LINE_SERVER_H
+#define PLATFORM_LINE_SERVER_H
+
+#include <stddef.h>
+
+typedef void (*LineServerAnswer)(const char *request, char *reply, size_t size);
+
+/* Starts the server thread. Returns 1 when it is running. */
+int line_server_start(const char *name, LineServerAnswer answer);
+
+#endif
diff --git a/src/ui/rmlui_host.cpp b/src/ui/rmlui_host.cpp
new file mode 100644
index 00000000..82714cb8
--- /dev/null
+++ b/src/ui/rmlui_host.cpp
@@ -0,0 +1,176 @@
+#include "rmlui_host.h"
+#include <RmlUi_Backend.h>
+#include <stdio.h>
+
+#if defined(XBOXRECOMP_SDL3)
+#include <SDL3/SDL.h>
+extern "C" int xbox_FramebufferStartHidden(void);
+extern "C" void xbox_FramebufferSdlHints(void);
+#else
+#include <RmlUi_Renderer_DX11.h>
+#include <windows.h>
+#include <dwmapi.h>
+#endif
+
+#if !defined(XBOXRECOMP_SDL3)
+/* A dark caption in the client's colour instead of the light default. */
+static void dark_title_bar(int icon_resource)
+{
+    HWND hwnd = NULL;
+    EnumThreadWindows(GetCurrentThreadId(), [](HWND h, LPARAM p) -> BOOL {
+        if (!IsWindowVisible(h))
+            return TRUE;
+        *(HWND *)p = h;
+        return FALSE;
+    }, (LPARAM)&hwnd);
+    if (!hwnd)
+        return;
+    const BOOL dark = TRUE;
+    const COLORREF caption = RGB(0x12, 0x14, 0x18);
+    DwmSetWindowAttribute(hwnd, 20 /* DWMWA_USE_IMMERSIVE_DARK_MODE */, &dark, sizeof dark);
+    DwmSetWindowAttribute(hwnd, 35 /* DWMWA_CAPTION_COLOR, Windows 11 */, &caption, sizeof caption);
+    if (icon_resource) {
+        if (HICON icon = LoadIconA(GetModuleHandleA(NULL), MAKEINTRESOURCEA(icon_resource))) {
+            SendMessageA(hwnd, WM_SETICON, ICON_BIG, (LPARAM)icon);
+            SendMessageA(hwnd, WM_SETICON, ICON_SMALL, (LPARAM)icon);
+        }
+    }
+}
+#endif
+
+int rmlui_host_run(const RmlUiHostOptions *options, const RmlUiHostClient *client)
+{
+    int width, height;
+#if defined(XBOXRECOMP_SDL3)
+    /* 10/9 of the window size, so the usable display bounds can shrink it. */
+    SDL_Rect work = {0, 0, options->max_width * 10 / 9, options->max_height * 10 / 9};
+    xbox_FramebufferSdlHints();   /* the same video driver choice as the game */
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO))
+        SDL_GetDisplayUsableBounds(SDL_GetPrimaryDisplay(), &work);
+    width = Rml::Math::Min(options->max_width, work.w * 9 / 10);
+    height = Rml::Math::Min(options->max_height, work.h * 9 / 10);
+    /* The SDL GPU backend ships SPIR-V shaders only, which only Vulkan takes on Windows. */
+    SDL_SetHint(SDL_HINT_GPU_DRIVER, "vulkan");
+#else
+    /* Not DPI-aware yet, so the work area is in the backend's 96-dpi units. */
+    RECT work = {0, 0, options->max_width, options->max_height};
+    SystemParametersInfoA(SPI_GETWORKAREA, 0, &work, 0);
+    width = Rml::Math::Min(options->max_width, (int)(work.right - work.left) * 9 / 10);
+    height = Rml::Math::Min(options->max_height, (int)(work.bottom - work.top) * 9 / 10);
+#endif
+    if (!Backend::Initialize(options->title, width, height, false)) {
+        if (client->unavailable)
+            client->unavailable(client->user);
+        return 0;
+    }
+#if !defined(XBOXRECOMP_SDL3)
+    if (options->dark_title_bar)
+        dark_title_bar(options->icon_resource);
+#else
+    /* A hidden start (scripts, tests), which the Win32 backend's first
+     * ShowWindow honours and SDL's window does not. */
+    if (xbox_FramebufferStartHidden()) {
+        int count = 0;
+        SDL_Window **windows = SDL_GetWindows(&count);
+        for (int i = 0; i < count; i++)
+            SDL_HideWindow(windows[i]);
+        SDL_free(windows);
+    }
+#endif
+    client->bind_system(client->user);
+    Rml::SetSystemInterface(client->system);
+    Rml::SetRenderInterface(Backend::GetRenderInterface());
+    Rml::Initialise();
+    if (client->prepare)
+        client->prepare(client->user);
+
+    Rml::Context *ctx = Rml::CreateContext(options->log_tag, Rml::Vector2i(width, height));
+    if (ctx && client->load(ctx, client->user)) {
+        bool rendered = false;
+        /* Waits for messages only in the background: in front, the controller
+         * is polled every frame (the backend presents with v-sync). */
+        while (client->keep_running(client->user) &&
+               Backend::ProcessEvents(ctx, client->on_key, !
+#if defined(XBOXRECOMP_SDL3)
+                   SDL_GetKeyboardFocus()
+#else
+                   GetActiveWindow()
+#endif
+               )) {
+            const double now = Rml::GetSystemInterface()->GetElapsedTime();
+            client->before_update(ctx, now, client->user);
+            ctx->Update();
+            client->after_update(ctx, client->user);
+            /* The first WM_SIZE can precede creation of the backend renderer.
+             * A hidden startup need not send another one: seed its viewport
+             * from the context's actual pixel size before drawing. */
+            const Rml::Vector2i dimensions = ctx->GetDimensions();
+#if !defined(XBOXRECOMP_SDL3)
+            static_cast<RenderInterface_DX11 *>(Backend::GetRenderInterface())->SetViewport(
+                dimensions.x, dimensions.y);
+#endif
+#if defined(XBOXRECOMP_SDL3)
+            /* No swapchain image while hidden or minimized, and RmlUi's SDL GPU
+             * backend then submits a cancelled command buffer: skip the frame. */
+            {
+                int count = 0;
+                SDL_Window **windows = SDL_GetWindows(&count);
+                bool drawable = count > 0 && !(SDL_GetWindowFlags(windows[0]) &
+                                               (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED));
+                SDL_free(windows);
+                if (!drawable) {
+                    SDL_Delay(16);
+                    continue;
+                }
+            }
+#endif
+            /* The SDL GPU renderer takes its viewport from each swapchain image. */
+            Backend::BeginFrame();
+            ctx->Render();
+            Backend::PresentFrame();
+            if (!rendered && (!client->frame_ok || client->frame_ok(client->user))) {
+                fprintf(stderr, "[%s] first frame rendered: %dx%d\n", options->log_tag,
+                        dimensions.x, dimensions.y);
+                fflush(stderr);
+                rendered = true;
+            }
+        }
+    }
+    Rml::Shutdown();
+    Backend::Shutdown();
+    return 1;
+}
+
+/* Candidate sans-serif pairs, regular then bold, in the order a host tries them. */
+int rmlui_host_load_sans_fonts(const char *family)
+{
+    static const char *const faces[][2] = {
+        {"C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/segoeuib.ttf"},
+        {"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+         "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"},
+        {"/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf"},
+        {"/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
+         "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"},
+        {"/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
+         "/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf"},
+        {"/System/Library/Fonts/Supplemental/Arial.ttf",
+         "/System/Library/Fonts/Supplemental/Arial Bold.ttf"},
+    };
+    for (const auto &pair : faces) {
+        FILE *regular = fopen(pair[0], "rb");
+        FILE *bold;
+        if (!regular)
+            continue;
+        fclose(regular);
+        Rml::LoadFontFace(pair[0], family, Rml::Style::FontStyle::Normal,
+                          Rml::Style::FontWeight::Normal, true);
+        bold = fopen(pair[1], "rb");
+        if (bold) {
+            fclose(bold);
+            Rml::LoadFontFace(pair[1], family, Rml::Style::FontStyle::Normal,
+                              Rml::Style::FontWeight::Bold);
+        }
+        return 1;
+    }
+    return 0;
+}
diff --git a/src/ui/rmlui_host.h b/src/ui/rmlui_host.h
new file mode 100644
index 00000000..035cc544
--- /dev/null
+++ b/src/ui/rmlui_host.h
@@ -0,0 +1,65 @@
+/* Host loop for a RmlUi window: backend start, window sizing, the frame loop
+ * and shutdown.
+ *
+ * The client is the title. It binds its system interface, loads the fonts and
+ * data model it shows, handles keys, and does the per-frame work around the
+ * context update. The host does not know what the window shows. RmlUi and its
+ * backends (RmlUi_Backend.h, RmlUi_Renderer_DX11.h or the SDL GPU backend) are
+ * the consumer's to fetch and compile. */
+#ifndef UI_RMLUI_HOST_H
+#define UI_RMLUI_HOST_H
+
+#include <RmlUi/Core.h>
+#include <stdio.h>
+
+struct RmlUiHostOptions {
+    const char *title;
+    int max_width, max_height;   /* the window is at most this, and within 90% of the work area */
+    int dark_title_bar;          /* Win32 only: dark caption; 0 keeps the light default */
+    int icon_resource;           /* Win32 only: icon resource id for the window; 0 keeps the class icon */
+    const char *log_tag;         /* prefix for the host's own diagnostics */
+};
+
+struct RmlUiHostClient {
+    void *user;
+    void (*bind_system)(void *user);  /* after the backend starts: set the client's system interface */
+    Rml::SystemInterface *system;     /* then installed with Rml::SetSystemInterface */
+    void (*prepare)(void *user);      /* after RmlUi is initialised, before the context: fonts */
+    int (*load)(Rml::Context *ctx, void *user);  /* data model and document; 0 = no window */
+    bool (*on_key)(Rml::Context *ctx, Rml::Input::KeyIdentifier key, int mods, float, bool priority);
+    int (*keep_running)(void *user);  /* 0 ends the loop */
+    void (*before_update)(Rml::Context *ctx, double now, void *user);
+    void (*after_update)(Rml::Context *ctx, void *user);  /* after the first ctx->Update() */
+    int (*frame_ok)(void *user);      /* 0 while the client has logged errors; suppresses the first-frame line */
+    void (*unavailable)(void *user);  /* the backend could not start */
+};
+
+/* Returns 1 when the backend started and the loop ran, 0 when it could not start. */
+int rmlui_host_run(const RmlUiHostOptions *options, const RmlUiHostClient *client);
+
+/* Registers the first installed sans-serif pair (regular, then bold) under family, and as the
+ * fallback face for glyphs the family lacks. Returns 0 when no candidate is installed. */
+int rmlui_host_load_sans_fonts(const char *family);
+
+/* A system interface that forwards to base and writes RmlUi's messages to
+ * stderr as "[tag] message", counting the errors. Set base before the host
+ * starts; the errors count feeds the client's first-frame check. */
+struct RmlUiHostLogSystem : Rml::SystemInterface {
+    Rml::SystemInterface *base = nullptr;
+    const char *tag = "rmlui";
+    unsigned errors = 0;
+    double GetElapsedTime() override { return base->GetElapsedTime(); }
+    void SetMouseCursor(const Rml::String &name) override { base->SetMouseCursor(name); }
+    void SetClipboardText(const Rml::String &text) override { base->SetClipboardText(text); }
+    void GetClipboardText(Rml::String &text) override { base->GetClipboardText(text); }
+    bool LogMessage(Rml::Log::Type type, const Rml::String &message) override
+    {
+        if (type == Rml::Log::LT_ERROR || type == Rml::Log::LT_ASSERT)
+            ++errors;
+        fprintf(stderr, "[%s] %s\n", tag, message.c_str());
+        fflush(stderr);
+        return true;
+    }
+};
+
+#endif
