diff --git a/src/kernel/piece_cluster.c b/src/kernel/piece_cluster.c
new file mode 100644
index 00000000..f38ef9c3
--- /dev/null
+++ b/src/kernel/piece_cluster.c
@@ -0,0 +1,97 @@
+#include "piece_cluster.h"
+#include <stdlib.h>
+
+static uint32_t *root_buf, *piece_buf, cap;
+static float (*box_buf)[4];
+
+#define FIND(x) do { while (root[x] != x) x = root[x] = root[root[x]]; } while (0)
+
+int recomp_piece_clusters(uint32_t nv, const float (*pos)[4], const uint32_t *idx,
+                          uint32_t sub, uint32_t ni, uint32_t per, float span, float gap,
+                          const void *ctx, int (*skip)(const void *ctx, uint32_t vertex),
+                          uint32_t *cluster, float (*box)[4])
+{
+    uint32_t *root = root_buf, *piece = piece_buf;
+    float (*scratch)[4] = box_buf;
+    uint32_t i, k, np = 0;
+
+    if (nv > cap) {
+        uint32_t *r = realloc(root_buf, (size_t)nv * sizeof *r);
+        uint32_t *pc = r ? realloc(piece_buf, (size_t)nv * sizeof *pc) : NULL;
+        float (*b)[4] = pc ? realloc(box_buf, (size_t)nv * sizeof *b) : NULL;
+        if (r) root_buf = r;
+        if (pc) piece_buf = pc;
+        if (!b) return 0;
+        box_buf = b;
+        cap = nv;
+        root = root_buf;
+        piece = piece_buf;
+        scratch = box_buf;
+    }
+
+    /* Pieces: vertices joined by primitives. */
+    for (i = 0; i < nv; i++) root[i] = i;
+    for (i = 0; i + per <= ni; i += per) {
+        if (skip && skip(ctx, idx[i])) continue;
+        for (k = 1; k < per; k++) {
+            uint32_t a = idx[i] - sub, b = idx[i + k] - sub;
+            if (a >= nv || b >= nv) return 0;
+            FIND(a); FIND(b);
+            if (a != b) root[b] = a;
+        }
+    }
+    for (i = 0; i < nv; i++) {
+        uint32_t r = i;
+        FIND(r);
+        if (r == i) {
+            piece[i] = np;
+            scratch[np][0] = scratch[np][2] = 1e30f;
+            scratch[np][1] = scratch[np][3] = -1e30f;
+            np++;
+        }
+    }
+    for (i = 0; i < nv; i++) {
+        uint32_t r = i, n;
+        FIND(r);
+        n = piece[r];
+        piece[i] = n;
+        if (skip && skip(ctx, sub + i)) continue;
+        if (pos[i][0] < scratch[n][0]) scratch[n][0] = pos[i][0];
+        if (pos[i][0] > scratch[n][1]) scratch[n][1] = pos[i][0];
+        if (pos[i][1] < scratch[n][2]) scratch[n][2] = pos[i][1];
+        if (pos[i][1] > scratch[n][3]) scratch[n][3] = pos[i][1];
+    }
+
+    /* Clusters: pieces on one line within gap. ponytail: O(pieces^2), fine for
+     * HUD batches of a few hundred glyphs. */
+    for (i = 0; i < np; i++) root[i] = i;
+    for (i = 0; i < np; i++)
+        for (k = i + 1; k < np; k++) {
+            uint32_t a = i, b = k;
+            /* A full-span quad overlaps every piece and stays its own. */
+            if ((scratch[i][0] <= 0.5f && scratch[i][1] >= span - 0.5f) ||
+                (scratch[k][0] <= 0.5f && scratch[k][1] >= span - 0.5f))
+                continue;
+            if (scratch[i][2] > scratch[k][3] || scratch[k][2] > scratch[i][3] ||
+                scratch[i][0] > scratch[k][1] + gap || scratch[k][0] > scratch[i][1] + gap)
+                continue;
+            FIND(a); FIND(b);
+            if (a == b) continue;
+            root[b] = a;
+            if (scratch[b][0] < scratch[a][0]) scratch[a][0] = scratch[b][0];
+            if (scratch[b][1] > scratch[a][1]) scratch[a][1] = scratch[b][1];
+            if (scratch[b][2] < scratch[a][2]) scratch[a][2] = scratch[b][2];
+            if (scratch[b][3] > scratch[a][3]) scratch[a][3] = scratch[b][3];
+        }
+
+    for (i = 0; i < nv; i++) {
+        uint32_t c = piece[i];
+        FIND(c);
+        cluster[i] = c;
+    }
+    for (i = 0; i < np; i++) {
+        box[i][0] = scratch[i][0]; box[i][1] = scratch[i][1];
+        box[i][2] = scratch[i][2]; box[i][3] = scratch[i][3];
+    }
+    return 1;
+}
diff --git a/src/kernel/piece_cluster.h b/src/kernel/piece_cluster.h
new file mode 100644
index 00000000..b1746309
--- /dev/null
+++ b/src/kernel/piece_cluster.h
@@ -0,0 +1,24 @@
+/* Groups a batch of 2D primitives into pieces, then clusters the pieces.
+ *
+ * Vertices that share a primitive form a piece (union-find over the index list),
+ * and each piece's bounding box is taken over its vertices. Pieces that lie on
+ * one line, less than gap apart, join into a cluster. A piece spanning the whole
+ * width (span) is a full-screen quad and stays its own cluster.
+ *
+ * Primitives whose first vertex the skip callback names are left out of the
+ * grouping, and so are the skipped vertices' positions. Index values are
+ * absolute; vertex i of the position array is absolute vertex sub + i. */
+#ifndef PIECE_CLUSTER_H
+#define PIECE_CLUSTER_H
+
+#include <stdint.h>
+
+/* cluster[i] receives the cluster index of vertex i, and box[c] the bounds of
+ * cluster c (x0, x1, y0, y1). Returns 0 when an index is out of range or the
+ * scratch storage cannot be allocated. */
+int recomp_piece_clusters(uint32_t nv, const float (*pos)[4], const uint32_t *idx,
+                          uint32_t sub, uint32_t ni, uint32_t per, float span, float gap,
+                          const void *ctx, int (*skip)(const void *ctx, uint32_t vertex),
+                          uint32_t *cluster, float (*box)[4]);
+
+#endif
diff --git a/src/kernel/polyline.c b/src/kernel/polyline.c
new file mode 100644
index 00000000..9e316138
--- /dev/null
+++ b/src/kernel/polyline.c
@@ -0,0 +1,38 @@
+#include "polyline.h"
+#include <string.h>
+
+void polyline_simplify_2d(const float *points, unsigned count, float tolerance,
+                          unsigned work_limit, unsigned char *keep, PolylineRange *ranges)
+{
+    unsigned pending = 1, inspected = 0;
+    if (!count) return;
+    memset(keep, 0, count);
+    keep[0] = keep[count - 1] = 1;
+    ranges[0].first = 0; ranges[0].last = count - 1;
+    while (pending) {
+        unsigned first = ranges[--pending].first;
+        unsigned last = ranges[pending].last, i, furthest = first;
+        double ax = points[2 * first], ay = points[2 * first + 1];
+        double dx = (double)points[2 * last] - ax, dy = (double)points[2 * last + 1] - ay;
+        double length2 = dx*dx + dy*dy, best = (double)tolerance * tolerance;
+        for (i = first + 1; i < last; ++i) {
+            double x = (double)points[2 * i] - ax;
+            double y = (double)points[2 * i + 1] - ay;
+            double t = length2 ? (x*dx + y*dy) / length2 : 0, distance;
+            /* RDP can be quadratic on a pathological zigzag. Bound the
+             * extra CPU work, then safely draw all original samples. */
+            if (++inspected > work_limit) {
+                memset(keep, 1, count); return;
+            }
+            t = t < 0 ? 0 : (t > 1 ? 1 : t);
+            x -= t*dx; y -= t*dy; distance = x*x + y*y;
+            if (distance > best) { best = distance; furthest = i; }
+        }
+        if (furthest == first) continue;
+        keep[furthest] = 1;
+        ranges[pending].first = first;
+        ranges[pending++].last = furthest;
+        ranges[pending].first = furthest;
+        ranges[pending++].last = last;
+    }
+}
diff --git a/src/kernel/polyline.h b/src/kernel/polyline.h
new file mode 100644
index 00000000..b66e3384
--- /dev/null
+++ b/src/kernel/polyline.h
@@ -0,0 +1,16 @@
+/* Simplification of a 2D polyline by Ramer-Douglas-Peucker: the samples that
+ * keep the shape within a tolerance of the original line.
+ *
+ * points is interleaved x, y pairs. keep receives one flag per sample, and
+ * ranges is scratch that must hold count entries. Once the work spent on
+ * distance tests passes work_limit, every sample is kept, so a pathological
+ * zigzag costs bounded CPU and still draws the original path. */
+#ifndef POLYLINE_H
+#define POLYLINE_H
+
+typedef struct { unsigned first, last; } PolylineRange;
+
+void polyline_simplify_2d(const float *points, unsigned count, float tolerance,
+                          unsigned work_limit, unsigned char *keep, PolylineRange *ranges);
+
+#endif
diff --git a/src/kernel/recomp_env.h b/src/kernel/recomp_env.h
new file mode 100644
index 00000000..c30086ad
--- /dev/null
+++ b/src/kernel/recomp_env.h
@@ -0,0 +1,18 @@
+/* Cached environment switch for diagnostics.
+ *
+ * getenv takes the CRT's environment lock and scans the block, which is far too
+ * slow on hot paths such as an allocator hook. A switch is read once, when
+ * first asked for, and the answer is kept in the caller's slot: -1 until read,
+ * then 0 or 1. The environment is fixed before the guest starts. */
+#ifndef RECOMP_ENV_H
+#define RECOMP_ENV_H
+
+#include <stdlib.h>
+
+static inline int recomp_env_flag(int *slot, const char *name)
+{
+    if (*slot < 0) *slot = getenv(name) != NULL;
+    return *slot;
+}
+
+#endif
diff --git a/src/kernel/recomp_log_budget.h b/src/kernel/recomp_log_budget.h
new file mode 100644
index 00000000..8f98c41e
--- /dev/null
+++ b/src/kernel/recomp_log_budget.h
@@ -0,0 +1,43 @@
+/* Per-second line budget for diagnostic logs.
+ *
+ * Each one-second window admits `limit` lines. Lines past that are counted as
+ * suppressed, and the count of the window that just ended is reported through
+ * RecompLogRoll so the caller can say how much was dropped. The budget is
+ * per caller: keep one RecompLogBudget per log stream and per guest thread
+ * when the stream is thread-local. */
+#ifndef RECOMP_LOG_BUDGET_H
+#define RECOMP_LOG_BUDGET_H
+
+#include <stdint.h>
+
+typedef struct {
+    uint64_t second;     /* the window's start, in whole seconds */
+    unsigned lines;      /* lines admitted in this window */
+    unsigned suppressed; /* lines refused in this window */
+} RecompLogBudget;
+
+typedef struct {
+    uint64_t second;     /* the window that ended */
+    unsigned suppressed; /* lines refused in it; zero when nothing was dropped */
+} RecompLogRoll;
+
+/* Returns 1 when a line may be written at now_ms. */
+static inline int recomp_log_budget_take(RecompLogBudget *budget, uint64_t now_ms,
+                                         unsigned limit, RecompLogRoll *rolled)
+{
+    uint64_t second = now_ms / 1000;
+    if (rolled) { rolled->second = budget->second; rolled->suppressed = 0; }
+    if (second != budget->second) {
+        if (rolled) rolled->suppressed = budget->suppressed;
+        budget->second = second;
+        budget->lines = budget->suppressed = 0;
+    }
+    if (budget->lines >= limit) {
+        ++budget->suppressed;
+        return 0;
+    }
+    ++budget->lines;
+    return 1;
+}
+
+#endif
diff --git a/src/kernel/recomp_lookup_cache.c b/src/kernel/recomp_lookup_cache.c
new file mode 100644
index 00000000..ab0d9e6d
--- /dev/null
+++ b/src/kernel/recomp_lookup_cache.c
@@ -0,0 +1,15 @@
+#include "recomp_lookup_cache.h"
+#include "xbox_memory_layout.h"
+
+#define RECOMP_LOOKUP_SLOTS 1024u
+
+RecompLookupTarget recomp_lookup_memoized(uint32_t guest_va, RecompLookupFn uncached)
+{
+    static RECOMP_TLS struct { uint32_t va; RecompLookupTarget fn; } cache[RECOMP_LOOKUP_SLOTS];
+    unsigned slot = (guest_va ^ (guest_va >> 10)) & (RECOMP_LOOKUP_SLOTS - 1u);
+    if (cache[slot].va != guest_va || !guest_va) {
+        cache[slot].fn = uncached(guest_va);
+        cache[slot].va = guest_va;
+    }
+    return cache[slot].fn;
+}
diff --git a/src/kernel/recomp_lookup_cache.h b/src/kernel/recomp_lookup_cache.h
new file mode 100644
index 00000000..4f50c27d
--- /dev/null
+++ b/src/kernel/recomp_lookup_cache.h
@@ -0,0 +1,16 @@
+/* Per-thread memo for a function lookup keyed by guest address.
+ *
+ * Indirect calls ask a lookup chain on every call, and the answers do not
+ * change once made. recomp_lookup_memoized remembers each thread's answers in a
+ * direct-mapped table and asks the uncached lookup only on a miss. */
+#ifndef RECOMP_LOOKUP_CACHE_H
+#define RECOMP_LOOKUP_CACHE_H
+
+#include <stdint.h>
+
+typedef void (*RecompLookupTarget)(void);
+typedef RecompLookupTarget (*RecompLookupFn)(uint32_t guest_va);
+
+RecompLookupTarget recomp_lookup_memoized(uint32_t guest_va, RecompLookupFn uncached);
+
+#endif
diff --git a/src/kernel/road_graph.c b/src/kernel/road_graph.c
new file mode 100644
index 00000000..ebd0f4a8
--- /dev/null
+++ b/src/kernel/road_graph.c
@@ -0,0 +1,180 @@
+#include "road_graph.h"
+#include <float.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+float graph_distance(GraphPoint a, GraphPoint b)
+{
+    float x = a.x - b.x, y = a.y - b.y, z = a.z - b.z;
+    return sqrtf(x*x + y*y + z*z);
+}
+
+int graph_point_valid(GraphPoint p)
+{
+    return isfinite(p.x) && isfinite(p.y) && isfinite(p.z) &&
+        fabsf(p.x) < 100000.0f && fabsf(p.y) < 100000.0f && fabsf(p.z) < 100000.0f;
+}
+
+void road_graph_free(RoadGraph *g)
+{
+    if (!g) return;
+    free(g->nodes); free(g->edges); free(g->distance);
+    free(g->previous); free(g->heap); free(g->heap_position);
+    free(g);
+}
+
+RoadGraph *road_graph_new(unsigned nodes, unsigned max_edges)
+{
+    RoadGraph *g;
+    unsigned i;
+    if (!nodes || !max_edges) return NULL;
+    g = (RoadGraph *)calloc(1, sizeof *g);
+    if (!g) return NULL;
+    g->nodes = (GraphNode *)calloc(nodes, sizeof(GraphNode));
+    g->edges = (GraphEdge *)malloc(max_edges * sizeof(GraphEdge));
+    g->distance = (float *)malloc(nodes * sizeof(float));
+    g->previous = (uint32_t *)malloc(nodes * sizeof(uint32_t));
+    g->heap = (uint32_t *)malloc(nodes * sizeof(uint32_t));
+    g->heap_position = (uint32_t *)malloc(nodes * sizeof(uint32_t));
+    if (!g->nodes || !g->edges || !g->distance || !g->previous || !g->heap || !g->heap_position) {
+        road_graph_free(g);
+        return NULL;
+    }
+    g->node_count = nodes;
+    g->max_edges = max_edges;
+    for (i = 0; i < nodes; ++i) g->nodes[i].first = ROAD_GRAPH_NO_NODE;
+    return g;
+}
+
+int road_graph_connect(RoadGraph *g, unsigned a, unsigned b)
+{
+    float length;
+    unsigned index;
+    if (a >= g->node_count || b >= g->node_count || a == b) return 0;
+    length = graph_distance(g->nodes[a].position, g->nodes[b].position);
+    if (!isfinite(length)) return 0;
+    /* Zero-length joins are real when two sections share an endpoint. */
+    if (length < .001f) length = .001f;
+    if (g->edge_count + 2 > g->max_edges) return 0;
+    index = g->edge_count;
+    g->edges[index].to = b; g->edges[index].length = length;
+    g->edges[index].next = g->nodes[a].first;
+    g->nodes[a].first = index;
+    g->edges[index + 1].to = a; g->edges[index + 1].length = length;
+    g->edges[index + 1].next = g->nodes[b].first;
+    g->nodes[b].first = index + 1;
+    g->edge_count += 2;
+    return 1;
+}
+
+static void heap_update(RoadGraph *g, unsigned node)
+{
+    unsigned position = g->heap_position[node];
+    if (position == ROAD_GRAPH_NO_NODE) position = g->heap_count++;
+    while (position) {
+        unsigned parent = (position - 1) / 2, other = g->heap[parent];
+        if (g->distance[other] <= g->distance[node]) break;
+        g->heap[position] = other; g->heap_position[other] = position;
+        position = parent;
+    }
+    g->heap[position] = node; g->heap_position[node] = position;
+}
+
+static unsigned heap_pop(RoadGraph *g)
+{
+    unsigned result = g->heap[0], node = g->heap[--g->heap_count];
+    unsigned position = 0;
+    if (g->heap_count) {
+        while (position * 2 + 1 < g->heap_count) {
+            unsigned child = position * 2 + 1;
+            if (child + 1 < g->heap_count && g->distance[g->heap[child + 1]] < g->distance[g->heap[child]])
+                ++child;
+            if (g->distance[node] <= g->distance[g->heap[child]]) break;
+            g->heap[position] = g->heap[child];
+            g->heap_position[g->heap[position]] = position;
+            position = child;
+        }
+        g->heap[position] = node; g->heap_position[node] = position;
+    }
+    g->heap_position[result] = ROAD_GRAPH_NO_NODE;
+    return result;
+}
+
+int road_graph_snap(const RoadGraph *g, GraphPoint position, float height_weight, float max_score,
+                    GraphSnap *snap)
+{
+    unsigned a, edge;
+    float best = FLT_MAX;
+    if (!graph_point_valid(position)) return 0;
+    for (a = 0; a < g->node_count; ++a)
+        for (edge = g->nodes[a].first; edge != ROAD_GRAPH_NO_NODE; edge = g->edges[edge].next) {
+            unsigned b = g->edges[edge].to;
+            GraphPoint p = g->nodes[a].position, q = g->nodes[b].position, projected;
+            float x, y, z, length2, t, score;
+            if (b <= a) continue;
+            x = q.x - p.x; y = q.y - p.y; z = q.z - p.z;
+            length2 = x*x + y*y + z*z;
+            if (length2 < .0001f) continue;
+            t = ((position.x - p.x)*x + (position.y - p.y)*y + (position.z - p.z)*z) / length2;
+            t = t < 0 ? 0 : (t > 1 ? 1 : t);
+            projected.x = p.x + t*x; projected.y = p.y + t*y; projected.z = p.z + t*z;
+            x = position.x - projected.x; y = position.y - projected.y; z = position.z - projected.z;
+            score = x*x + height_weight*y*y + z*z;
+            if (score < best) {
+                best = score; snap->position = projected; snap->a = a; snap->b = b;
+                snap->t = t; snap->length = sqrtf(length2);
+            }
+        }
+    return best < max_score;
+}
+
+unsigned road_graph_path(RoadGraph *g, const GraphSnap *from, const GraphSnap *to,
+                         GraphPoint *points, unsigned capacity)
+{
+    unsigned i, last = ROAD_GRAPH_NO_NODE, count = 0;
+    float best = FLT_MAX;
+    if (capacity < 2 || !g->edge_count) return 0;
+    if (from->a == to->a && from->b == to->b) {
+        points[0] = from->position; points[1] = to->position;
+        return graph_distance(points[0], points[1]) > .01f ? 2 : 0;
+    }
+    g->heap_count = 0;
+    for (i = 0; i < g->node_count; ++i) {
+        g->distance[i] = FLT_MAX; g->previous[i] = ROAD_GRAPH_NO_NODE;
+        g->heap_position[i] = ROAD_GRAPH_NO_NODE;
+    }
+    g->distance[from->a] = from->t * from->length;
+    g->distance[from->b] = (1 - from->t) * from->length;
+    heap_update(g, from->a); heap_update(g, from->b);
+    while (g->heap_count) {
+        unsigned node = heap_pop(g), edge;
+        float distance = g->distance[node], extra;
+        if (distance >= best) break;
+        if (node == to->a || node == to->b) {
+            extra = node == to->a ? to->t * to->length : (1 - to->t) * to->length;
+            if (distance + extra < best) { best = distance + extra; last = node; }
+        }
+        for (edge = g->nodes[node].first; edge != ROAD_GRAPH_NO_NODE; edge = g->edges[edge].next) {
+            unsigned next = g->edges[edge].to;
+            float candidate = distance + g->edges[edge].length;
+            if (candidate < g->distance[next]) {
+                g->distance[next] = candidate; g->previous[next] = node;
+                heap_update(g, next);
+            }
+        }
+    }
+    if (last == ROAD_GRAPH_NO_NODE) return 0;
+    for (i = last; i != ROAD_GRAPH_NO_NODE; i = g->previous[i]) {
+        if (count + 2 >= capacity) return 0;
+        points[count++] = g->nodes[i].position;
+    }
+    for (i = 0; i < count / 2; ++i) {
+        GraphPoint swap = points[i]; points[i] = points[count - 1 - i]; points[count - 1 - i] = swap;
+    }
+    memmove(points + 1, points, count * sizeof *points);
+    points[0] = from->position; points[count + 1] = to->position;
+    for (i = 1, last = 1; i < count + 2; ++i)
+        if (graph_distance(points[last - 1], points[i]) > .01f) points[last++] = points[i];
+    return last >= 2 ? last : 0;
+}
diff --git a/src/kernel/road_graph.h b/src/kernel/road_graph.h
new file mode 100644
index 00000000..affe1b02
--- /dev/null
+++ b/src/kernel/road_graph.h
@@ -0,0 +1,57 @@
+/* A graph of 3D points joined by edges, with snapping and shortest paths.
+ *
+ * Nodes carry a position and a list of edges; an edge's length is the distance
+ * between its ends (never less than 0.001, so shared endpoints still join).
+ * A point snaps to the nearest edge, by its distance to the edge with height
+ * counted at height_weight, and a path runs between two snapped points along
+ * the graph (Dijkstra with an indexed heap). Nothing here knows a title's data. */
+#ifndef ROAD_GRAPH_H
+#define ROAD_GRAPH_H
+
+#include <stdint.h>
+
+typedef struct { float x, y, z; } GraphPoint;
+
+typedef struct { GraphPoint position; uint32_t first; } GraphNode;
+typedef struct { uint32_t to, next; float length; } GraphEdge;
+
+typedef struct {
+    GraphPoint position;   /* the projection on the edge */
+    uint32_t a, b;         /* the edge's end nodes */
+    float t, length;       /* the projection's place along the edge, and its length */
+} GraphSnap;
+
+typedef struct RoadGraph {
+    GraphNode *nodes;
+    GraphEdge *edges;
+    float *distance;
+    uint32_t *previous, *heap, *heap_position;
+    unsigned node_count, edge_count, heap_count, max_edges;
+} RoadGraph;
+
+#define ROAD_GRAPH_NO_NODE UINT32_MAX
+
+float graph_distance(GraphPoint a, GraphPoint b);
+int graph_point_valid(GraphPoint p);
+
+/* Allocates a graph of nodes nodes, with room for max_edges directed edges.
+ * Returns NULL when the request is empty or allocation fails. */
+RoadGraph *road_graph_new(unsigned nodes, unsigned max_edges);
+void road_graph_free(RoadGraph *graph);
+
+/* Joins a and b both ways. Returns 0 for out-of-range or equal nodes, a
+ * non-finite length, or no room. */
+int road_graph_connect(RoadGraph *graph, unsigned a, unsigned b);
+
+/* Snaps p to the nearest edge. The score is dx^2 + height_weight*dy^2 + dz^2;
+ * returns 0 when p is invalid or the best score is not below max_score. */
+int road_graph_snap(const RoadGraph *graph, GraphPoint p, float height_weight, float max_score,
+                    GraphSnap *snap);
+
+/* The points of the shortest path from one snap to the other, including both
+ * snapped ends with duplicated endpoints removed. Returns 0 when there is no
+ * route or the path does not fit in capacity. */
+unsigned road_graph_path(RoadGraph *graph, const GraphSnap *from, const GraphSnap *to,
+                         GraphPoint *points, unsigned capacity);
+
+#endif
diff --git a/src/kernel/slot_publish.c b/src/kernel/slot_publish.c
new file mode 100644
index 00000000..226bd0c5
--- /dev/null
+++ b/src/kernel/slot_publish.c
@@ -0,0 +1,39 @@
+#include "slot_publish.h"
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+static uint32_t atomic_add32(volatile uint32_t *p, uint32_t v)
+{
+    return (uint32_t)_InterlockedExchangeAdd((volatile long *)p, (long)v);
+}
+static uint32_t atomic_cas32(volatile uint32_t *p, uint32_t cmp, uint32_t val)
+{
+    return (uint32_t)_InterlockedCompareExchange((volatile long *)p, (long)val, (long)cmp);
+}
+#else
+static uint32_t atomic_add32(volatile uint32_t *p, uint32_t v)
+{
+    return __sync_fetch_and_add(p, v);
+}
+static uint32_t atomic_cas32(volatile uint32_t *p, uint32_t cmp, uint32_t val)
+{
+    return __sync_val_compare_and_swap(p, cmp, val);
+}
+#endif
+
+void xbox_slot_publish(volatile uint32_t *sequence, volatile uint32_t *words, unsigned count,
+                       const uint32_t *values, volatile uint32_t *owner, uint32_t owner_value)
+{
+    unsigned i;
+    atomic_add32(sequence, 1); /* odd: unpublished */
+    for (i = 0; i < count; ++i)
+        atomic_cas32(&words[i], xbox_slot_read(&words[i]), values ? values[i] : 0);
+    if (owner)
+        *owner = owner_value;
+    atomic_add32(sequence, 1); /* even: complete */
+}
+
+uint32_t xbox_slot_read(volatile uint32_t *word)
+{
+    return atomic_add32(word, 0);
+}
diff --git a/src/kernel/slot_publish.h b/src/kernel/slot_publish.h
new file mode 100644
index 00000000..83f58a47
--- /dev/null
+++ b/src/kernel/slot_publish.h
@@ -0,0 +1,20 @@
+/* Lock-free publication of a slot's words to another thread.
+ *
+ * A writer makes a slot's sequence odd, writes its words with compare-and-swap,
+ * sets the slot's owner, and makes the sequence even again. A reader takes the
+ * sequence, reads a word, and trusts the result only when the sequence is even
+ * and unchanged afterwards. Nothing waits and nothing can tear a result. */
+#ifndef SLOT_PUBLISH_H
+#define SLOT_PUBLISH_H
+
+#include <stdint.h>
+
+/* Publishes count words (values, or zeros when values is NULL) and then sets
+ * *owner to owner_value, between two sequence increments. owner may be NULL. */
+void xbox_slot_publish(volatile uint32_t *sequence, volatile uint32_t *words, unsigned count,
+                       const uint32_t *values, volatile uint32_t *owner, uint32_t owner_value);
+
+/* Reads a word atomically, with sequential consistency. */
+uint32_t xbox_slot_read(volatile uint32_t *word);
+
+#endif
