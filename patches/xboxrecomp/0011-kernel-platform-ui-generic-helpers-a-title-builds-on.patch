diff --git a/src/kernel/fixed_step.c b/src/kernel/fixed_step.c
new file mode 100644
index 00000000..8acfc19c
--- /dev/null
+++ b/src/kernel/fixed_step.c
@@ -0,0 +1,19 @@
+#include "fixed_step.h"
+#include <math.h>
+
+int fixed_step_take(FixedStepClock *clock, float dt, float step, int max_steps, float *alpha)
+{
+    int n;
+    if (!(dt > 0.0f) || dt > 1.0f)
+        dt = step;
+    clock->clock += dt;
+    n = (int)(clock->clock / step);
+    if (n > max_steps) {
+        n = max_steps;
+        clock->clock = (float)max_steps * step;
+    }
+    clock->clock -= (float)n * step;
+    if (alpha)
+        *alpha = clock->clock / step;
+    return n;
+}
diff --git a/src/kernel/fixed_step.h b/src/kernel/fixed_step.h
new file mode 100644
index 00000000..59917a93
--- /dev/null
+++ b/src/kernel/fixed_step.h
@@ -0,0 +1,18 @@
+/* Fixed-step accumulator: turns a variable frame time into whole steps.
+ *
+ * Each frame's time is added to a clock; whole steps are taken from it and the
+ * remainder carries to the next frame. A frame that would take more than
+ * max_steps is cut to max_steps, and the rest of the time is dropped, as a
+ * hitch. alpha is how far the clock is into the next step, 0..1. */
+#ifndef FIXED_STEP_H
+#define FIXED_STEP_H
+
+typedef struct {
+    float clock;
+} FixedStepClock;
+
+/* Returns the whole steps for this frame. dt values that are not positive,
+ * or longer than one second, count as one step (a load or a reset timer). */
+int fixed_step_take(FixedStepClock *clock, float dt, float step, int max_steps, float *alpha);
+
+#endif
diff --git a/src/kernel/guest_call.c b/src/kernel/guest_call.c
new file mode 100644
index 00000000..ce8ba920
--- /dev/null
+++ b/src/kernel/guest_call.c
@@ -0,0 +1,36 @@
+#include "guest_call.h"
+#include "guest_state.h"
+#include "xbox_memory_layout.h"
+
+extern RECOMP_TLS uint32_t g_eax, g_ecx, g_edx, g_esp, g_ebx, g_esi, g_edi, g_ebp;
+
+static uint32_t guest32(uint32_t va)
+{
+    return *(volatile uint32_t *)((uintptr_t)va + (uintptr_t)xbox_GetMemoryOffset());
+}
+
+static void guest32_store(uint32_t va, uint32_t value)
+{
+    *(volatile uint32_t *)((uintptr_t)va + (uintptr_t)xbox_GetMemoryOffset()) = value;
+}
+
+void xbox_guest_call_repeated(void (*fn)(void), int n, int nargs, uint32_t ret_pop)
+{
+    uint32_t esp0 = g_esp, saved[8], eax = g_eax, ecx = g_ecx, edx = g_edx;
+    uint32_t ebx = g_ebx, esi = g_esi, edi = g_edi, ebp = g_ebp;
+    int i, a;
+    for (a = 0; a <= nargs && a < 8; a++)
+        saved[a] = guest32(esp0 + 4u * a);
+    for (i = 0; i < n; i++) {
+        g_esp = esp0;
+        for (a = 0; a <= nargs && a < 8; a++)
+            guest32_store(esp0 + 4u * a, saved[a]);
+        g_eax = eax; g_ecx = ecx; g_edx = edx;
+        g_ebx = ebx; g_esi = esi; g_edi = edi; g_ebp = ebp;
+        fn();
+    }
+    if (n == 0) {
+        g_eax = eax; g_ebx = ebx; g_esi = esi; g_edi = edi; g_ebp = ebp;
+    }
+    g_esp = esp0 + ret_pop;
+}
diff --git a/src/kernel/guest_call.h b/src/kernel/guest_call.h
new file mode 100644
index 00000000..55bb95c8
--- /dev/null
+++ b/src/kernel/guest_call.h
@@ -0,0 +1,14 @@
+/* Calls a guest function several times as one call would.
+ *
+ * The guest stack's return address and nargs arguments are put back before
+ * each call, and the registers the caller keeps (eax, ecx, edx, ebx, esi, edi,
+ * ebp) are restored, so each repetition sees what the first did. ret_pop is
+ * the number of bytes the callee pops, which the caller's ESP then advances by. */
+#ifndef GUEST_CALL_H
+#define GUEST_CALL_H
+
+#include <stdint.h>
+
+void xbox_guest_call_repeated(void (*fn)(void), int n, int nargs, uint32_t ret_pop);
+
+#endif
