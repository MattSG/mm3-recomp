diff --git a/src/nv2a/nv2a_pb_reserve.c b/src/nv2a/nv2a_pb_reserve.c
new file mode 100644
index 00000000..bdbc4548
--- /dev/null
+++ b/src/nv2a/nv2a_pb_reserve.c
@@ -0,0 +1,32 @@
+#include "nv2a_pb_reserve.h"
+#include "xbox_memory_layout.h"
+
+static uint32_t pb_guest32(uint32_t va)
+{
+    return *(volatile uint32_t *)((uintptr_t)va + (uintptr_t)xbox_GetMemoryOffset());
+}
+
+static void pb_guest32_store(uint32_t va, uint32_t value)
+{
+    *(volatile uint32_t *)((uintptr_t)va + (uintptr_t)xbox_GetMemoryOffset()) = value;
+}
+
+static int pb_room(uint32_t cursor, uint32_t limit, uint32_t bytes)
+{
+    return cursor && !(cursor & 3u) && limit >= cursor && limit - cursor >= bytes;
+}
+
+uint32_t xbox_pb_reserve(uint32_t device, uint32_t bytes, Nv2aPbRolloverFn rollover, void *user)
+{
+    uint32_t cursor = pb_guest32(device), limit = pb_guest32(device + 4u);
+    /* The native cursor may already be beyond its soft limit. Roll over
+     * through the title's normal path rather than dropping the record. */
+    if (cursor && !(cursor & 3u) && (limit < cursor || limit - cursor < bytes)) {
+        rollover(user);
+        cursor = pb_guest32(device);
+        limit = pb_guest32(device + 4u);
+    }
+    if (!pb_room(cursor, limit, bytes)) return 0;
+    pb_guest32_store(device, cursor + bytes);
+    return cursor;
+}
diff --git a/src/nv2a/nv2a_pb_reserve.h b/src/nv2a/nv2a_pb_reserve.h
new file mode 100644
index 00000000..8a284818
--- /dev/null
+++ b/src/nv2a/nv2a_pb_reserve.h
@@ -0,0 +1,20 @@
+/* Reserve space in a guest NV2A push buffer.
+ *
+ * The device object holds the write cursor at +0 and the soft limit at +4,
+ * both guest addresses. A reservation needs an aligned cursor and room for
+ * the whole record. When the room is short, the title's own rollover runs
+ * first (it is the title's native code that moves the cursor to a fresh
+ * segment), then the check is repeated. */
+#ifndef NV2A_PB_RESERVE_H
+#define NV2A_PB_RESERVE_H
+
+#include <stdint.h>
+
+/* Runs the title's rollover; it must leave the device cursor and limit updated. */
+typedef void (*Nv2aPbRolloverFn)(void *user);
+
+/* Returns the guest address of the reserved bytes and advances the cursor past
+ * them, or returns 0 when no room exists even after rollover. */
+uint32_t xbox_pb_reserve(uint32_t device, uint32_t bytes, Nv2aPbRolloverFn rollover, void *user);
+
+#endif
