+++ b/tests/nv2a_samplers/test_samplers_sdlgpu.c
@@ -0,0 +1,383 @@
+/* The SDL3 GPU renderer's sampler requests, the counterpart of test_samplers.c.
+ * SDL samplers are opaque, so each created descriptor is captured at creation and
+ * compared with an independent reference. The sampler each draw binds is read
+ * back from the batch the renderer records, and the GPU pixels come from real
+ * draws of the renderer. The border colour has no SDL field (addressing
+ * border is done in the shader), so it is not part of the descriptor. */
+#include <SDL3/SDL.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Creation is wrapped before the renderer is included. The real function is
+ * taken first, so the wrapper calls it, not itself. */
+static SDL_GPUSampler *(*const real_create_sampler)(SDL_GPUDevice *, const SDL_GPUSamplerCreateInfo *) = SDL_CreateGPUSampler;
+static void (*const real_bind_fragment_samplers)(SDL_GPURenderPass *, Uint32, const SDL_GPUTextureSamplerBinding *, Uint32) = SDL_BindGPUFragmentSamplers;
+static SDL_GPUSampler *test_create_sampler(SDL_GPUDevice *dev, const SDL_GPUSamplerCreateInfo *info);
+static void test_bind_fragment_samplers(SDL_GPURenderPass *rp, Uint32 first,
+                                        const SDL_GPUTextureSamplerBinding *b, Uint32 n);
+#define SDL_CreateGPUSampler test_create_sampler
+#define SDL_BindGPUFragmentSamplers test_bind_fragment_samplers
+
+static unsigned create_calls;
+static int fail_sampler;
+#define CREATED_LOG 8192
+static struct { SDL_GPUSampler *smp; SDL_GPUSamplerCreateInfo info; } created[CREATED_LOG];
+static unsigned created_n;
+static SDL_GPUTextureSamplerBinding bound[9];
+static unsigned bind_calls;
+
+static SDL_GPUSampler *test_create_sampler(SDL_GPUDevice *dev, const SDL_GPUSamplerCreateInfo *info)
+{
+    SDL_GPUSampler *s;
+    create_calls++;
+    if (fail_sampler) { fail_sampler--; return NULL; }
+    s = real_create_sampler(dev, info);
+    if (s) {
+        created[created_n % CREATED_LOG].smp = s;
+        created[created_n % CREATED_LOG].info = *info;
+        created_n++;
+    }
+    return s;
+}
+
+static void test_bind_fragment_samplers(SDL_GPURenderPass *rp, Uint32 first,
+                                        const SDL_GPUTextureSamplerBinding *b, Uint32 n)
+{
+    if (first == 0 && n == 9) {
+        memcpy(bound, b, sizeof bound);
+        bind_calls++;
+    }
+    real_bind_fragment_samplers(rp, first, b, n);
+}
+
+#include "../../src/video/nv2a_sdlgpu.c"
+#include "../nv2a_test_host.h"
+#include "../nv2a_sdlgpu_host.h"
+
+static uint8_t ram[0x100000];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+void xbox_FramebufferRenderHostOverlay(void *device, void *context, void *target) { (void)device; (void)context; (void)target; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4] { return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { return NULL; }
+
+/* The descriptor the D3D11 renderer's rules give a request, written again
+ * here from the NV2A register semantics rather than read from the renderer. */
+static SDL_GPUSamplerAddressMode reference_address(uint32_t m)
+{
+    if (m == 1) return SDL_GPU_SAMPLERADDRESSMODE_REPEAT;
+    if (m == 2) return SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT;
+    return SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+}
+
+static void reference_descriptor(const NvD3DTexture *t, int levels, int reduce,
+                                 SDL_GPUSamplerCreateInfo *e)
+{
+    uint32_t minf = (t->filter >> 16) & 0xFF, magf = (t->filter >> 24) & 0xF;
+    int bias = (int)(t->filter & 0x1FFF), min_lin, mip_lin, mag_lin;
+    if (bias & 0x1000) bias -= 0x2000;
+    min_lin = minf == 2 || minf == 4 || minf == 6;
+    mip_lin = minf == 5 || minf == 6;
+    mag_lin = magf != 1;
+    memset(e, 0, sizeof *e);
+    e->min_filter = min_lin ? SDL_GPU_FILTER_LINEAR : SDL_GPU_FILTER_NEAREST;
+    e->mag_filter = mag_lin ? SDL_GPU_FILTER_LINEAR : SDL_GPU_FILTER_NEAREST;
+    e->mipmap_mode = mip_lin ? SDL_GPU_SAMPLERMIPMAPMODE_LINEAR : SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+    e->address_mode_u = reference_address(t->address & 0xF);
+    e->address_mode_v = reference_address((t->address >> 8) & 0xF);
+    e->address_mode_w = reference_address((t->address >> 16) & 0xF);
+    e->enable_anisotropy = min_lin && mag_lin && s_aniso > 1;
+    e->max_anisotropy = (float)s_aniso;
+    e->mip_lod_bias = (float)bias / 256.0f;
+    if (minf <= 2 || minf == 7 || levels <= 1) {
+        e->min_lod = e->max_lod = 0;
+    } else {
+        e->min_lod = (float)((t->control0 >> 18) & 0xFFF) / 256.0f;
+        e->max_lod = (float)((t->control0 >> 6) & 0xFFF) / 256.0f;
+        if (e->max_lod < e->min_lod) e->max_lod = 1000.0f;
+    }
+    if (reduce) {
+        e->mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_LINEAR;
+        e->min_lod = 0;
+        e->max_lod = 1000.0f;
+    }
+}
+
+static int same_descriptor(const SDL_GPUSamplerCreateInfo *a, const SDL_GPUSamplerCreateInfo *b)
+{
+    return a->min_filter == b->min_filter && a->mag_filter == b->mag_filter &&
+           a->mipmap_mode == b->mipmap_mode &&
+           a->address_mode_u == b->address_mode_u && a->address_mode_v == b->address_mode_v &&
+           a->address_mode_w == b->address_mode_w &&
+           a->enable_anisotropy == b->enable_anisotropy &&
+           a->max_anisotropy == b->max_anisotropy && a->mip_lod_bias == b->mip_lod_bias &&
+           a->min_lod == b->min_lod && a->max_lod == b->max_lod;
+}
+
+/* The descriptor captured when this sampler was created. */
+static const SDL_GPUSamplerCreateInfo *created_info(SDL_GPUSampler *s)
+{
+    unsigned i, n = created_n < CREATED_LOG ? created_n : CREATED_LOG;
+    for (i = n; i-- > 0;)
+        if (created[i % CREATED_LOG].smp == s) return &created[i % CREATED_LOG].info;
+    return NULL;
+}
+
+static void expect_sampler(SDL_GPUSampler *s, const NvD3DTexture *t, int levels, int reduce)
+{
+    SDL_GPUSamplerCreateInfo want;
+    const SDL_GPUSamplerCreateInfo *got;
+    CHECK(s);
+    got = created_info(s);
+    CHECK(got);
+    reference_descriptor(t, levels, reduce, &want);
+    if (!same_descriptor(got, &want))
+        fprintf(stderr, "descriptor mismatch: filters %d/%d/%d addr %d/%d/%d aniso %d/%g bias %g lod %g..%g\n",
+                got->min_filter, got->mag_filter, got->mipmap_mode, got->address_mode_u,
+                got->address_mode_v, got->address_mode_w, got->enable_anisotropy,
+                got->max_anisotropy, got->mip_lod_bias, got->min_lod, got->max_lod);
+    CHECK(same_descriptor(got, &want));
+}
+
+static NvD3DTexture request(unsigned i)
+{
+    NvD3DTexture t = {0};
+    static const unsigned modes[] = {1, 2, 3, 4};
+    t.filter = ((1 + i % 7) << 16) | ((1 + (i / 7) % 2) << 24) | ((i & 1) ? 0x1F80 : 0x80);
+    t.address = modes[i % 4] | (modes[(i / 4) % 4] << 8) | (modes[(i / 16) % 4] << 16);
+    t.control0 = (((i % 4) * 256) << 18) | ((((i / 4) % 4) * 256) << 6);
+    t.border = 0x80336699u + i * 0x01010203u;
+    return t;
+}
+
+/* A draw that samples texture 0 at (u, v) with the renderer's own pipeline,
+ * and the pixel it wrote at (20,20) of a 64x64 target. */
+static uint32_t draw_sample(const NvD3DTexture *t, float u, float v)
+{
+    NvD3DState st = {0};
+    NvD3DAttrib attr[16] = {0};
+    float positions[3][4] = { { 8, 8, 0, 1 }, { 56, 8, 0, 1 }, { 8, 56, 0, 1 } };
+    float def[16][4] = { { 0 } };
+    uint32_t idx[3] = { 0, 1, 2 }, pixels[64 * 64];
+    st.color_addr = 0x10000; st.color_pitch = 64 * 4;
+    st.surface_format = 0x25; st.clip_w = st.clip_h = 64;
+    st.color_mask = 0x01010101;
+    st.tex_used = 1; st.tex[0] = *t;
+    def[3][0] = def[3][1] = def[3][2] = def[3][3] = 1;
+    def[9][0] = u; def[9][1] = v; def[9][3] = 1;
+    attr[0] = (NvD3DAttrib){ 1, 2, 4, 16, (const uint8_t *)positions };
+    nv2a_d3d_clear(&st, 0xF0, 0xFF000000, 0, 0, 0, 63, 63);
+    nv2a_d3d_draw_ub(&st, NV_D3D_TRIANGLES, attr, def, 0, idx, 3, 0, 2, NULL);
+    gpu_download(surface_find(0x10000)->tex, 64, 64, pixels);
+    return pixels[20 * 64 + 20];
+}
+
+static void expect_pixel(uint32_t got, uint32_t want)
+{
+    if (got != want) fprintf(stderr, "pixel %08X, expected %08X\n", got, want);
+    CHECK(got == want);
+}
+
+/* A 8x8 linear A8R8G8B8 guest texture whose texels encode their coordinates. */
+static void make_guest_texture(void)
+{
+    uint32_t *p = (uint32_t *)(ram + 0x20000), x, y;
+    for (y = 0; y < 8; y++)
+        for (x = 0; x < 8; x++)
+            p[y * 8 + x] = 0xFF000000u | (x * 32) << 16 | (y * 32) << 8 | 0x10;
+}
+static uint32_t texel_at(unsigned x, unsigned y)
+{
+    return 0xFF000000u | (x * 32) << 16 | (y * 32) << 8 | 0x10;
+}
+static NvD3DTexture guest_texture(uint32_t filter, uint32_t address)
+{
+    NvD3DTexture t = {0};
+    t.addr = 0x20000; t.color = 0x12; t.format = 0x1200;
+    t.width = t.height = 8; t.pitch = 32; t.levels = 1;
+    t.filter = filter; t.address = address;
+    return t;
+}
+
+static void test_pixels(void)
+{
+    unsigned i, repeat, calls;
+    for (i = 0; i < 112; i++) {
+        NvD3DTexture t = request(i);
+        int levels = (int)(i % 5) + 1, reduce = (int)((i / 7) % 2);
+        SDL_GPUSampler *now = sampler(&t, levels, reduce, no_pinned_samplers);
+        expect_sampler(now, &t, levels, reduce);
+        calls = create_calls;
+        for (repeat = 0; repeat < 8; repeat++)
+            CHECK(sampler(&t, levels, reduce, no_pinned_samplers) == now);
+        CHECK(create_calls == calls);
+        /* Bits this descriptor does not read (filter bit 15, border colour)
+         * keep the same sampler: the key is the descriptor, not the raw words. */
+        t.filter ^= 0x8000;
+        CHECK(sampler(&t, levels, reduce, no_pinned_samplers) == now);
+        t.border ^= 0xFFFFFFu;
+        CHECK(sampler(&t, levels, reduce, no_pinned_samplers) == now);
+        CHECK(create_calls == calls);
+    }
+    /* Native GPU taps through the renderer's own draw: point sampling, and
+     * the address modes one texel past the 8-texel edge (wrap to texel 0,
+     * clamp to texel 7). */
+    make_guest_texture();
+    {
+        NvD3DTexture point = guest_texture((1u << 16) | (1u << 24), 0x010101);
+        NvD3DTexture clamp = guest_texture((1u << 16) | (1u << 24), 0x000000);
+        /* A linear texture takes its coordinates in texels (tex_scale = 1/width). */
+        expect_pixel(draw_sample(&point, 0.0625f, 0.0625f), texel_at(0, 0));
+        expect_pixel(draw_sample(&point, 4.5f, 2.5f), texel_at(4, 2));
+        expect_pixel(draw_sample(&point, 8.0625f, 0.0625f), texel_at(0, 0));
+        expect_pixel(draw_sample(&clamp, 8.0625f, 0.0625f), texel_at(7, 0));
+    }
+    printf("PASS: 112 descriptors checked against the reference, repeated lookups reuse the sampler, unread bits keep it, and SDL GPU pixels for point/wrap/clamp sampling\n");
+}
+
+static void test_eviction(void)
+{
+    NvD3DTexture t = request(2), other = request(4);
+    SDL_GPUSampler *old = sampler(&t, 4, 0, no_pinned_samplers), *now;
+    unsigned i, calls;
+    int evicted = 0;
+    expect_sampler(old, &t, 4, 0);
+    for (i = 0; i < 32768 && !evicted; i++) {
+        /* Control bits outside the LOD fields vary the key, not the result. */
+        other.control0 = (i << 6) & 0x3FFFFFC0u;
+        CHECK(sampler(&other, 4, 0, no_pinned_samplers));
+        evicted = 1;
+        for (unsigned j = 0; j < SAMP_SLOTS; j++)
+            if (s_samp[j].resource == old) { evicted = 0; break; }
+    }
+    CHECK(evicted && i > SAMP_SLOTS);
+    calls = create_calls;
+    now = sampler(&t, 4, 0, no_pinned_samplers);
+    CHECK(now && create_calls == calls + 1);
+    expect_sampler(now, &t, 4, 0);
+    CHECK(sampler(&t, 4, 0, no_pinned_samplers) == now && create_calls == calls + 1);
+    printf("PASS: sampler table evicted the oldest key after %u requests; the same request is recreated with the reference descriptor\n", i);
+}
+
+static void test_failure(void)
+{
+    NvD3DTexture t = request(81);
+    SDL_GPUSampler *now;
+    unsigned calls = create_calls;
+    fail_sampler = 1;
+    CHECK(!sampler(&t, 4, 1, no_pinned_samplers));
+    CHECK(create_calls == calls + 1 && !fail_sampler);
+    now = sampler(&t, 4, 1, no_pinned_samplers);
+    CHECK(now && create_calls == calls + 2);
+    expect_sampler(now, &t, 4, 1);
+    CHECK(sampler(&t, 4, 1, no_pinned_samplers) == now && create_calls == calls + 2);
+    printf("PASS: failed sampler creation publishes no cached hit; the same request retries and matches the reference\n");
+}
+
+/* The levels the renderer reports for a texture (tex_layout's count, through
+ * the cache), and what each draw binds in slot 0. */
+static int old_levels(const NvD3DTexture *t)
+{
+    TexLayout l;
+    return tex_layout(t, &l) ? l.levels : 1;
+}
+
+static void check_bound(const NvD3DTexture *t, int levels, int has_view, int tex_used)
+{
+    NvD3DState st = {0};
+    NvD3DAttrib attr[16] = {0};
+    float positions[3][4] = { { 8, 8, 0, 1 }, { 56, 8, 0, 1 }, { 8, 56, 0, 1 } };
+    float def[16][4] = { { 0 } };
+    uint32_t idx[3] = { 0, 1, 2 };
+    unsigned sampler_calls = bind_calls;
+    st.color_addr = 0x10000; st.color_pitch = 64 * 4;
+    st.surface_format = 0x25; st.clip_w = st.clip_h = 64;
+    st.color_mask = 0x01010101;
+    st.tex_used = (uint8_t)tex_used; st.tex[0] = *t;
+    def[3][3] = 1;
+    attr[0] = (NvD3DAttrib){ 1, 2, 4, 16, (const uint8_t *)positions };
+    nv2a_d3d_draw_ub(&st, NV_D3D_TRIANGLES, attr, def, 0, idx, 3, 0, 2, NULL);
+    flush_batch();
+    CHECK(bind_calls == sampler_calls + 1);
+    if (has_view) {
+        CHECK(bound[0].texture && bound[0].texture != s_dummy_2d);
+        CHECK(bound[0].sampler == sampler(t, levels, 0, no_pinned_samplers));
+    } else {
+        CHECK(bound[0].texture == s_dummy_2d);
+        CHECK(bound[0].sampler == s_linear_clamp);
+    }
+}
+
+static void test_levels(void)
+{
+    NvD3DTexture t = {0};
+    int levels = -7;
+    SDL_GPUTexture *view;
+    make_guest_texture();
+    t.addr = 0x20000; t.color = 0x06; t.format = 0x0600;
+    t.width = t.height = 8; t.levels = 4;
+    t.filter = (6u << 16) | (1u << 24); t.control0 = 3 * 256 << 6; t.address = 0x030303;
+    view = texture_get_with_levels(&t, &levels);
+    CHECK(view && levels == old_levels(&t) && levels == 4);
+    CHECK(texture_get_with_levels(&t, &levels) == view);        /* same-kick cache hit */
+    check_bound(&t, 4, 1, 1);
+    t.levels = 0;
+    CHECK(texture_get_with_levels(&t, &levels) && levels == old_levels(&t) && levels == 1);
+    t.levels = 15;
+    CHECK(texture_get_with_levels(&t, &levels) && levels == old_levels(&t) && levels == 4);
+    check_bound(&t, 4, 1, 1);
+    t.cube = 1; t.addr = 0x24000;
+    CHECK(texture_get_with_levels(&t, &levels) && levels == old_levels(&t));
+    t.cube = 0; t.addr = 0x20000;
+    t.width = 0;
+    CHECK(!texture_get_with_levels(&t, &levels) && levels == old_levels(&t));
+    check_bound(&t, 1, 0, 1);
+    t.width = 8;
+    t.color = 0xFF;
+    CHECK(!texture_get_with_levels(&t, &levels));
+    t.color = 0x06;
+    t.addr = 0x07FFFFF0;
+    CHECK(!texture_get_with_levels(&t, &levels));
+    t.addr = 0x20000;
+    /* Disabled stage, address zero and control0 = 0: the stage binds nothing. */
+    {
+        NvD3DTexture u = t;
+        check_bound(&u, 1, 0, 0);
+        u.addr = 0;
+        check_bound(&u, 1, 0, 1);
+        u.addr = t.addr; u.control0 = 0;
+        check_bound(&u, old_levels(&u), 1, 1);
+    }
+    /* A linear texture has one level, whatever the title asked for. */
+    t.color = 0x12; t.pitch = 32; t.levels = 15; t.format = 0x1200;
+    CHECK(texture_get_with_levels(&t, &levels) && levels == 1 && old_levels(&t) == 1);
+    check_bound(&t, 1, 1, 1);
+    printf("PASS: supplied levels match the layout on defaults, clamps, cube, bounds and colour, and the bound sampler/view per draw\n");
+}
+
+static void test_common(void)
+{
+    nv2a_common_checks();
+    printf("PASS: shared layout, texel and draw helpers (nv2a_render_common.h)\n");
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    test_setenv("RECOMP_RENDER_SCALE", "1");
+    test_setenv("RECOMP_ANISO", "16");
+    test_setenv("RECOMP_ASPECT", "4:3");
+    test_setenv("RECOMP_FPS_LIMIT", "0");
+    if (!strcmp(argv[1], "common")) { test_common(); return 0; }
+    CHECK(nv2a_d3d_init());
+    if (!strcmp(argv[1], "pixels")) test_pixels();
+    else if (!strcmp(argv[1], "eviction")) test_eviction();
+    else if (!strcmp(argv[1], "failure")) test_failure();
+    else if (!strcmp(argv[1], "levels")) test_levels();
+    else CHECK(0);
+    return 0;
+}
diff --git a/tests/nv2a_sdlgpu_host.h b/tests/nv2a_sdlgpu_host.h
new file mode 100644
index 00000000..3b0d2a67
--- /dev/null
+++ b/tests/nv2a_sdlgpu_host.h
@@ -0,0 +1,214 @@
+/* Harness for the SDL3 GPU renderer's white-box tests (nv2a_*_sdlgpu.c). Include
+ * after ../../src/video/nv2a_sdlgpu.c, so its static state and helpers are in
+ * scope. Provides:
+ *   - gpu_download: pixels of a GPU texture, through the renderer's own copy
+ *     pass and fence, after all recorded work has run;
+ *   - nv2a_common_checks(): the shared helpers of nv2a_render_common.h (the
+ *     same code the D3D11 renderer uses), run by every platform's SDL test. */
+#ifndef NV2A_SDLGPU_HOST_H
+#define NV2A_SDLGPU_HOST_H
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "platform/xbox_winnt.h"
+
+#ifndef CHECK
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+#endif
+
+static void test_setenv(const char *name, const char *value)
+{
+#ifdef _WIN32
+    _putenv_s(name, value);
+#else
+    setenv(name, value, 1);
+#endif
+}
+
+/* The window module's input and title state (fb_present.c and fb_window.h).
+ * fb_window_sdl.c is built into these tests; the renderer does not read these
+ * variables, so they stay at their zero values. */
+volatile unsigned char fbw_key_down[256];
+volatile float fbw_mouse_x, fbw_mouse_y;
+volatile LONG fbw_mouse_moves;
+volatile LONG fbw_inactive;
+void (*fbw_close_handler)(void);
+XboxCursor (*fbw_cursor_handler)(void);
+int (*fbw_mouse_press_handler)(float x, float y);
+XboxHostOverlay fbw_host_overlay;
+int fbw_title_due(uint16_t *out, size_t count) { (void)out; (void)count; return 0; }
+void fbw_initial_size(int work_w, int work_h, int *w, int *h)
+{
+    (void)work_w; (void)work_h;
+    *w = 640; *h = 480;
+}
+
+/* Most cases run headless: nv2a_d3d_init opens no window unless the
+ * RECOMP_FB_WINDOW variable asks for one. A case that needs a window (for a
+ * resize) opens it hidden first, and init then adopts that window. */
+static void open_hidden_window(void)
+{
+    test_setenv("RECOMP_FB_WINDOW", "1");
+    CHECK(fbw_sdl_open(SDL_WINDOW_HIDDEN));
+}
+
+/* Pixels of a GPU texture (BGRA, tightly packed rows), after every recorded
+ * draw and copy. Uses the renderer's batch and command buffer, so it must not
+ * run inside a render or copy pass of its own. */
+static void gpu_download(SDL_GPUTexture *t, uint32_t w, uint32_t h, uint32_t *out)
+{
+    SDL_GPUTransferBufferCreateInfo ci;
+    SDL_GPUTransferBuffer *tb;
+    SDL_GPUTextureRegion src;
+    SDL_GPUTextureTransferInfo dst;
+    SDL_GPUFence *fence = NULL;
+    const uint8_t *m;
+    memset(&ci, 0, sizeof ci);
+    ci.usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD;
+    ci.size = w * h * 4;
+    tb = SDL_CreateGPUTransferBuffer(s_dev, &ci);
+    CHECK(tb);
+    CHECK(copy_begin());
+    memset(&src, 0, sizeof src);
+    memset(&dst, 0, sizeof dst);
+    src.texture = t; src.w = w; src.h = h; src.d = 1;
+    dst.transfer_buffer = tb;
+    SDL_DownloadFromGPUTexture(s_copy, &src, &dst);
+    copy_end();
+    submit(&fence);
+    CHECK(fence);
+    CHECK(SDL_WaitForGPUFences(s_dev, true, &fence, 1));
+    SDL_ReleaseGPUFence(s_dev, fence);
+    m = (const uint8_t *)SDL_MapGPUTransferBuffer(s_dev, tb, false);
+    CHECK(m);
+    memcpy(out, m, (size_t)w * h * 4);
+    SDL_UnmapGPUTransferBuffer(s_dev, tb);
+    SDL_ReleaseGPUTransferBuffer(s_dev, tb);
+}
+
+/* A guest texture's layout, against hand-computed sizes. */
+static void check_shared_layouts(void)
+{
+    NvD3DTexture t;
+    TexLayout L;
+    int kind = -1;
+    memset(&t, 0, sizeof t);
+    /* 8x8 A8R8G8B8, four levels: 64+16+4+1 texels of 4 bytes. */
+    t.color = 0x06; t.width = t.height = 8; t.levels = 4;
+    CHECK(tex_layout(&t, &L));
+    CHECK(L.kind == K_SWZ && L.bpp == 4 && L.levels == 4 && L.faces == 1);
+    CHECK(L.level_off[1] == 256 && L.level_off[2] == 320 && L.level_off[3] == 336);
+    CHECK(L.total == 340 && L.face_stride == 340);
+    CHECK(host_levels(&L, &t) == 4); /* a title's short chain is completed to 1x1 */
+    /* Levels beyond the chain are clamped; a single level stays single. */
+    t.levels = 15;
+    CHECK(tex_layout(&t, &L) && L.levels == 4);
+    t.levels = 1;
+    CHECK(tex_layout(&t, &L) && L.levels == 1 && host_levels(&L, &t) == 1);
+    /* Cube faces start 128-byte aligned after the first face. */
+    t.cube = 1; t.levels = 4;
+    CHECK(tex_layout(&t, &L) && L.faces == 6 && L.face_stride == 384);
+    CHECK(L.total == 384 * 5 + 340);
+    t.cube = 0;
+    /* DXT1 counts 4x4 blocks of 8 bytes. */
+    memset(&t, 0, sizeof t);
+    t.color = 0x0C; t.width = t.height = 8; t.levels = 2;
+    CHECK(tex_layout(&t, &L) && L.kind == K_DXT && L.bpp == 8);
+    CHECK(L.level_off[1] == 32 && L.total == 40);
+    CHECK(tex_format(0x0E, &kind) == 16 && kind == K_DXT);
+    /* Linear textures are one pitch-by-height block. */
+    memset(&t, 0, sizeof t);
+    t.color = 0x12; t.width = 16; t.height = 4; t.pitch = 80; t.levels = 1;
+    CHECK(tex_layout(&t, &L) && L.kind == K_LIN && L.total == 320 && L.levels == 1);
+    t.pitch = 0;
+    CHECK(!tex_layout(&t, &L));
+    /* Invalid colour formats, sizes and out-of-range texture dimensions. */
+    t.color = 0xFF; t.pitch = 80;
+    CHECK(!tex_layout(&t, &L));
+    t.color = 0x06; t.width = 5000; t.height = 8;
+    CHECK(!tex_layout(&t, &L));
+    t.width = 0;
+    CHECK(!tex_layout(&t, &L));
+}
+
+static void *const no_pinned_samplers[4] = { NULL };
+
+/* Single texels and their channel expansion (argb = BGRA bytes). */
+static void check_shared_texels(void)
+{
+    static const uint8_t px16[2] = { 0x1F, 0x00 };   /* R5G6B5: blue 31 */
+    static const uint8_t px32[4] = { 0x10, 0x20, 0x30, 0x40 };
+    uint32_t v;
+    CHECK(x5(31) == 255 && x5(0) == 0 && x6(63) == 255 && x4(15) == 255);
+    CHECK(argb(0x80, 1, 2, 3) == 0x80010203u);
+    CHECK(texel(0x05, px16, NULL, 0) == 0xFF0000FFu);          /* R5G6B5 blue */
+    CHECK(texel(0x04, px16, NULL, 0) == argb(0, 0, x4(1), 255));  /* A4R4G4B4: g=1, b=15 */
+    CHECK(texel(0x06, px32, NULL, 0) == 0x40302010u);          /* A8R8G8B8 */
+    CHECK(texel(0x07, px32, NULL, 0) == 0xFF302010u);          /* X8R8G8B8 */
+    CHECK(texel(0x00, px32, NULL, 0) == 0xFF101010u);          /* Y8 */
+    CHECK(texel(0x0B, px32, NULL, 0) == 0);          /* I8 refuses missing palette */
+    v = texel(0x19, px32, NULL, 0);                             /* A8: white with alpha */
+    CHECK(v == 0x10FFFFFFu);
+    CHECK(texel(0x1A, px32, NULL, 0) == 0x20101010u);          /* A8Y8 */
+    CHECK(texel(0x99, px32, NULL, 0) == 0xFFFF00FFu);          /* unknown: magenta */
+    CHECK(surface_color_bpp(0x3) == 2 && surface_color_bpp(0x6) == 4);
+    CHECK(surface_color_bpp(0x9) == 1 && surface_color_bpp(0xF) == 0);
+    CHECK(surface_alpha_mode(0x1) == 0 && surface_alpha_mode(0x2) == 1);
+    CHECK(surface_alpha_mode(0x6) == 0 && surface_alpha_mode(0x7) == 1);
+    CHECK(surface_alpha_mode(0x5) == 1 && surface_alpha_mode(0xB) == -1);
+}
+
+/* Index rotation for flat shading, vertex attribute sizes, and draw helpers. */
+static void check_shared_draw_helpers(void)
+{
+    uint32_t tri[6] = { 0, 0, 0, 0, 0, 0 }, src[3] = { 4, 5, 6 };
+    uint32_t line[2] = { 0, 0 }, lsrc[2] = { 9, 8 };
+    float c[4];
+    copy_indices(tri, src, 3, 4, NV_D3D_TRIANGLES, 1);
+    CHECK(tri[0] == 2 && tri[1] == 0 && tri[2] == 1);     /* last vertex leads; winding kept */
+    copy_indices(tri, src, 3, 4, NV_D3D_TRIANGLES, 0);
+    CHECK(tri[0] == 0 && tri[1] == 1 && tri[2] == 2);
+    copy_indices(line, lsrc, 2, 8, NV_D3D_LINES, 1);
+    CHECK(line[0] == 0 && line[1] == 1);
+    copy_indices(line, lsrc, 2, 8, NV_D3D_LINES, 0);
+    CHECK(line[0] == 1 && line[1] == 0);
+    CHECK(attr_bytes(2, 4) == 16 && attr_bytes(4, 3) == 3 && attr_bytes(0, 1) == 4);
+    CHECK(attr_bytes(1, 2) == 4 && attr_bytes(6, 1) == 4 && attr_bytes(2, 5) == 0);
+    CHECK(attr_bytes(9, 1) == 0);
+    CHECK(mode_needs_texture(1) && mode_needs_texture(18) && !mode_needs_texture(0));
+    unpack4(0x80FF4020u, c);
+    CHECK(c[0] == 1.0f && fabsf(c[2] - 32.0f / 255.0f) < 1e-6f);   /* R FF, B 20 */
+    CHECK(fabsf(c[3] - 128.0f / 255.0f) < 1e-6f);                   /* A 80 */
+    CHECK(clamp_aspect(1.0f) == 4.0f / 3.0f && clamp_aspect(9.0f) == 4.0f);
+}
+
+/* Mip reduction: a 2x2 box with a unit dimension kept at one texel. */
+static void check_shared_halving(void)
+{
+    uint32_t px[4] = { 0x00000000u, 0x40404040u, 0x80808080u, 0xC0C0C0C0u }, out[1];
+    halve_bgra(px, 2, 2, out);
+    CHECK(out[0] == 0x60606060u);
+    px[0] = 0xFF000000u; px[1] = 0xFF000000u;
+    halve_bgra(px, 2, 1, out);
+    CHECK(out[0] == 0xFF000000u);
+}
+
+/* Everything in nv2a_render_common.h a platform's SDL build runs. */
+static void nv2a_common_checks(void)
+{
+    check_shared_layouts();
+    check_shared_texels();
+    check_shared_draw_helpers();
+    check_shared_halving();
+}
+
+
+/* Standalone renderer fixtures do not request executor replay. */
+void nv2a_pb_interp_enable(int on) { (void)on; abort(); }
+int nv2a_pb_replay(float t) { (void)t; abort(); return 0; }
+int xbox_GetDisplayMode(uint32_t *pitch, uint32_t *bpp, uint32_t *w, uint32_t *h)
+{ (void)pitch; (void)bpp; (void)w; (void)h; return 0; }
+
+#endif
diff --git a/tests/nv2a_sdlgpu_test_host.h b/tests/nv2a_sdlgpu_test_host.h
new file mode 100644
index 00000000..c83e6ce4
--- /dev/null
+++ b/tests/nv2a_sdlgpu_test_host.h
@@ -0,0 +1,161 @@
+/* Host side for the SDL3 GPU renderer's standalone test builds. Include after
+ * nv2a_sdlgpu.c. The renderer's framebuffer and guest-memory callbacks are
+ * provided here (no presentation, no game): the test sets nv2a_test_ram to its
+ * guest RAM image. The window is fb_window_sdl.c's own, opened by
+ * nv2a_d3d_init (hidden or offscreen when SDL_VIDEO_DRIVER asks for it). */
+#ifndef NV2A_SDLGPU_TEST_HOST_H
+#define NV2A_SDLGPU_TEST_HOST_H
+
+#include <SDL3/SDL.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint8_t *nv2a_test_ram;
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)nv2a_test_ram; }
+/* No window: the GPU tests draw to their own targets. The renderer's window
+ * (fb_window_sdl.c) pulls in the game's input layer; these stand in for it. */
+SDL_Window *fbw_sdl_open(SDL_WindowFlags extra_flags) { (void)extra_flags; return NULL; }
+void fbw_sdl_pump(void) {}
+SDL_Window *xbox_FramebufferSdlWindow(void) { return NULL; }
+int xbox_FramebufferPaused(void) { return 0; }
+void recomp_sampler_watch_current_thread(void) {}
+void recomp_sampler_report(double ms) { (void)ms; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { (void)ovl; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+void xbox_FramebufferRenderHostOverlay(void *device, void *context, void *target)
+{
+    (void)device; (void)context; (void)target;
+}
+#ifndef NV2A_TEST_OWN_VSH   /* a test that replays a native vertex program defines these */
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4] { (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { (void)version; return NULL; }
+#endif
+
+static void nv2a_test_setenv(const char *name, const char *value)
+{
+#ifdef _WIN32
+    _putenv_s(name, value);
+#else
+    setenv(name, value, 1);
+#endif
+}
+
+static void nv2a_test_default_env(const char *name, const char *value)
+{
+    if (!getenv(name)) nv2a_test_setenv(name, value);
+}
+
+/* The renderer settings every test starts from: one sample, unscaled, no
+ * specialised shaders, no frame cap (a test may preset them before this).
+ * Without a display, SDL's offscreen video driver stands in for the window
+ * (the GPU device does not need one). */
+static int nv2a_test_init(void)
+{
+    nv2a_test_default_env("RECOMP_MSAA", "1");
+    nv2a_test_default_env("RECOMP_RENDER_SCALE", "1");
+    nv2a_test_default_env("RECOMP_PS_SPEC", "0");
+    nv2a_test_default_env("RECOMP_FPS_LIMIT", "0");
+#ifndef _WIN32
+    if (!getenv("SDL_VIDEO_DRIVER") && !getenv("DISPLAY") && !getenv("WAYLAND_DISPLAY"))
+        nv2a_test_setenv("SDL_VIDEO_DRIVER", "offscreen");
+#endif
+    return nv2a_d3d_init();
+}
+
+/* Blocking readback of one level/layer of a texture, tightly packed, with
+ * bytes_per_texel bytes per texel (4 for BGRA, 8 for RGBA16). Submits
+ * everything recorded so far first, so the copy sees every draw and upload
+ * issued before this call. */
+static int nv2a_test_read_texels(SDL_GPUTexture *tex, uint32_t w, uint32_t h, uint32_t bytes_per_texel,
+                                 uint32_t level, uint32_t layer, void *out)
+{
+    SDL_GPUTransferBufferCreateInfo ci;
+    SDL_GPUTransferBuffer *tb;
+    SDL_GPUCopyPass *pass;
+    SDL_GPUTextureRegion src;
+    SDL_GPUTextureTransferInfo dst;
+    SDL_GPUFence *fence = NULL;
+    void *p;
+    int ok = 0;
+    copy_end();
+    submit(NULL);
+    memset(&ci, 0, sizeof ci);
+    ci.usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD;
+    ci.size = w * h * bytes_per_texel;
+    tb = SDL_CreateGPUTransferBuffer(s_dev, &ci);
+    if (!tb) return 0;
+    if (!cmd()) { SDL_ReleaseGPUTransferBuffer(s_dev, tb); return 0; }
+    pass = SDL_BeginGPUCopyPass(s_cmd);
+    memset(&src, 0, sizeof src);
+    memset(&dst, 0, sizeof dst);
+    src.texture = tex; src.mip_level = level; src.layer = layer;
+    src.w = w; src.h = h; src.d = 1;
+    dst.transfer_buffer = tb; dst.pixels_per_row = w; dst.rows_per_layer = h;
+    SDL_DownloadFromGPUTexture(pass, &src, &dst);
+    SDL_EndGPUCopyPass(pass);
+    submit(&fence);
+    if (fence) {
+        SDL_WaitForGPUFences(s_dev, true, &fence, 1);
+        SDL_ReleaseGPUFence(s_dev, fence);
+        p = SDL_MapGPUTransferBuffer(s_dev, tb, false);
+        if (p) {
+            memcpy(out, p, (size_t)w * h * bytes_per_texel);
+            SDL_UnmapGPUTransferBuffer(s_dev, tb);
+            ok = 1;
+        }
+    }
+    SDL_ReleaseGPUTransferBuffer(s_dev, tb);
+    return ok;
+}
+
+/* One level/layer as BGRA texels, the renderer's native pixel order. */
+static int nv2a_test_read_level(SDL_GPUTexture *tex, uint32_t w, uint32_t h,
+                                uint32_t level, uint32_t layer, uint32_t *out)
+{
+    return nv2a_test_read_texels(tex, w, h, 4, level, layer, out);
+}
+
+/* Texel (x, y) of the colour target at guest address color_va, as the GPU
+ * holds it now (0xDEADBEEF if the target is missing or unreadable). */
+static uint32_t nv2a_test_target_pixel(uint32_t color_va, uint32_t x, uint32_t y)
+{
+    Surface *s = surface_find(phys(color_va));
+    uint32_t *texels, result = 0xDEADBEEFu;
+    if (!s || !s->tex) return result;
+    texels = malloc((size_t)s->iw * s->ih * 4);
+    if (!texels) return result;
+    if (nv2a_test_read_level(s->tex, s->iw, s->ih, 0, 0, texels))
+        result = texels[y * s->iw + x];
+    free(texels);
+    return result;
+}
+
+/* A triangle covering the centre of a 64x64 clip, drawn with the fixed-function
+ * diffuse colour (ARGB) through the renderer's normal draw path. */
+static void nv2a_test_triangle(const NvD3DState *st, uint32_t argb, int program)
+{
+    static const uint32_t indices[] = {0, 1, 2};
+    float vertices[3][4] = {{-8, -8, .5f, 1}, {200, -8, .5f, 1}, {-8, 200, .5f, 1}};
+    float defaults[16][4] = {{0}};
+    NvD3DAttrib attributes[16] = {{0}};
+    unpack4(argb, defaults[3]);
+    attributes[0].enabled = 1;
+    attributes[0].type = 2;
+    attributes[0].size = 4;
+    attributes[0].stride = sizeof vertices[0];
+    attributes[0].data = (const uint8_t *)vertices;
+    nv2a_d3d_draw_ub(st, NV_D3D_TRIANGLES, attributes, defaults, program, indices, 3, 0, 2, NULL);
+}
+
+
+/* Standalone renderer fixtures do not request executor replay. */
+void nv2a_pb_interp_enable(int on) { (void)on; abort(); }
+int nv2a_pb_replay(float t) { (void)t; abort(); return 0; }
+int xbox_GetDisplayMode(uint32_t *pitch, uint32_t *bpp, uint32_t *w, uint32_t *h)
+{ (void)pitch; (void)bpp; (void)w; (void)h; return 0; }
+void xbox_FramebufferSdlHints(void) {}
+
+#endif
