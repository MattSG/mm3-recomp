diff --git a/tests/kernel_io_mapping/test_main.c b/tests/kernel_io_mapping/test_main.c
new file mode 100644
index 00000000..71d388c8
--- /dev/null
+++ b/tests/kernel_io_mapping/test_main.c
@@ -0,0 +1,478 @@
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include "../../src/usb/ohci.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include "host/xbox_host.h"
+#include "nv2a/nv2a_mmio_hook.h"
+#include "nv2a/nv2a_state.h"
+#else
+#include <pthread.h>
+#include <sched.h>
+#include <unistd.h>
+#include <sys/wait.h>
+#include <sys/resource.h>
+#endif
+typedef void (*guest_fn)(void);
+guest_fn recomp_lookup(uint32_t address) { (void)address; abort(); }
+guest_fn recomp_lookup_manual(uint32_t address) { (void)address; abort(); }
+extern guest_fn recomp_lookup_kernel(uint32_t);
+extern RECOMP_TLS uint32_t g_eax, g_esp;
+static int failed;
