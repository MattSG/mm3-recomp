+static ID3D11Buffer *default_buffer(UINT bytes, UINT bind)
+{
+    D3D11_BUFFER_DESC desc = {0}; ID3D11Buffer *buffer = NULL;
+    desc.ByteWidth = bytes; desc.Usage = D3D11_USAGE_DEFAULT; desc.BindFlags = bind;
