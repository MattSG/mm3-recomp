+/* Original row-by-row implementation retained only as a benchmark reference. */
+static void decode_before(const NvD3DTexture *t, const TexLayout *L, const uint8_t *src,
+                          int lv, const uint32_t *pal, uint32_t *out)
+{
+    uint32_t w = L->level_w[lv], h = L->level_h[lv], x, y;
+    if (L->kind == K_DXT) {
+        uint32_t bw = (w + 3) / 4, bh = (h + 3) / 4, bx, by, px[16];
+        for (by = 0; by < bh; by++)
+            for (bx = 0; bx < bw; bx++) {
+                d3d8_dxt_decode_block(src + ((size_t)by * bw + bx) * L->bpp, t->color, px);
+                for (y = 0; y < 4 && by * 4 + y < h; y++)
+                    for (x = 0; x < 4 && bx * 4 + x < w; x++)
+                        out[(size_t)(by * 4 + y) * w + bx * 4 + x] = px[y * 4 + x];
+            }
+    } else {
+        uint32_t mx, my, oy = 0;
+        xbox_swizzle_masks(w, h, &mx, &my);
+        for (y = 0; y < h; y++) {
+            uint32_t ox = 0, *dst = out + (size_t)y * w;
+            for (x = 0; x < w; x++) {
+                dst[x] = texel(t->color, src + (size_t)(oy + ox) * L->bpp, pal, t->palette_len);
+                ox = (ox - mx) & mx;
+            }
+            oy = (oy - my) & my;
+        }
+    }
+}
+
+typedef void (*DecodeFunction)(const NvD3DTexture *, const TexLayout *, const uint8_t *,
+                               int, const uint32_t *, uint32_t *);
+static volatile uint32_t decode_sink;
+
+static __declspec(noinline) double time_decode(DecodeFunction function,
+    const NvD3DTexture *texture, const TexLayout *layout, uint8_t *data,
+    uint32_t *out, unsigned repetitions)
+{
+    LARGE_INTEGER frequency;
+    int64_t start, elapsed;
+    unsigned i;
+    QueryPerformanceFrequency(&frequency);
+    start = qpc();
+    for (i = 0; i < repetitions; i++) {
+        data[0]++;
+        function(texture, layout, data, 0, NULL, out);
+        decode_sink ^= out[i & 255];
+    }
+    elapsed = qpc() - start;
+    return elapsed / (double)frequency.QuadPart;
+}
+
+static int benchmark_decode(void)
+{
+    const unsigned formats[] = { 0x06, 0x07, 0x0C, 0x0E, 0x0F };
+    uint8_t *data = malloc(4 * 1024 * 1024 + 64);
+    uint32_t *out = malloc(4 * 1024 * 1024);
+    uint32_t state = 0x1A2B3C4Du;
+    unsigned i, sample, item, repetitions;
+    double scalar[7], optimized[7];
+    CHECK(data);
+    CHECK(out);
+    for (i = 0; i < 4 * 1024 * 1024 + 64; i++) data[i] = (uint8_t)random_word(&state);
+    for (item = 0; item < 5; item++) {
+        NvD3DTexture texture = {0};
+        TexLayout layout;
+        texture.color = formats[item];
+        texture.width = texture.height = 1024; texture.levels = 1;
+        CHECK(tex_layout(&texture, &layout));
+        repetitions = 8;
+        for (sample = 0; sample < 7; sample++) {
+            scalar[sample] = time_decode(decode_before, &texture, &layout, data + 1, out, repetitions);
+            optimized[sample] = time_decode(decode_level, &texture, &layout, data + 1, out, repetitions);
+        }
+        for (i = 0; i < 7; i++)
+            for (sample = i + 1; sample < 7; sample++) {
+                double t;
+                if (scalar[sample] < scalar[i]) { t = scalar[i]; scalar[i] = scalar[sample]; scalar[sample] = t; }
+                if (optimized[sample] < optimized[i]) { t = optimized[i]; optimized[i] = optimized[sample]; optimized[sample] = t; }
+            }
+        printf("DECODE format %02X 1024x1024: before %.3f ms, selected %.3f ms per upload (%.2fx)\n",
+               formats[item], scalar[3] * 1000 / repetitions, optimized[3] * 1000 / repetitions,
+               scalar[3] / optimized[3]);
+    }
+    free(data);
+    free(out);
+    return 0;
+}
+
+static int test_guest_mips(void)
+{
+    NvD3DTexture t = {0};
+    ID3D11ShaderResourceView *view;
+    ID3D11Resource *resource = NULL;
+    ID3D11Texture2D *texture = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    size_t before = s_tex_bytes;
+    uint32_t i;
+    t.addr=0x30000; t.color=0x06; t.format=0x03320600;
+    t.width=t.height=8; t.levels=2;
+    for(i=0;i<80;i++) ((uint32_t *)(ram+t.addr))[i]=i<64?0xFFFF0000u:0xFF0000FFu;
+    view=texture_get(&t); CHECK(view);
+    ID3D11ShaderResourceView_GetResource(view,&resource);
+    CHECK(SUCCEEDED(ID3D11Resource_QueryInterface(resource,&IID_ID3D11Texture2D,(void **)&texture)));
+    ID3D11Texture2D_GetDesc(texture,&desc);
+    ID3D11Texture2D_Release(texture); ID3D11Resource_Release(resource);
+    CHECK(desc.MipLevels==2 && desc.Format==DXGI_FORMAT_B8G8R8A8_UNORM);
+    CHECK(s_tex_bytes==before+320);
+    CHECK(read_mip(view,0)==0xFFFF0000u && read_mip(view,1)==0xFF0000FFu);
+    puts("PASS: default cache retains exactly two authored mip levels and their GPU pixels");
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    if (!strcmp(argv[1], "decode_equivalence")) return test_decode_equivalence();
+    if (!strcmp(argv[1], "benchmark_decode")) return benchmark_decode();
+    if (!strcmp(argv[1], "mip_inplace")) return test_mip_inplace();
+    if (!strcmp(argv[1], "benchmark_mip_cpu")) return benchmark_mip_cpu();
+    ram = calloc(1, (!strcmp(argv[1], "benchmark_native_bc") || !strcmp(argv[1], "benchmark_mip_upload") ||
+                     !strcmp(argv[1], "scanout_size")) ? 0x1000000 : 0x100000); /* a 1024x480 scanout is 2 MB */
+    CHECK(ram);
+    _putenv_s("RECOMP_MSAA", "1");
+    _putenv_s("RECOMP_RENDER_SCALE", "1");
+    _putenv_s("RECOMP_PS_SPEC", "0");
+    _putenv_s("RECOMP_FPS_LIMIT", "0");
+    CHECK(nv2a_d3d_init());
+    if (!strcmp(argv[1], "srv_retry")) return test_srv_retry();
+    if (!strcmp(argv[1], "mip_retry")) return test_mip_retry();
+    if (!strcmp(argv[1], "refusals")) return test_refusals();
+    if (!strcmp(argv[1], "scanout_size")) return test_scanout_size();
+    if (!strcmp(argv[1], "palette_identity")) return test_palette_identity();
+    if (!strcmp(argv[1], "palette_bounds")) return test_palette_bounds();
+    if (!strcmp(argv[1], "guest_mips")) return test_guest_mips();
+    if (!strcmp(argv[1], "native_bc")) return test_native_bc(1);
+    if (!strcmp(argv[1], "native_bc_default")) return test_native_bc(0);
+    if (!strcmp(argv[1], "mip_chain")) return test_mip_chain();
+    if (!strcmp(argv[1], "benchmark_mip_upload")) return benchmark_mip_upload();
+    if (!strcmp(argv[1], "benchmark_native_bc")) return benchmark_native_bc();
+    CHECK(0);
+}
+
+/* These renderer-only fixtures never request executor frame replay. */
+void nv2a_pb_interp_enable(int on) { (void)on; abort(); }
+long nv2a_pb_frames_done(void) { abort(); return 0; }
+int nv2a_pb_replay(float t) { (void)t; abort(); return 0; }
diff --git a/tests/nv2a_textures/test_textures_cpu.c b/tests/nv2a_textures/test_textures_cpu.c
new file mode 100644
index 00000000..111421d6
--- /dev/null
+++ b/tests/nv2a_textures/test_textures_cpu.c
@@ -0,0 +1,41 @@
+/* CPU texture decoding and mip generation, shared by every renderer. These
+ * exercise nv2a_render_common.h and the swizzle/DXT helpers only, so they run
+ * on Windows and Linux alike. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../src/video/nv2a_d3d11.h"
+#include "../../src/video/nv2a_render_common.h"
+#include "texture_cpu_tests.h"
+
+static int test_mip_policy(int expected)
+{
+    NvD3DTexture t = {0}; TexLayout layout;
+    t.color = 0x06; t.width = t.height = 32; t.levels = 2;
+    CHECK(tex_layout(&t, &layout) && layout.levels == 2);
+    CHECK(host_levels(&layout, &t) == expected);
+    /* Startup-fixed policy cannot silently change existing cache semantics. */
+#ifdef _WIN32
+    _putenv_s("RECOMP_COMPLETE_MIPS", expected == 2 ? "1" : "0");
+#else
+    setenv("RECOMP_COMPLETE_MIPS", expected == 2 ? "1" : "0", 1);
+#endif
+    CHECK(host_levels(&layout, &t) == expected);
+    t.levels = 1;
+    CHECK(tex_layout(&t, &layout) && host_levels(&layout, &t) == 1);
+    t.levels = 2; t.format = (3u << 4) | (2u << 28);
+    CHECK(tex_layout(&t, &layout) && host_levels(&layout, &t) == 2);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc >= 2);
+    if (!strcmp(argv[1], "mip_policy")) { CHECK(argc == 3); return test_mip_policy(atoi(argv[2])); }
+    CHECK(argc == 2);
+    if (!strcmp(argv[1], "decode_equivalence")) return test_decode_equivalence();
+    if (!strcmp(argv[1], "mip_inplace")) return test_mip_inplace();
+    fprintf(stderr, "unknown case %s\n", argv[1]);
+    return 1;
+}
diff --git a/tests/nv2a_textures/test_textures_sdlgpu.c b/tests/nv2a_textures/test_textures_sdlgpu.c
new file mode 100644
index 00000000..2e0a214f
--- /dev/null
+++ b/tests/nv2a_textures/test_textures_sdlgpu.c
@@ -0,0 +1,276 @@
+/* SDL3 GPU texture cache, the counterpart of test_textures.c: failed resource
+ * creation retries without a poisoned entry, complete mip publication, a
+ * scratch allocation failure keeps the previous image, palette length is part
+ * of identity, and generated mips match the reference. Pixels are read back
+ * from the GPU. Shared CPU cases run in nv2a_textures_cpu. */
+#include <SDL3/SDL.h>
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Failure injection in the renderer's own calls: texture creation and the
+ * scratch allocation that holds generated mips. */
+static int fail_create;
+static uint32_t created_levels;
+static SDL_GPUTextureFormat created_format;
+static size_t fail_alloc_size;
+static int fail_alloc;
+
+static SDL_GPUTexture *test_create_texture(SDL_GPUDevice *device, const SDL_GPUTextureCreateInfo *info)
+{
+    if (fail_create) {
+        fail_create--;
+        return NULL;
+    }
+    created_levels=info->num_levels; created_format=info->format;
+    return (SDL_CreateGPUTexture)(device, info);
+}
+
+static void *test_alloc(size_t bytes)
+{
+    if (fail_alloc && bytes == fail_alloc_size) {
+        fail_alloc--;
+        return NULL;
+    }
+    return (malloc)(bytes);
+}
+
+#define SDL_CreateGPUTexture(device, info) test_create_texture(device, info)
+#define malloc(bytes) test_alloc(bytes)
+#include "../../src/video/nv2a_sdlgpu.c"
+#include "../nv2a_sdlgpu_test_host.h"
+#include "texture_cpu_tests.h"
+#undef malloc
+
+/* Texel (0, 0) of one mip of one face; the whole level is read back. */
+static int read_texel0(SDL_GPUTexture *view, uint32_t w, uint32_t h, uint32_t mip, uint32_t *pixel)
+{
+    uint32_t *level = malloc((size_t)w * h * 4);
+    int ok;
+    if (!level) return 0;
+    ok = nv2a_test_read_level(view, w, h, mip, 0, level);
+    *pixel = level[0];
+    free(level);
+    return ok;
+}
+
+static int test_srv_retry(void)
+{
+    NvD3DTexture texture = {0};
+    SDL_GPUTexture *view;
+    size_t count = s_tex_count, bytes = s_tex_bytes;
+    uint32_t i, pixel = 0;
+    texture.addr = 0x20000;
+    texture.color = 0x12;
+    texture.format = 0x00011200;
+    texture.width = texture.height = 4;
+    texture.pitch = 16; texture.levels = 1;
+    for (i = 0; i < 16; i++) ((uint32_t *)(nv2a_test_ram + texture.addr))[i] = 0xFF00FF00u;
+    fail_create = 1;
+    CHECK(texture_get_with_levels(&texture, NULL) == NULL);
+    CHECK(fail_create == 0);
+    CHECK(s_tex_count == count && s_tex_bytes == bytes);
+    /* Retry in the same kick: the failed texture must never become a cache hit. */
+    view = texture_get_with_levels(&texture, NULL);
+    CHECK(view && read_texel0(view, 4, 4, 0, &pixel) && pixel == 0xFF00FF00u);
+    CHECK(texture_get_with_levels(&texture, NULL) == view);
+    nv2a_d3d_kick();
+    CHECK(texture_get_with_levels(&texture, NULL) == view);
+    CHECK(s_tex_count == count + 1);
+    CHECK(s_tex_bytes == bytes + 16 * 4);
+    puts("PASS: failed texture creation retries immediately without a poisoned cache entry");
+    return 0;
+}
+
+static int test_mip_retry(void)
+{
+    NvD3DTexture texture = {0};
+    SDL_GPUTexture *view;
+    size_t count = s_tex_count, bytes = s_tex_bytes;
+    uint32_t i, pixel = 0;
+    texture.addr = 0x30000;
+    texture.color = 0x06;
+    texture.format = 0x03320600;
+    texture.width = texture.height = 8; texture.levels = 2;
+    for (i = 0; i < 64; i++) ((uint32_t *)(nv2a_test_ram + texture.addr))[i] = 0xFFFF0000u;
+    for (i = 64; i < 80; i++) ((uint32_t *)(nv2a_test_ram + texture.addr))[i] = 0xFF0000FFu;
+    /* Generated mips reuse the top-level scratch. An allocation failure must
+     * still leave the complete previous GPU image visible and retryable. */
+    free(s_up_pixels); s_up_pixels = NULL; s_up_cap = 0;
+    fail_alloc_size = 8 * 8 * 4;
+    fail_alloc = 1;
+    CHECK(texture_get_with_levels(&texture, NULL) == NULL);
+    CHECK(fail_alloc == 0);
+    CHECK(s_tex_count == count && s_tex_bytes == bytes);
+    view = texture_get_with_levels(&texture, NULL);
+    CHECK(view);
+    CHECK(read_texel0(view, 8, 8, 0, &pixel) && pixel == 0xFFFF0000u);
+    for (i = 1; i < 4; i++) {
+        uint32_t size = 8u >> i ? 8u >> i : 1;
+        CHECK(read_texel0(view, size, size, i, &pixel) && pixel == 0xFF0000FFu);
+    }
+    CHECK(s_tex_count == count + 1);
+    CHECK(s_tex_bytes == bytes + (64 + 16 + 4 + 1) * 4);
+    /* Also retry a failed update of an existing resource. */
+    for (i = 64; i < 80; i++) ((uint32_t *)(nv2a_test_ram + texture.addr))[i] = 0xFF00FF00u;
+    nv2a_d3d_kick();
+    free(s_up_pixels); s_up_pixels = NULL; s_up_cap = 0;
+    fail_alloc = 1;
+    CHECK(texture_get_with_levels(&texture, NULL) == view);
+    CHECK(fail_alloc == 0 && s_tex_count == count + 1);
+    for (i = 1; i < 4; i++) {
+        uint32_t size = 8u >> i ? 8u >> i : 1;
+        CHECK(read_texel0(view, size, size, i, &pixel) && pixel == 0xFF0000FFu);
+    }
+    CHECK(texture_get_with_levels(&texture, NULL) == view);
+    for (i = 1; i < 4; i++) {
+        uint32_t size = 8u >> i ? 8u >> i : 1;
+        CHECK(read_texel0(view, size, size, i, &pixel) && pixel == 0xFF00FF00u);
+    }
+    puts("PASS: scratch allocation failure cannot publish incomplete mips and retries existing uploads");
+    return 0;
+}
+
+static int test_palette_identity(void)
+{
+    NvD3DTexture texture = {0};
+    SDL_GPUTexture *short_view, *long_view;
+    uint32_t pixel = 0;
+    texture.addr = 0x40000;
+    texture.color = 0x0B; texture.format = 0x02210B00;
+    texture.width = texture.height = 4; texture.levels = 1;
+    texture.palette = 0x41000; texture.palette_len = 32;
+    memset(nv2a_test_ram + texture.addr, 7, 16);
+    ((uint32_t *)(nv2a_test_ram + texture.palette))[7] = 0xFFFF0000u;
+    short_view = texture_get_with_levels(&texture, NULL);
+    CHECK(short_view && read_texel0(short_view, 4, 4, 0, &pixel) && pixel == 0xFFFF0000u);
+    /* PALETTE_LENGTH is a separate register from FORMAT and may change
+     * between draws of a kick. Their validation/hash spans differ. */
+    texture.palette_len = 256;
+    long_view = texture_get_with_levels(&texture, NULL);
+    CHECK(long_view && long_view != short_view);
+    CHECK(read_texel0(long_view, 4, 4, 0, &pixel) && pixel == 0xFFFF0000u);
+    texture.palette_len = 32;
+    CHECK(texture_get_with_levels(&texture, NULL) == short_view);
+    puts("PASS: independently changed palette length cannot bypass cache validation");
+    return 0;
+}
+
+/* The generated image for one face and mip: the guest level decoded by the
+ * shared CPU code, or a reduction of the previous level. */
+static void expected_mip(const NvD3DTexture *texture, const TexLayout *layout, uint32_t face,
+                         uint32_t mip, uint32_t *pixels)
+{
+    uint32_t w = texture->width >> mip ? texture->width >> mip : 1;
+    uint32_t h = texture->height >> mip ? texture->height >> mip : 1;
+    if (mip < (uint32_t)layout->levels) {
+        decode_level(texture, layout, nv2a_test_ram + texture->addr + face * layout->face_stride +
+                     layout->level_off[mip], (int)mip, NULL, pixels);
+    } else {
+        uint32_t pw = texture->width >> (mip - 1), ph = texture->height >> (mip - 1);
+        uint32_t reduced[32 * 32];
+        mip_reference(pixels, pw ? pw : 1, ph ? ph : 1, reduced);
+        memcpy(pixels, reduced, (size_t)w * h * 4);
+    }
+}
+
+static int check_mip_resource(SDL_GPUTexture *view, const NvD3DTexture *texture, const TexLayout *layout)
+{
+    uint32_t pixels[32 * 32], got[32 * 32];
+    uint32_t face, mip, w, h, levels = host_levels(layout, texture);
+    for (face = 0; face < (uint32_t)layout->faces; face++) {
+        w = texture->width; h = texture->height;
+        for (mip = 0; mip < levels; mip++) {
+            expected_mip(texture, layout, face, mip, pixels);
+            CHECK(nv2a_test_read_level(view, w, h, mip, face, got));
+            CHECK(!memcmp(got, pixels, (size_t)w * h * 4));
+            if (w > 1) w /= 2;
+            if (h > 1) h /= 2;
+        }
+    }
+    return 0;
+}
+
+static int test_mip_chain(void)
+{
+    /* Two guest levels never complete the chain, so every case here is a
+     * BGRA host image with generated mips (the native BC path is a separate
+     * case, native_bc). */
+    const unsigned formats[] = {0x06, 0x07, 0x0C, 0x0E, 0x0F};
+    const unsigned dimensions[][2] = {{16, 16}, {32, 8}, {1, 32}, {32, 1}};
+    uint32_t random = 0xDAC35691u;
+    unsigned format, dimension, iteration, i, count = 0, checked = 0;
+    for (format = 0; format < sizeof formats / sizeof formats[0]; format++)
+        for (dimension = 0; dimension < sizeof dimensions / sizeof dimensions[0]; dimension++) {
+            NvD3DTexture texture = {0};
+            TexLayout layout;
+            SDL_GPUTexture *first = NULL, *view;
+            texture.addr = 0x20000 + count++ * 0x4000;
+            texture.color = formats[format];
+            texture.format = (formats[format] << 8) | 0x03220000u;
+            texture.width = dimensions[dimension][0]; texture.height = dimensions[dimension][1];
+            texture.levels = 2; texture.cube = dimension == 0;
+            CHECK(tex_layout(&texture, &layout));
+            CHECK(texture_host_format(&texture, &layout, host_levels(&layout, &texture)) ==
+                  SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM);
+            checked++;
+            for (iteration = 0; iteration < 2; iteration++) {
+                for (i = 0; i < layout.total; i++) nv2a_test_ram[texture.addr + i] = (uint8_t)random_word(&random);
+                nv2a_d3d_kick();
+                view = texture_get_with_levels(&texture, NULL);
+                CHECK(view);
+                if (iteration) CHECK(view == first);
+                else first = view;
+                CHECK(!check_mip_resource(view, &texture, &layout));
+            }
+        }
+    CHECK(checked == 20);
+    printf("PASS: generated mip chains match the reference on the GPU for %u textures\n", checked);
+    return 0;
+}
+
+static int test_guest_mips(void)
+{
+    NvD3DTexture t={0};
+    SDL_GPUTexture *view;
+    uint32_t pixels[64], pixel, i;
+    size_t before=s_tex_bytes;
+    t.addr=0x30000; t.color=0x06; t.format=0x03320600;
+    t.width=t.height=8; t.levels=2;
+    for(i=0;i<80;i++) ((uint32_t *)(nv2a_test_ram+t.addr))[i]=i<64?0xFFFF0000u:0xFF0000FFu;
+    view=texture_get_with_levels(&t,NULL); CHECK(view);
+    CHECK(created_levels==2 && created_format==SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM);
+    CHECK(s_tex_bytes==before+320);
+    CHECK(read_texel0(view,8,8,0,&pixel) && pixel==0xFFFF0000u);
+    CHECK(read_texel0(view,4,4,1,&pixel) && pixel==0xFF0000FFu);
+    /* A short BC1 chain remains compressed when completion is not selected. */
+    t.addr=0x40000; t.color=0x0C; t.format=0x00020C00;
+    for(i=0;i<40;i++) nv2a_test_ram[t.addr+i]=(uint8_t)(i*13u);
+    view=texture_get_with_levels(&t,NULL); CHECK(view);
+    CHECK(created_levels==2 && created_format==SDL_GPU_TEXTUREFORMAT_BC1_RGBA_UNORM);
+    CHECK(s_tex_bytes==before+360);
+    CHECK(nv2a_test_read_level(view,8,8,0,0,pixels));
+    CHECK(!memcmp(pixels,nv2a_test_ram+t.addr,32));
+    CHECK(nv2a_test_read_level(view,4,4,1,0,pixels));
+    CHECK(!memcmp(pixels,nv2a_test_ram+t.addr+32,8));
+    puts("PASS: default authored mip pixels, BC1 format and compressed bytes retained");
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    nv2a_test_ram = calloc(1, 0x100000);
+    CHECK(nv2a_test_ram);
+    CHECK(nv2a_test_init());
+    if (!strcmp(argv[1], "guest_mips")) return test_guest_mips();
+    if (!strcmp(argv[1], "srv_retry")) return test_srv_retry();
+    if (!strcmp(argv[1], "mip_retry")) return test_mip_retry();
+    if (!strcmp(argv[1], "palette_identity")) return test_palette_identity();
+    if (!strcmp(argv[1], "mip_chain")) return test_mip_chain();
+    fprintf(stderr, "unknown case %s\n", argv[1]);
+    return 1;
+}
diff --git a/tests/nv2a_textures/texture_cpu_tests.h b/tests/nv2a_textures/texture_cpu_tests.h
new file mode 100644
index 00000000..c8272264
--- /dev/null
+++ b/tests/nv2a_textures/texture_cpu_tests.h
@@ -0,0 +1,108 @@
+/* CPU texture decoding and in-place mip generation. These run the shared
+ * nv2a_render_common.h code only, so both renderers' test builds include them
+ * and every host runs them. */
+#ifndef CHECK
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+#endif
+
+static uint32_t random_word(uint32_t *state)
+{
+    *state ^= *state << 13; *state ^= *state >> 17; *state ^= *state << 5;
+    return *state;
+}
+
+/* In-place generation must preserve every channel, mip, and cube face. */
+static void mip_reference(const uint32_t *src, unsigned w, unsigned h, uint32_t *dst)
+{
+    unsigned nw = w > 1 ? w / 2 : 1, nh = h > 1 ? h / 2 : 1;
+    unsigned x, y, c, dx, dy;
+    for (y = 0; y < nh; y++)
+        for (x = 0; x < nw; x++) {
+            uint32_t pixel = 0;
+            for (c = 0; c < 4; c++) {
+                unsigned sum = 0;
+                for (dy = 0; dy < 2; dy++)
+                    for (dx = 0; dx < 2; dx++) {
+                        unsigned sx = w > 1 ? x * 2 + dx : 0;
+                        unsigned sy = h > 1 ? y * 2 + dy : 0;
+                        sum += (src[sy * w + sx] >> (8 * c)) & 255;
+                    }
+                pixel |= ((sum + 2) / 4) << (8 * c);
+            }
+            dst[y * nw + x] = pixel;
+        }
+}
+
+static int test_mip_inplace(void)
+{
+    const unsigned dimensions[] = {1, 2, 3, 4, 5, 7, 8, 15, 16, 31, 64, 128};
+    uint32_t original[128 * 128], reference[128 * 128], actual[128 * 128 + 2];
+    uint32_t random = 0x58A42F01u;
+    unsigned wi, hi, i, w, h, nw, nh;
+    for (wi = 0; wi < sizeof dimensions / sizeof dimensions[0]; wi++)
+        for (hi = 0; hi < sizeof dimensions / sizeof dimensions[0]; hi++) {
+            w = dimensions[wi]; h = dimensions[hi];
+            for (i = 0; i < w * h; i++) original[i] = random_word(&random);
+            memcpy(actual + 1, original, w * h * 4);
+            actual[0] = actual[1 + w * h] = 0xA5E37C91u;
+            while (w > 1 || h > 1) {
+                nw = w > 1 ? w / 2 : 1; nh = h > 1 ? h / 2 : 1;
+                mip_reference(original, w, h, reference);
+                halve_bgra(actual + 1, w, h, actual + 1);
+                CHECK(!memcmp(reference, actual + 1, nw * nh * 4));
+                CHECK(actual[0] == 0xA5E37C91u);
+                CHECK(actual[1 + dimensions[wi] * dimensions[hi]] == 0xA5E37C91u);
+                memcpy(original, reference, nw * nh * 4);
+                w = nw; h = nh;
+            }
+        }
+    puts("PASS: in-place mip chains exactly match independent channel averaging for 144 rectangles");
+    return 0;
+}
+
+static int test_decode_equivalence(void)
+{
+    uint32_t state = 0x12345678u;
+    uint8_t *data = malloc(65536 + 64);
+    uint32_t *allocation = malloc(65536 + 16), *decoded;
+    const unsigned formats[] = { 0x06, 0x07, 0x0C, 0x0E, 0x0F };
+    const unsigned dimensions[] = { 1, 2, 3, 4, 5, 7, 8, 12, 16, 20, 64, 128 };
+    unsigned i, offset, format, width, height, w, h, x, y;
+    CHECK(data);
+    CHECK(allocation);
+    decoded = allocation + 1;
+    for (i = 0; i < 65536 + 64; i++) data[i] = (uint8_t)random_word(&state);
+    /* Validate complete rectangles, unaligned sources, short mips and both
+     * compressed alpha modes against independent per-texel addressing. */
+    for (format = 0; format < 5; format++)
+        for (width = 0; width < sizeof dimensions / sizeof dimensions[0]; width++)
+            for (height = 0; height < sizeof dimensions / sizeof dimensions[0]; height++)
+                for (offset = 0; offset < 8; offset++) {
+                    NvD3DTexture texture = {0};
+                    TexLayout layout;
+                    w = dimensions[width]; h = dimensions[height];
+                    if (format < 2 && ((w & (w - 1)) || (h & (h - 1)))) continue;
+                    texture.color = formats[format];
+                    texture.width = w; texture.height = h; texture.levels = 1;
+                    CHECK(tex_layout(&texture, &layout));
+                    decoded[-1] = decoded[w * h] = 0xDEADC0DEu;
+                    decode_level(&texture, &layout, data + offset, 0, NULL, decoded);
+                    CHECK(decoded[-1] == 0xDEADC0DEu && decoded[w * h] == 0xDEADC0DEu);
+                    for (y = 0; y < h; y++)
+                        for (x = 0; x < w; x++) {
+                            uint32_t expected;
+                            if (layout.kind == K_DXT)
+                                CHECK(d3d8_dxt_decode_texel(data + offset, texture.color,
+                                                           x, y, w, &expected));
+                            else {
+                                uint32_t address = swizzle_offset(x, y, w, h);
+                                expected = texel(texture.color, data + offset + address * 4, NULL, 0);
+                            }
+                            CHECK(decoded[y * w + x] == expected);
+                        }
+        }
+    free(data);
+    free(allocation);
+    puts("PASS: tiled32-bit and DXT uploads match per-texel decoding across sizes, mips and alignments");
+    return 0;
+}
