+
+void xbox_log(int level, const char *subsystem, const char *format, ...)
+{ (void)level; (void)subsystem; (void)format; }
+const char *xbox_LookupSymbolicLink(const char *name) { (void)name; return NULL; }
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); return 1; \
+} } while (0)
+
+static intptr_t child(const char *exe, const char *mode, const char *root)
+{
+#if defined(_WIN32)
+    return _spawnl(_P_NOWAIT, exe, exe, mode, root, NULL);
+#else
+    pid_t pid = fork();
+    if (!pid) { execl(exe, exe, mode, root, (char *)NULL); _exit(127); }
+    return pid;
+#endif
+}
+
+static int completed(intptr_t pid)
+{
+    int status;
+    if (pid < 0) return 0;
+#if defined(_WIN32)
+    return _cwait(&status, pid, 0) != -1 && status == 0;
+#else
+    return waitpid((pid_t)pid, &status, 0) == pid &&
+           WIFEXITED(status) && WEXITSTATUS(status) == 0;
+#endif
+}
+
+static int query(ULONG index, ULONG expected)
+{
+    ULONG value = 0xdeadbeef, type = 0, length = 0;
+    return xbox_ExQueryNonVolatileSetting(index, &type, &value, 4, &length) == 0 &&
+           value == expected && type == 4 && length == 4;
+}
+
+static int clean_root(const char *root)
+{
+    char path[MAX_PATH + 64];
+    const char *directories[] = {
+        "TitleData", "UserData", "Cache", "SystemData", "UDATA", "TDATA"
+    };
+#if !defined(_WIN32)
+#define _rmdir rmdir
+#endif
+    snprintf(path, sizeof(path), "%s/NonVolatileSettings.bin", root);
+    remove(path);
+    _rmdir(path); /* the write-failure case deliberately made this a directory */
+    snprintf(path, sizeof(path), "%s/NonVolatileSettings.bin.lock", root);
+    remove(path);
+    for (int i = 0; i < 6; i++) {
+        snprintf(path, sizeof(path), "%s/Partition%d.img", root, i);
+        remove(path);
+        snprintf(path, sizeof(path), "%s/%s", root, directories[i]);
+        _rmdir(path);
+    }
+    return _rmdir(root) == 0;
+}
+
+int main(int argc, char **argv)
+{
+    char root[MAX_PATH], other[MAX_PATH + 32], file[MAX_PATH + 32];
+    ULONG value, type, length;
+    unsigned char block[100];
+    FILE *stream;
+    intptr_t first, second;
+    if (argc == 3) {
+        xbox_path_init(".", argv[2]);
+        if (!strcmp(argv[1], "read"))
+            return query(XC_LANGUAGE, 9) ? 0 : 1;
+        if (!strcmp(argv[1], "reader")) {
+            for (unsigned i = 0; i < 5000; i++)
+                CHECK(xbox_ExQueryNonVolatileSetting(XC_MAX_OS, &type, block,
+                                                    sizeof(block), &length) == 0);
+            return 0;
+        }
+        for (value = 0; value < 20; value++)
+            CHECK(xbox_ExSaveNonVolatileSetting(
+                !strcmp(argv[1], "language") ? XC_LANGUAGE : XC_AUDIO,
+                4, &value, 4) == 0);
+        return 0;
+    }
+#if defined(_WIN32)
+    CHECK(GetTempPathA(sizeof(root), root));
+    snprintf(other, sizeof(other), "%sxbox-settings-%lu", root, GetCurrentProcessId());
+    strcpy(root, other);
+    CHECK(CreateDirectoryA(root, NULL));
+    _putenv_s("RECOMP_VIDEO_FLAGS", "");
+#else
+    strcpy(root, "/tmp/xbox-settings-XXXXXX");
+    CHECK(mkdtemp(root));
+    unsetenv("RECOMP_VIDEO_FLAGS");
+#endif
+    xbox_path_init(".", root);
+    CHECK(query(XC_LANGUAGE, 1));
+    CHECK(query(XC_AUDIO, 0));
+    CHECK(query(XC_DVD_REGION, 1));
+    value = 0xdeadbeef; type = 0xfeed; length = 0;
+    CHECK((uint32_t)xbox_ExQueryNonVolatileSetting(XC_LANGUAGE, &type,
+          &value, 3, &length) == 0xc0000023u);
+    CHECK(length == 4 && value == 0xdeadbeef && type == 0xfeed);
+    CHECK(xbox_ExQueryNonVolatileSetting(XC_LANGUAGE, NULL, NULL, 4, NULL) ==
+          STATUS_INVALID_PARAMETER);
+    CHECK(xbox_ExQueryNonVolatileSetting(0xfe, NULL, &value, 4, NULL) ==
+          STATUS_OBJECT_NAME_NOT_FOUND);
+    value = 9;
+    /* The original kernel ignores Type; it must not be mistaken for a
+     * request to change a field's intrinsic REG_DWORD / REG_BINARY type. */
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_LANGUAGE, 3, &value, 4) == 0);
+    CHECK(query(XC_LANGUAGE, 9));
+    CHECK(completed(child(argv[0], "read", root)));
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_LANGUAGE, 4, &value, 5) ==
+          STATUS_INVALID_PARAMETER);
+    CHECK(xbox_ExSaveNonVolatileSetting(0x101, 3, &value, 4) ==
+          STATUS_OBJECT_NAME_NOT_FOUND);
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_AUDIO, 4, NULL, 1) ==
+          STATUS_INVALID_PARAMETER);
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_MISC, 4, &value, 1) == 0);
+    CHECK(query(XC_MISC, 9)); /* short writes zero-fill the rest of the field */
+    memset(block, 0xaa, sizeof(block));
+    CHECK(xbox_ExQueryNonVolatileSetting(XC_MAX_OS, &type, block,
+                                        sizeof(block), &length) == 0);
+    CHECK(type == 3 && length == 96 && block[96] == 0 && block[99] == 0);
+    memcpy(&value, block + 48, 4);
+    CHECK(value == 9);
+    value = 7;
+    memcpy(block + 48, &value, 4);
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_MAX_OS, 4, block, 96) == 0);
+    CHECK(query(XC_LANGUAGE, 7)); /* aggregate and scalar settings share storage */
+    value = 8;
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_VIDEO, 4, &value, 4) == 0);
+#if defined(_WIN32)
+    CHECK(_putenv_s("RECOMP_VIDEO_FLAGS", "10") == 0);
+#else
+    CHECK(setenv("RECOMP_VIDEO_FLAGS", "10", 1) == 0);
+#endif
+    CHECK(query(XC_VIDEO, 0x10));
+#if defined(_WIN32)
+    CHECK(_putenv_s("RECOMP_VIDEO_FLAGS", "") == 0);
+#else
+    CHECK(unsetenv("RECOMP_VIDEO_FLAGS") == 0);
+#endif
+    CHECK(query(XC_VIDEO, 8)); /* host override must not overwrite saved video flags */
+    CHECK(xbox_ExQueryNonVolatileSetting(XC_TZ_STD_NAME, &type, block, 4, NULL) == 0);
+    CHECK(type == 3);
+
+    snprintf(other, sizeof(other), "%s/independent", root);
+    xbox_path_init(".", other);
+    CHECK(query(XC_LANGUAGE, 1));
+    value = 2;
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_LANGUAGE, 4, &value, 4) == 0);
+    xbox_path_init(".", root);
+    CHECK(query(XC_LANGUAGE, 7));
+    first = child(argv[0], "language", root);
+    second = child(argv[0], "audio", root);
+    CHECK(completed(first) && completed(second));
+    CHECK(query(XC_LANGUAGE, 19) && query(XC_AUDIO, 19));
+    /* Real queries overlap real atomic replacements in distinct processes.
+     * Readers must hold the image's shared lock until their handle closes,
+     * otherwise Windows can reject saves with ERROR_SHARING_VIOLATION. */
+    first = child(argv[0], "reader", root);
+    second = child(argv[0], "language", root);
+    CHECK(completed(first) && completed(second));
+    CHECK(query(XC_LANGUAGE, 19));
+    snprintf(file, sizeof(file), "%s/NonVolatileSettings.bin", root);
+    stream = fopen(file, "wb");
+    CHECK(stream && fwrite("bad", 1, 3, stream) == 3);
+    CHECK(fclose(stream) == 0);
+    CHECK((uint32_t)xbox_ExQueryNonVolatileSetting(XC_LANGUAGE, NULL,
+                                                &value, 4, NULL) == 0xc000009cu);
+    CHECK((uint32_t)xbox_ExSaveNonVolatileSetting(XC_LANGUAGE, 4,
+                                               &value, 4) == 0xc000009cu);
+    memset(block, 0, 96); /* full-size image with an invalid checksum */
+    stream = fopen(file, "wb");
+    CHECK(stream && fwrite(block, 1, 96, stream) == 96);
+    CHECK(fclose(stream) == 0);
+    CHECK((uint32_t)xbox_ExQueryNonVolatileSetting(XC_LANGUAGE, NULL,
+                                                &value, 4, NULL) == 0xc000009cu);
+    CHECK(remove(file) == 0);
+#if defined(_WIN32)
+    CHECK(_mkdir(file) == 0);
+#else
+    CHECK(mkdir(file, 0700) == 0);
+#endif
+    CHECK(xbox_ExSaveNonVolatileSetting(XC_LANGUAGE, 4, &value, 4) != 0);
+    CHECK(clean_root(other));
+    CHECK(clean_root(root));
+    puts("PASS: persistent settings, ABI errors, corruption, isolated roots, concurrent writers");
+    return 0;
+}
diff --git a/tests/kernel_test_host.h b/tests/kernel_test_host.h
new file mode 100644
index 00000000..8876eb50
--- /dev/null
+++ b/tests/kernel_test_host.h
@@ -0,0 +1,177 @@
+/*
+ * kernel_test_host.h - host helpers shared by the kernel regression harnesses.
+ *
+ * Tests are written against the Win32 vocabulary (xbox_winnt.h) and narrow
+ * host paths. On Windows this header maps the helpers onto the Win32 calls
+ * they replace. On POSIX it supplies the few CRT and Win32 calls the tests use
+ * that win32_compat does not implement, using the closest POSIX equivalent.
+ */
+#ifndef KERNEL_TEST_HOST_H
+#define KERNEL_TEST_HOST_H
+
+#include "platform/xbox_winnt.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(_WIN32)
+
+#include <io.h>
+
+#define XT_SEP "\\"
+#define xt_stricmp _stricmp
+
+/* Unique empty directory under the user temp path. */
+static inline BOOL xt_make_temp_dir(char *dir, size_t bytes)
+{
+    char temp[MAX_PATH], name[MAX_PATH];
+    if (!GetTempPathA(MAX_PATH, temp) || !GetTempFileNameA(temp, "xht", 0, name))
+        return FALSE;
+    if (bytes <= strlen(name)) return FALSE;
+    strcpy(dir, name);
+    return DeleteFileA(dir) && CreateDirectoryA(dir, NULL);
+}
+
+static inline BOOL xt_make_dir(const char *dir) { return CreateDirectoryA(dir, NULL); }
+static inline BOOL xt_remove_dir(const char *dir) { return RemoveDirectoryA(dir); }
+static inline BOOL xt_delete_file(const char *path) { return DeleteFileA(path); }
+static inline BOOL xt_path_exists(const char *path)
+{
+    return GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
+}
+
+#else  /* POSIX */
+
+#include <dirent.h>
+#include <ftw.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#define XT_SEP "/"
+#define xt_stricmp strcasecmp
+
+/* io.h descriptor helpers. _dup2 returns 0 on success; dup2 returns the fd. */
+static inline int xt_dup2(int from, int to) { return dup2(from, to) < 0 ? -1 : 0; }
+#define _dup(fd)    dup(fd)
+#define _dup2(a, b) xt_dup2((a), (b))
+#define _close(fd)  close(fd)
+#define _fileno(f)  fileno(f)
+/* C11 Annex K tmpfile_s, which glibc does not provide. */
+static inline int xt_tmpfile_s(FILE **f) { *f = tmpfile(); return *f ? 0 : 1; }
+#define tmpfile_s(f) xt_tmpfile_s(f)
+
+#ifndef FILE_LIST_DIRECTORY
+#define FILE_LIST_DIRECTORY        0x00000001u
+#endif
+#ifndef FILE_FLAG_BACKUP_SEMANTICS
+#define FILE_FLAG_BACKUP_SEMANTICS 0x02000000u
+#endif
+
+/* Unique empty directory under $TMPDIR (or /tmp). */
+static inline BOOL xt_make_temp_dir(char *dir, size_t bytes)
+{
+    const char *temp = getenv("TMPDIR");
+    if (!temp || !temp[0]) temp = "/tmp";
+    if (snprintf(dir, bytes, "%s/xht-XXXXXX", temp) >= (int)bytes) return FALSE;
+    return mkdtemp(dir) != NULL;
+}
+
+#ifndef INVALID_FILE_ATTRIBUTES
+#define INVALID_FILE_ATTRIBUTES ((DWORD)-1)
+#endif
+
+static int xt_remove_entry(const char *path, const struct stat *st, int flag,
+                           struct FTW *ftw)
+{
+    (void)st; (void)flag; (void)ftw;
+    return remove(path);
+}
+
+/* Removes a directory tree the test created. POSIX only; Windows tests keep
+ * their explicit cleanup. */
+#ifndef FTW_PHYS
+#define FTW_PHYS  1   /* glibc values; <ftw.h> hides them under strict modes */
+#endif
+#ifndef FTW_DEPTH
+#define FTW_DEPTH 2
+#endif
+
+static inline void xt_remove_tree(const char *dir)
+{
+    nftw(dir, xt_remove_entry, 16, FTW_DEPTH | FTW_PHYS);
+}
+
+static inline BOOL xt_make_dir(const char *dir) { return mkdir(dir, 0755) == 0; }
+static inline BOOL xt_remove_dir(const char *dir) { return rmdir(dir) == 0; }
+static inline BOOL xt_delete_file(const char *path) { return unlink(path) == 0; }
+static inline BOOL xt_path_exists(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0;
+}
+
+/* SetEnvironmentVariableA(name, NULL) removes the variable, as on Windows. */
+static inline BOOL SetEnvironmentVariableA(LPCSTR name, LPCSTR value)
+{
+    return value ? setenv(name, value, 1) == 0 : unsetenv(name) == 0;
+}
+
+/* win32_compat handles are opaque objects with no inheritance flags. The test
+ * only uses this as a presence check; its identity assertions check validity. */
+static inline BOOL GetHandleInformation(HANDLE h, DWORD *flags)
+{
+    if (!h || h == INVALID_HANDLE_VALUE) return FALSE;
+    *flags = 0;
+    return TRUE;
+}
+
+/* Open descriptors of this process, the POSIX analogue of the handle count.
+ * Events and other compat objects are not descriptors, so tests that compare
+ * counts across them are Windows-only. */
+static inline BOOL GetProcessHandleCount(HANDLE process, DWORD *count)
+{
+    DIR *dir;
+    struct dirent *entry;
+    DWORD n = 0;
+    (void)process;
+    dir = opendir("/proc/self/fd");
+    if (!dir) return FALSE;
+    while ((entry = readdir(dir)) != NULL)
+        if (entry->d_name[0] != '.') n++;
+    closedir(dir);
+    *count = n - 1;   /* the descriptor opened for this listing */
+    return TRUE;
+}
+
+#endif /* _WIN32 */
+
+/* Joins a directory and a leaf with the host separator. */
+static inline int xt_join(char *out, size_t bytes, const char *dir, const char *leaf)
+{
+    return snprintf(out, bytes, "%s" XT_SEP "%s", dir, leaf);
+}
+
+/* Creates a new file holding exactly `bytes` bytes of `data`. */
+static inline BOOL xt_write_file(const char *path, const void *data, size_t bytes)
+{
+    FILE *f = fopen(path, "wb");
+    size_t n;
+    if (!f) return FALSE;
+    n = fwrite(data, 1, bytes, f);
+    return fclose(f) == 0 && n == bytes;
+}
+
+/* Reads up to `cap` bytes; returns the count, or -1 if the file cannot be read. */
+static inline long xt_read_file(const char *path, void *buf, size_t cap)
+{
+    FILE *f = fopen(path, "rb");
+    size_t n;
+    if (!f) return -1;
+    n = fread(buf, 1, cap, f);
+    fclose(f);
+    return (long)n;
+}
+
+#endif /* KERNEL_TEST_HOST_H */
diff --git a/tests/keymap/CMakeLists.txt b/tests/keymap/CMakeLists.txt
new file mode 100644
index 00000000..86869ada
--- /dev/null
+++ b/tests/keymap/CMakeLists.txt
@@ -0,0 +1,29 @@
+cmake_minimum_required(VERSION 3.20)
+project(keymap_regression LANGUAGES C)
+add_executable(keymap-test keymap_test.c
+    ../../src/input/keyboard.c ../../src/input/keymap_spec.c ../../src/input/input_map.c)
+if(WIN32)
+    target_sources(keymap-test PRIVATE ../../src/input/mkb_input.c)   # RECOMP_MKB
+endif()
+if(MSVC)
+    target_compile_options(keymap-test PRIVATE /UNDEBUG)
+else()
+    target_compile_options(keymap-test PRIVATE -UNDEBUG)
+endif()
+target_include_directories(keymap-test PRIVATE ../../src)
+if(NOT WIN32)
+    # The pad is SDL3 here; the test never opens a gamepad, but the TU links SDL
+    # and the POSIX Win32 primitives (_stricmp, GetTickCount64) it is built on.
+    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/../../cmake")
+    include(Sdl3)
+    add_subdirectory(../../src/platform platform)
+    target_link_libraries(keymap-test PRIVATE SDL3::SDL3 platform)
+endif()
+enable_testing()
+add_test(NAME keymap COMMAND keymap-test)
+add_test(NAME keymap-menu-click COMMAND keymap-test menu-click)
+add_test(NAME keymap-default-padmap COMMAND keymap-test default-padmap)
+
+if(NOT WIN32)
+    add_test(NAME keymap-two-gamepads COMMAND keymap-test two-gamepads)
+endif()
diff --git a/tests/keymap/keymap_test.c b/tests/keymap/keymap_test.c
new file mode 100644
index 00000000..f3fce8d4
--- /dev/null
+++ b/tests/keymap/keymap_test.c
@@ -0,0 +1,154 @@
+/* RECOMP_KEYMAP rebinds the keyboard pad; unnamed inputs keep their defaults.
+ * RECOMP_MENU_KEYS adds menu navigation only while the probe reports a menu.
+ * A title's keyboard hook sees the pad last, with the menu state. */
+#include "../../src/input/xinput_xbox.h"
+static ULONGLONG test_ticks = 1000;
+static ULONGLONG click_clock(void) { return test_ticks; }
+#define GetTickCount64 click_clock
+#include "../../src/input/xinput_device.c"
+#undef GetTickCount64
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#ifdef _WIN32
+#define set_env(name, value) _putenv_s(name, value)
+#else
+#define set_env(name, value) setenv(name, value, 1)
+#endif
+
+/* The window's key table (keyboard.c), written as the window would. */
+static void press(int vk, int down) { xbox_InputKeySet(vk, down); }
+int xbox_FramebufferHostInputCaptured(void) { return 0; }
+void xbox_FramebufferSetMousePressHandler(int (*handler)(float, float)) { (void)handler; }
+static int menu_flag, hook_calls;
+static BOOL hook_menu;
+static int probe_menu(void) { return menu_flag; }
+static void hook(XBOX_INPUT_STATE *s, BOOL menu)
+{
+    ++hook_calls;
+    hook_menu = menu;
+    if (xbox_FramebufferKeyDown('R')) s->Gamepad.bAnalogButtons[XBOX_BUTTON_B] = 255;
+}
+int xbox_FramebufferMouse(float *x, float *y) { *x = *y = 0; return 0; }
+
+static int consume_click(float x, float y) { assert(x == 0 && y == 0); return 1; }
+
+int main(int argc, char **argv)
+{
+    XBOX_INPUT_STATE s;
+    if (argc == 2 && !strcmp(argv[1], "menu-click")) {
+        assert(!menu_click());
+        xbox_InputSetMenuClickHandler(consume_click);
+        press(VK_LBUTTON, 1);
+        assert(!menu_click()); /* Consumed native click never becomes pad A. */
+        assert(!menu_click());
+        press(VK_LBUTTON, 0); assert(!menu_click());
+        xbox_InputSetMenuClickHandler(NULL);
+        press(VK_LBUTTON, 1); assert(menu_click());
+        test_ticks += 79; assert(menu_click());
+        test_ticks++; assert(!menu_click()); /* Held button does not retrigger. */
+        press(VK_LBUTTON, 0); assert(!menu_click());
+        press(VK_LBUTTON, 1); assert(menu_click());
+        puts("PASS: consumed clicks and bounded mouse-to-A fallback");
+        return 0;
+    }
+
+#ifndef _WIN32
+    if (argc == 2 && !strcmp(argv[1], "two-gamepads")) {
+        SDL_VirtualJoystickDesc desc;
+        SDL_JoystickID ids[2];
+        XINPUT_STATE state;
+        if (!SDL_Init(SDL_INIT_GAMEPAD)) return 30;
+        SDL_INIT_INTERFACE(&desc);
+        desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+        desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+        desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+        desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1u;
+        desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1u;
+        desc.name = "discovery regression";
+        ids[0] = SDL_AttachVirtualJoystick(&desc);
+        ids[1] = SDL_AttachVirtualJoystick(&desc);
+        SDL_UpdateGamepads();
+        int ok = ids[0] && ids[1] &&
+            host_pad_state(0, &state) == ERROR_SUCCESS &&
+            host_pad_state(1, &state) == ERROR_SUCCESS;
+        for (unsigned i = 0; i < XBOX_MAX_CONTROLLERS; ++i)
+            if (g_sdl_pads[i]) SDL_CloseGamepad(g_sdl_pads[i]);
+        if (ids[0]) SDL_DetachVirtualJoystick(ids[0]);
+        if (ids[1]) SDL_DetachVirtualJoystick(ids[1]);
+        SDL_Quit();
+        if (!ok) return 31;
+        puts("PASS: two gamepads discovered on consecutive port polls");
+        return 0;
+    }
+#endif
+    if (argc == 2 && !strcmp(argv[1], "default-padmap")) {
+        XINPUT_GAMEPAD g = {0};
+        XBOX_GAMEPAD out;
+        set_env("RECOMP_PADMAP", "");
+        g.wButtons = XINPUT_GAMEPAD_RIGHT_SHOULDER;
+        pad_buttons(&g, &out);
+        if (out.bAnalogButtons[XBOX_BUTTON_BLACK] != 255 || out.bAnalogButtons[XBOX_BUTTON_WHITE]) return 21;
+        g.wButtons = XINPUT_GAMEPAD_LEFT_SHOULDER;
+        pad_buttons(&g, &out);
+        if (out.bAnalogButtons[XBOX_BUTTON_WHITE] != 255 || out.bAnalogButtons[XBOX_BUTTON_BLACK]) return 22;
+        puts("PASS: right shoulder is Black and left shoulder is White by default");
+        return 0;
+    }
+    set_env("RECOMP_KEYMAP", "A:57,RX-:2,LX-:41,START:0");
+    set_env("RECOMP_MENU_KEYS", "1"); /* read once, like the keymap */
+    set_env("RECOMP_KEYBOARD", "1");
+    xbox_InputSetMenuProbe(probe_menu);
+    press('W', 1); press(VK_RBUTTON, 1); press('Z', 1); press(VK_RETURN, 1); press('A', 1); press('C', 1);
+    keyboard_pad(&s);
+    if (s.Gamepad.bAnalogButtons[XBOX_BUTTON_A] != 255) { puts("FAIL: A not on W"); return 1; }
+    if (s.Gamepad.sThumbRX != -32767) { puts("FAIL: RX- not on right mouse"); return 2; }
+    if (s.Gamepad.sThumbLX != -32767) { puts("FAIL: LX- not on A"); return 3; }
+    if (s.Gamepad.bAnalogButtons[XBOX_BUTTON_X] != 255) { puts("FAIL: X lost its default C"); return 4; }
+    if (s.Gamepad.wButtons & XBOX_GAMEPAD_START) { puts("FAIL: START:0 still bound"); return 5; }
+    press('W', 0);
+    keyboard_pad(&s);
+    if (s.Gamepad.bAnalogButtons[XBOX_BUTTON_A]) { puts("FAIL: A still on Z"); return 6; }
+    /* Menu keys: A is d-pad left (not X), a left click is A, only in menus. */
+    xbox_InputKeysClear();
+    press('A', 1); press(VK_LBUTTON, 1);
+    menu_flag = 1;
+    keyboard_pad(&s);
+    if (!(s.Gamepad.wButtons & XBOX_GAMEPAD_DPAD_LEFT)) { puts("FAIL: A is not left in a menu"); return 7; }
+    if (s.Gamepad.sThumbLX) { puts("FAIL: A still moves the stick in a menu"); return 8; }
+    if (s.Gamepad.bAnalogButtons[XBOX_BUTTON_A] != 255) { puts("FAIL: left click is not A in a menu"); return 9; }
+    menu_flag = 0;
+    keyboard_pad(&s);
+    if (s.Gamepad.wButtons & XBOX_GAMEPAD_DPAD_LEFT) { puts("FAIL: menu keys outside a menu"); return 10; }
+    if (s.Gamepad.sThumbLX != -32767) { puts("FAIL: A lost its binding outside a menu"); return 11; }
+    /* RECOMP_PADMAP: shoulders swapped, A on the right trigger, Start on A. */
+    {
+        XINPUT_GAMEPAD g = {0};
+        XBOX_GAMEPAD out;
+        set_env("RECOMP_PADMAP", "BLACK:LB,WHITE:RB,A:RT,START:A");
+        g.wButtons = XINPUT_GAMEPAD_LEFT_SHOULDER | XINPUT_GAMEPAD_A | XINPUT_GAMEPAD_B;
+        g.bRightTrigger = 200;
+        pad_buttons(&g, &out);
+        if (out.bAnalogButtons[XBOX_BUTTON_BLACK] != 255 || out.bAnalogButtons[XBOX_BUTTON_WHITE]) { puts("FAIL: shoulders not swapped"); return 12; }
+        if (out.bAnalogButtons[XBOX_BUTTON_A] != 200) { puts("FAIL: A not on the right trigger"); return 13; }
+        if (!(out.wButtons & XBOX_GAMEPAD_START)) { puts("FAIL: Start not on A"); return 14; }
+        if (out.bAnalogButtons[XBOX_BUTTON_B] != 255) { puts("FAIL: B lost its own button"); return 15; }
+    }
+    /* The title's hook runs on every read and sees the menu state. */
+    xbox_InputKeysClear();
+    menu_flag = 0;
+    keyboard_pad(&s);
+    if (hook_calls) { puts("FAIL: hook called before it was set"); return 16; }
+    xbox_InputSetKeyboardHook(hook);
+    press('R', 1);
+    keyboard_pad(&s);
+    if (hook_calls != 1 || hook_menu || s.Gamepad.bAnalogButtons[XBOX_BUTTON_B] != 255) { puts("FAIL: hook outside a menu"); return 17; }
+    menu_flag = 1;
+    keyboard_pad(&s);
+    if (hook_calls != 2 || !hook_menu) { puts("FAIL: hook not told about the menu"); return 18; }
+    xbox_InputSetKeyboardHook(NULL);
+    keyboard_pad(&s);
+    if (hook_calls != 2 || s.Gamepad.bAnalogButtons[XBOX_BUTTON_B]) { puts("FAIL: hook still set"); return 19; }
+    puts("PASS: RECOMP_KEYMAP rebinds keys and mouse buttons; menu keys only in menus; RECOMP_PADMAP remaps the pad; the keyboard hook runs last");
+    return 0;
+}
