diff --git a/src/input/keymap_spec.c b/src/input/keymap_spec.c
new file mode 100644
index 00000000..67b9dfa0
--- /dev/null
+++ b/src/input/keymap_spec.c
@@ -0,0 +1,34 @@
+#include "keymap_spec.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int keymap_spec_find(const char *spec, const char *name, unsigned *value)
+{
+    size_t length = strlen(name);
+    const char *entry = spec;
+    while (entry && *entry) {
+        const char *end = strchr(entry, ',');
+        size_t size = end ? (size_t)(end - entry) : strlen(entry);
+        if (size > length + 1 && entry[length] == ':' && !strncmp(entry, name, length)) {
+            if (value) *value = (unsigned)strtoul(entry + length + 1, NULL, 16);
+            return 1;
+        }
+        entry = end ? end + 1 : NULL;
+    }
+    return 0;
+}
+
+int keymap_spec_append(char *spec, size_t capacity, const char *name, unsigned value)
+{
+    size_t used = strlen(spec);
+    int written;
+    if (used >= capacity) return 0;
+    written = snprintf(spec + used, capacity - used, "%s%s:%X",
+                           used ? "," : "", name, value);
+    if (written < 0 || (size_t)written >= capacity - used) {
+        spec[used] = 0;
+        return 0;
+    }
+    return 1;
+}
diff --git a/src/input/keymap_spec.h b/src/input/keymap_spec.h
new file mode 100644
index 00000000..3f6a489c
--- /dev/null
+++ b/src/input/keymap_spec.h
@@ -0,0 +1,25 @@
+/* The RECOMP_KEYMAP setting format: a comma-separated list of NAME:HEX entries,
+ * each name a key and each value the key's virtual-key code in hex. Names
+ * match whole entries only, so LX- never matches inside RLX-. */
+#ifndef INPUT_KEYMAP_SPEC_H
+#define INPUT_KEYMAP_SPEC_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Reads NAME's value from spec into value and returns 1; returns 0 when the
+ * spec has no entry for NAME. */
