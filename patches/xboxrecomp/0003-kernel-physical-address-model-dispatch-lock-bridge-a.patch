+    closed = CloseHandle(handle);
+    error = GetLastError();
+    if (closed) {
+        for (link = &s_file_diag_opens; *link; link = &(*link)->next) {
+            if ((*link)->handle != handle) continue;
+            entry = *link;
+            *link = entry->next;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_file_diag_lock);
+    free(entry);
+    SetLastError(error);
+    return closed;
+}
