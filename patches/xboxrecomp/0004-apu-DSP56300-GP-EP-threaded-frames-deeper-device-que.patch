+#define BITMASK(x)  ((1<<(x))-1)
+
+#define TRACE_DSP_DISASM 0
+#define TRACE_DSP_DISASM_REG 0
+#define TRACE_DSP_DISASM_MEM 0
+
+// #define DSP_COUNT_IPS     /* Count instruction per seconds */
+
+
+/**********************************
+ *  Defines
+ **********************************/
+
+#define SIGN_PLUS  0
+#define SIGN_MINUS 1
+
+/* The checked instruction fetch is hot even with automatic inlining enabled.
+ * Preserve its assertions and Debug call boundary; only optimized MSVC builds
+ * need an explicit request to inline this helper. */
+#if defined(_MSC_VER) && !defined(_DEBUG)
+#define DSP_PREAD_INLINE __forceinline
+#else
+#define DSP_PREAD_INLINE
+#endif
+
+/**********************************
+ *  Functions
+ **********************************/
+
+static void dsp_postexecute_update_pc(dsp_core_t* dsp);
+static void dsp_postexecute_interrupts(dsp_core_t* dsp);
+
+static inline void dsp_postexecute_interrupts_if_needed(dsp_core_t* dsp)
+{
+    /* With no pending interrupt or active pipeline, the full handler only
+     * returns. Keep pipeline progression even after its pending count clears. */
+    if (dsp->interrupt_counter || dsp->interrupt_state == DSP_INTERRUPT_DISABLED)
+        dsp_postexecute_interrupts(dsp);
+}
+
+static DSP_PREAD_INLINE uint32_t read_memory_p(dsp_core_t* dsp, uint32_t address);
+static uint32_t read_memory_disasm(dsp_core_t* dsp, int space, uint32_t address);
+
+static void write_memory_raw(dsp_core_t* dsp, int space, uint32_t address, uint32_t value);
+static void write_memory_disasm(dsp_core_t* dsp, int space, uint32_t address, uint32_t value);
+
+static void dsp_write_reg_slow(dsp_core_t* dsp, uint32_t numreg, uint32_t value);
+
+/* X0-Y1 and A/B outside SA mode and the address registers are most writes:
+ * the slow path's default and accumulator cases, without its register switch. */
+static DSP_PREAD_INLINE void dsp_write_reg(dsp_core_t* dsp, uint32_t numreg, uint32_t value)
+{
+    if (!(dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SA))) {
+        if (numreg >= DSP_REG_X0 && numreg <= DSP_REG_Y1) {
+            dsp->registers[numreg] = value & BITMASK(24);
+            return;
+        }
+        if (numreg == DSP_REG_A || numreg == DSP_REG_B) {
+            unsigned r = numreg - DSP_REG_A;
+            dsp->registers[DSP_REG_A0 + r] = 0;
+            dsp->registers[DSP_REG_A1 + r] = value;
+            dsp->registers[DSP_REG_A2 + r] = value & (1<<23) ? 0xff : 0x0;
+            return;
+        }
+    }
+    if (numreg >= DSP_REG_R0 && numreg <= DSP_REG_M7) {    /* dsp_register_mask */
+        dsp->registers[numreg] = value & ((dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC)) ? 0xffff : 0xffffff);
+        return;
+    }
+    dsp_write_reg_slow(dsp, numreg, value);
+}
+
+static void dsp_stack_push(dsp_core_t* dsp, uint32_t curpc, uint32_t cursr, uint16_t sshOnly);
+static void dsp_stack_pop(dsp_core_t* dsp, uint32_t *curpc, uint32_t *cursr);
+static void dsp_compute_ssh_ssl(dsp_core_t* dsp);
+static void dsp_stack_spill(dsp_core_t* dsp);
+static void dsp_stack_refill(dsp_core_t* dsp);
+
+/* 56bits arithmetic */
+static uint16_t dsp_abs56(uint32_t *dest);
+static uint16_t dsp_asl56(uint32_t *dest, int n);
+static uint16_t dsp_asr56(uint32_t *dest, int n);
+static uint16_t dsp_add56(uint32_t *source, uint32_t *dest);
+static uint16_t dsp_sub56(uint32_t *source, uint32_t *dest);
+static void dsp_mul56(uint32_t source1, uint32_t source2, uint32_t *dest, uint8_t signe);
+static void dsp_rnd56(dsp_core_t* dsp, uint32_t *dest);
+static uint32_t dsp_signextend(int bits, uint32_t v);
+
+/* Vector addresses per DSP56300FM Table 2-2, indexed by DSP_INTER_* */
+static const dsp_interrupt_t dsp_interrupt[4] = {
+    { DSP_INTER_RESET, 0x00, 0, "Reset" },
+    { DSP_INTER_ILLEGAL, 0x04, 0, "Illegal" },
+    { DSP_INTER_STACK_ERROR, 0x02, 0, "Stack Error" },
+    { DSP_INTER_TRAP, 0x08, 0, "Trap" },
+};
+
+static const int registers_tcc[16][2] = {
+    {DSP_REG_B,DSP_REG_A},
+    {DSP_REG_A,DSP_REG_B},
+    {DSP_REG_NULL,DSP_REG_NULL},
+    {DSP_REG_NULL,DSP_REG_NULL},
+
+    {DSP_REG_NULL,DSP_REG_NULL},
+    {DSP_REG_NULL,DSP_REG_NULL},
+    {DSP_REG_NULL,DSP_REG_NULL},
+    {DSP_REG_NULL,DSP_REG_NULL},
+
+    {DSP_REG_X0,DSP_REG_A},
+    {DSP_REG_X0,DSP_REG_B},
+    {DSP_REG_Y0,DSP_REG_A},
+    {DSP_REG_Y0,DSP_REG_B},
+
+    {DSP_REG_X1,DSP_REG_A},
+    {DSP_REG_X1,DSP_REG_B},
+    {DSP_REG_Y1,DSP_REG_A},
+    {DSP_REG_Y1,DSP_REG_B}
+};
+
+static const int registers_mask[64] = {
+    0, 0, 0, 0,
+    24, 24, 24, 24,
+    24, 24, 8, 8,
+    24, 24, 24, 24,
+
+    16, 16, 16, 16,
+    16, 16, 16, 16,
+    16, 16, 16, 16,
+    16, 16, 16, 16,
+
+    16, 16, 16, 16,
+    16, 16, 16, 16,
+    0, 0, 24, 0,
+    0, 0, 0, 0,
+
+    24, 5, 0, 0,
+    0, 0, 0, 0,
+    24, 24, 24, 6,
+    24, 24, 16, 16
+};
+
+static uint32_t dsp_register_mask(dsp_core_t* dsp, unsigned reg)
+{
+    if ((reg >= DSP_REG_R0 && reg <= DSP_REG_M7) || reg == DSP_REG_LA || reg == DSP_REG_LC || reg == DSP_REG_VBA || reg == DSP_REG_EP || reg == DSP_REG_SZ || reg == DSP_REG_SSH || reg == DSP_REG_SSL)
+        return (dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC)) ? 0xffff : 0xffffff;
+    if (reg == DSP_REG_SP && (dsp->registers[DSP_REG_OMR] & (1u << DSP_OMR_SEN)))
+        return (dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC)) ? 0xffff : 0xffffff;
+    return BITMASK(registers_mask[reg]);
+}
+
+static uint32_t dsp_move_source(dsp_core_t* dsp, unsigned reg)
+{
+    uint32_t value = dsp->registers[reg];
+    if ((dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SA)) &&
+        (reg == DSP_REG_A2 || reg == DSP_REG_B2))
+        return (value & 0x80) ? (value & 0xff) | 0xffff00 : value & 0xff;
+    if ((dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SA)) &&
+        reg >= DSP_REG_X0 && reg <= DSP_REG_B1 && reg != DSP_REG_A2 && reg != DSP_REG_B2)
+        return (value >> 8) & 0xffff;
+    if ((reg == DSP_REG_SR || reg == DSP_REG_OMR) &&
+        (dsp->registers[DSP_REG_SR] & (1u << DSP_SR_SC))) return value & 0xffff;
+    return (reg >= DSP_REG_R0 && reg <= DSP_REG_M7) || reg == DSP_REG_LA || reg == DSP_REG_LC || reg == DSP_REG_VBA || reg == DSP_REG_EP || reg == DSP_REG_SZ || reg == DSP_REG_SSH || reg == DSP_REG_SSL || reg == DSP_REG_SP ?
+           value & dsp_register_mask(dsp, reg) : value;
+}
+
+/* Interpreter data accesses: X RAM below 0xc00, the two mixbuffer windows and
+ * Y RAM are plain arrays (no peripheral or SC window decoding); nearly every
+ * access lands there. Anything else takes the full path. */
+static DSP_PREAD_INLINE uint32_t dsp_read_xy(dsp_core_t* dsp, int space, uint32_t address)
+{
+    if (space == DSP_SPACE_X && address < 0xc00) return dsp->xram[address];
+    if (space == DSP_SPACE_X && address < 0xc00 + DSP_MIXBUFFER_SIZE) return dsp->mixbuffer[address - 0xc00];
+    if (space == DSP_SPACE_X && address - DSP_MIXBUFFER_BASE < DSP_MIXBUFFER_SIZE) return dsp->mixbuffer[address - DSP_MIXBUFFER_BASE];
+    if (space == DSP_SPACE_Y && address < DSP_YRAM_SIZE) return dsp->yram[address];
+    return dsp56k_read_memory(dsp, space, address);
+}
+
+static DSP_PREAD_INLINE void dsp_write_xy(dsp_core_t* dsp, int space, uint32_t address, uint32_t value)
+{
+    assert((value & 0xFF000000) == 0);
+    if (!TRACE_DSP_DISASM_MEM && space == DSP_SPACE_X && address < 0xc00) dsp->xram[address] = value;
+    else if (!TRACE_DSP_DISASM_MEM && space == DSP_SPACE_X && address - DSP_MIXBUFFER_BASE < DSP_MIXBUFFER_SIZE) dsp->mixbuffer[address - DSP_MIXBUFFER_BASE] = value;
+    else if (!TRACE_DSP_DISASM_MEM && space == DSP_SPACE_Y && address < DSP_YRAM_SIZE) dsp->yram[address] = value;
+    else dsp56k_write_memory(dsp, space, address, value);
+}
+
+
+#include "dsp_emu.c.inc"
+#include "dsp_dis.c.inc"
+
+typedef bool (*match_func_t)(uint32_t op);
+
+typedef struct OpcodeEntry {
+    const char* template;
+    const char* name;
+    dis_func_t dis_func;
+    emu_func_t emu_func;
+    match_func_t match_func;
+} OpcodeEntry;
+
+static bool match_MMMRRR(uint32_t op)
+{
+    uint32_t RRR = (op >> 8) & BITMASK(3);
+    uint32_t MMM = (op >> 11) & BITMASK(3);
+    if (MMM == 0x6) {
+        return RRR == 0x0 || RRR == 0x4;
+    }
+    return true;
+}
+
+static bool match_indirect_MMMRRR(uint32_t op)
+{
+    /* Bit control-transfer forms have a target/displacement extension, and
+     * admit indirect EA modes only. MMM=6 overlaps long-offset MOVE. */
+    return ((op >> 11) & BITMASK(3)) != 6;
+}
+
