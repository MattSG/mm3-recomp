+        /* Read S */
+        strcpy(srcname, registers_name[numreg]);
+        sprintf(dstname, "p:%s", addr_name);
+    }
+
+    sprintf(dsp->disasm_str_instr,"movem %s,%s", srcname, dstname);
+}
