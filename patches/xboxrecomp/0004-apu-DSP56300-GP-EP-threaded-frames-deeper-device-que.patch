+/* The queue is per process and an APU can be brought up more than once, so
+ * the lock is made once, on first use, not by each mcpx_apu_vp_init. */
+static QemuMutex *fe_lock(void)
+{
+    static volatile LONG state;   /* 0 none, 1 being made, 2 ready */
+    if (state != 2) {
+        if (InterlockedCompareExchange(&state, 1, 0) == 0) {
+            qemu_mutex_init(&s_fe_lock_storage);
+            InterlockedExchange(&state, 2);
+        } else {
+            while (state != 2)
+                Sleep(0);
+        }
+    }
+    return &s_fe_lock_storage;
