+        /* Write D1 */
+        if (retour) {
+            sprintf(srcname, "#%s", addr_name);
+        } else {
+            sprintf(srcname, "%s:%s", spacename, addr_name);
+        }
+        strcpy(dstname, registers_name[numreg]);
+    } else {
+        /* Read S1 */
+        strcpy(srcname, registers_name[numreg]);
