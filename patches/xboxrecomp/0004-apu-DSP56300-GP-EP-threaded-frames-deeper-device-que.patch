+    /* S1,x:aa */
+    /* y:aa,D1 */
+    /* S1,y:aa */
+
+    numreg = dsp->disasm_cur_inst & BITMASK(6);
+    addr = (dsp->disasm_cur_inst>>8) & BITMASK(6);
