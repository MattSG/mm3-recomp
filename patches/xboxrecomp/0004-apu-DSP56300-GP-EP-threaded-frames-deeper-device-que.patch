+                (unsigned long long)addr);
+    else if (n == 9)
+        fprintf(stderr, "[APU] further unmapped physical accesses refused (counting only)\n");
+    memset(s_unmapped_page, 0, sizeof s_unmapped_page);
+    return s_unmapped_page;
