+    "a10",
+    "b10",
+    "x",
+    "y",
+    "a",
+    "b",
+    "ab",
+    "ba"
+};
+
+static const char *ea_names[9] = {
+    "(r%d)-n%d",    /* 000xxx */
+    "(r%d)+n%d",    /* 001xxx */
+    "(r%d)-",       /* 010xxx */
+    "(r%d)+",       /* 011xxx */
+    "(r%d)",        /* 100xxx */
+    "(r%d+n%d)",    /* 101xxx */
+    "$%04x",        /* 110000 */
+    "-(r%d)",       /* 111xxx */
+    "$%06x"     /* 110100 */
+};
+
+static const char *cc_name[16] = {
+    "cc",
+    "ge",
+    "ne",
+    "pl",
+    "nn",
+    "ec",
+    "lc",
+    "gt",
+
