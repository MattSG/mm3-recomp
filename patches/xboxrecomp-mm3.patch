diff --git a/src/kernel/nv2a_notify_wait.h b/src/kernel/nv2a_notify_wait.h
new file mode 100644
index 0000000..b853df4
--- /dev/null
+++ b/src/kernel/nv2a_notify_wait.h
@@ -0,0 +1,126 @@
+/* Host waiting only: guest GET/NOP/stop values remain the completion rules. */
+#ifndef XBOX_NV2A_NOTIFY_WAIT_H
+#define XBOX_NV2A_NOTIFY_WAIT_H
+
+#include "platform/xbox_winnt.h"
+#include <stdint.h>
+
+typedef struct {
+    volatile LONG generation;
+#ifdef _WIN32
+    BOOL (WINAPI *wait_address)(volatile VOID *, PVOID, SIZE_T, DWORD);
+    VOID (WINAPI *wake_all)(PVOID);
+#endif
+} XBOX_NV2A_WAKE;
+
+static void xbox_nv2a_wake_init(XBOX_NV2A_WAKE *wake)
+{
+    wake->generation = 0;
+#ifdef _WIN32
+    /* Resolve together so older hosts retain their existing yield fallback.
+     * No new library dependency is required by applications using the runtime. */
+    HMODULE module = GetModuleHandleW(L"kernelbase.dll");
+    if (!module) module = GetModuleHandleW(L"kernel32.dll");
+    wake->wait_address = module ? (BOOL (WINAPI *)(volatile VOID *, PVOID, SIZE_T, DWORD))
+        GetProcAddress(module, "WaitOnAddress") : NULL;
+    wake->wake_all = module ? (VOID (WINAPI *)(PVOID))
+        GetProcAddress(module, "WakeByAddressAll") : NULL;
+    if (!wake->wake_all) wake->wait_address = NULL;
+#endif
+}
+
+static LONG xbox_nv2a_wake_snapshot(XBOX_NV2A_WAKE *wake)
+{
+    return InterlockedCompareExchange(&wake->generation, 0, 0);
+}
+
+static void xbox_nv2a_wake_publish(XBOX_NV2A_WAKE *wake)
+{
+    /* Publish after the corresponding guest-visible completion stores. */
+    InterlockedIncrement(&wake->generation);
+#ifdef _WIN32
+    if (wake->wait_address) wake->wake_all((PVOID)&wake->generation);
+#endif
+}
+
+static BOOL xbox_nv2a_wake_wait(XBOX_NV2A_WAKE *wake, LONG observed)
+{
+#ifdef _WIN32
+    if (wake->wait_address)
+        return wake->wait_address(&wake->generation, &observed, sizeof observed, 1);
+#else
+    (void)wake; (void)observed;
+#endif
+    SwitchToThread();
+    return TRUE;
+}
+
+static int xbox_nv2a_notify_pending(volatile uint32_t *get,
+    volatile uint32_t *put, volatile LONG *notifications, LONG notified,
+    volatile LONG *stop)
+{
+    return *get != *put && *notifications == notified &&
+           !InterlockedCompareExchange(stop, 0, 0);
+}
+
+static void xbox_nv2a_notify_wait(XBOX_NV2A_WAKE *wake,
+    volatile uint32_t *get, volatile uint32_t *put,
+    volatile LONG *notifications, LONG notified, volatile LONG *stop)
+{
+    unsigned spins = 0;
+    while (xbox_nv2a_notify_pending(get, put, notifications, notified, stop)) {
+#ifdef _WIN32
+        /* Short completions avoid a host wait. Prolonged waits, including
+         * vblank pacing in the executor, release the guest thread's core. */
+        if (++spins & 63) {
+            YieldProcessor();
+            continue;
+        }
+#else
+        (void)spins;
+#endif
+        LONG observed = xbox_nv2a_wake_snapshot(wake);
+        /* Snapshot BEFORE this predicate check. A completion between the
+         * check and WaitOnAddress changes generation, so waiting on the old
+         * value returns immediately even if its wake already happened. */
+        if (!xbox_nv2a_notify_pending(get, put, notifications, notified, stop))
+            break;
+        /* The one-millisecond fallback also notices guest-origin register
+         * writes that do not pass through the executor's publishers. */
+        xbox_nv2a_wake_wait(wake, observed);
+    }
+}
+
+/* Exact unsigned distance test from the guest's direct fence polling loop.
+ * In particular, a completed value ahead of submitted wraps the distance;
+ * treating it as a signed number would change the guest's branch. */
+static int xbox_nv2a_fence_pending(volatile uint32_t *completed,
+    uint32_t submitted, uint32_t allowed_distance)
+{
+    return allowed_distance < (uint32_t)(submitted - *completed);
+}
+
+static void xbox_nv2a_fence_wait(XBOX_NV2A_WAKE *wake,
+    volatile uint32_t *completed, uint32_t submitted, uint32_t allowed_distance,
+    volatile LONG *stop)
+{
+    unsigned spins = 0;
+    while (xbox_nv2a_fence_pending(completed, submitted, allowed_distance) &&
+           !InterlockedCompareExchange(stop, 0, 0)) {
+#ifdef _WIN32
+        if (++spins & 63) {
+            YieldProcessor();
+            continue;
+        }
+#else
+        (void)spins;
+#endif
+        LONG observed = xbox_nv2a_wake_snapshot(wake);
+        if (!xbox_nv2a_fence_pending(completed, submitted, allowed_distance) ||
+            InterlockedCompareExchange(stop, 0, 0))
+            break;
+        xbox_nv2a_wake_wait(wake, observed);
+    }
+}
+
+#endif
diff --git a/src/video/nv2a_pacing.h b/src/video/nv2a_pacing.h
new file mode 100644
index 0000000..bd286fb
--- /dev/null
+++ b/src/video/nv2a_pacing.h
@@ -0,0 +1,104 @@
+/* Display pacing is owned by the render thread. Keep the successful wait's
+ * one-millisecond spin tail and late-frame cadence; timer failures must not
+ * turn the entire remaining frame into a busy spin. */
+#ifndef NV2A_PACING_H
+#define NV2A_PACING_H
+
+#include <windows.h>
+#include <stdint.h>
+#include <limits.h>
+
+static int nv_pacing_deadline(int64_t *next, int64_t now, int64_t frequency, int limit)
+{
+    int64_t period;
+    if (limit <= 0 || frequency <= 0) return 0;
+    period = frequency / limit;
+    /* A zero period cannot pace. Rebase rather than overflow signed QPC
+     * arithmetic; valid timestamps follow the original deadline calculation. */
+    if (period <= 0 || now < 0 || *next < 0 || *next > INT64_MAX - period) {
+        *next = now;
+        return 0;
+    }
+    *next += period;
+    if (!*next || *next <= now) {
+        *next = now;
+        return 0;
+    }
+    return 1;
+}
+
+static HANDLE nv_pacing_create_timer(void)
+{
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                         TIMER_ALL_ACCESS);
+    if (!timer) timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    return timer;
+}
+
+/* Convert QPC ticks to relative 100 ns units. The ordinary path is exactly
+ * the original integer conversion. Binary division handles only products
+ * that would overflow it, without changing the deadline or using floats. */
+static int64_t nv_pacing_timer_units(int64_t ticks, int64_t frequency)
+{
+    const uint64_t scale = 10000000;
+    uint64_t t = (uint64_t)ticks, f = (uint64_t)frequency, units;
+    if (ticks <= 0 || frequency <= 0) return 1;
+    if (t <= INT64_MAX / scale) {
+        units = t * scale / f;
+    } else {
+        uint64_t whole = t / f, a = t % f, remainder = 0, fraction = 0;
+        int bit;
+        for (bit = 23; bit >= 0; bit--) {
+            fraction *= 2;
+            if (remainder >= f - remainder) {
+                remainder -= f - remainder;
+                fraction++;
+            } else remainder *= 2;
+            if ((scale >> bit) & 1) {
+                if (remainder >= f - a) {
+                    remainder -= f - a;
+                    fraction++;
+                } else remainder += a;
+            }
+        }
+        if (whole > (INT64_MAX - fraction) / scale) return INT64_MAX;
+        units = whole * scale + fraction;
+    }
+    /* Zero would be an absolute date, rather than a future relative wait. */
+    return units ? (int64_t)units : 1;
+}
+
+static int64_t nv_pacing_qpc(void)
+{
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    return now.QuadPart;
+}
+
+static void nv_pacing_wait(HANDLE timer, int64_t frequency, int64_t deadline, int64_t now)
+{
+    int64_t remain = deadline - now;
+    int64_t spin = frequency / 1000;
+    if (remain > spin) {
+        int waited = 0;
+        if (timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -nv_pacing_timer_units(remain - spin, frequency);
+            if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+                waited = WaitForSingleObject(timer, INFINITE) == WAIT_OBJECT_0;
+        }
+        if (!waited) {
+            /* Request at most one ms at a time and recheck QPC: Sleep and
+             * ordinary timers can wake late on a coarse-resolution system.
+             * Failure never makes us spin longer than the original tail. */
+            now = nv_pacing_qpc();
+            while (now < deadline && deadline - now > spin) {
+                Sleep(1);
+                now = nv_pacing_qpc();
+            }
+        }
+    }
+    while (nv_pacing_qpc() < deadline) YieldProcessor();
+}
+
+#endif
