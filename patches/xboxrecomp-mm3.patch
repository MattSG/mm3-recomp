+static uint32_t nv_ps_get32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void nv_ps_put32(uint8_t *p, uint32_t v)
+{
+    unsigned i;
+    for (i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i));
+}
+
+static int nv_ps_manifest_path(const uint8_t family[32], wchar_t path[NV_SHADER_CACHE_PATH])
+{
+    if (!nv_shader_cache_path(family, path)) return 0;
+    wcscpy_s(path + wcslen(path) - 4, 5, L".psm");
+    return 1;
+}
+
+static int nv_ps_manifest_read(const wchar_t *path, const uint8_t family[32],
+                              uint32_t records[NV_PS_MANIFEST_LIMIT][NV_PS_MANIFEST_WORDS],
+                              unsigned *count)
+{
+    uint8_t header[NV_PS_MANIFEST_HEADER], checksum[32];
+    uint8_t payload[NV_PS_MANIFEST_LIMIT * NV_PS_MANIFEST_WORDS * 4];
+    NvShaderHash hash;
+    LARGE_INTEGER size;
+    DWORD read, bytes;
+    unsigned n, i, j;
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                             NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    int ok = 0;
+    *count = 0;
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    if (!GetFileSizeEx(file, &size) ||
+        !ReadFile(file, header, sizeof header, &read, NULL) || read != sizeof header ||
+        memcmp(header, "NVPSMAN1", 8) || nv_ps_get32(header + 8) != NV_PS_MANIFEST_SCHEMA ||
+        nv_ps_get32(header + 12) != NV_PS_MANIFEST_WORDS * 4 ||
+        nv_ps_get32(header + 20) != 0 || memcmp(header + 24, family, 32)) goto done;
+    n = nv_ps_get32(header + 16);
+    if (n > NV_PS_MANIFEST_LIMIT) goto done;
+    bytes = n * NV_PS_MANIFEST_WORDS * 4;
+    if (size.QuadPart != (LONGLONG)sizeof header + bytes ||
+        !ReadFile(file, payload, bytes, &read, NULL) || read != bytes) goto done;
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, payload, bytes);
+    nv_shader_hash_finish(&hash, checksum);
+    if (memcmp(header + 56, checksum, 32)) goto done;
+    /* Decode only after validating the complete file; never partially import. */
+    for (i = 0; i < n; i++) for (j = 0; j < NV_PS_MANIFEST_WORDS; j++)
+        records[i][j] = nv_ps_get32(payload + (i * NV_PS_MANIFEST_WORDS + j) * 4);
+    *count = n;
+    ok = 1;
+done:
+    CloseHandle(file);
+    return ok;
+}
+
+static int nv_ps_manifest_write(const wchar_t *path, const uint8_t family[32],
+                               const uint32_t records[][NV_PS_MANIFEST_WORDS], unsigned count)
+{
+    static volatile LONG serial;
+    uint8_t header[NV_PS_MANIFEST_HEADER] = {0};
+    uint8_t payload[NV_PS_MANIFEST_LIMIT * NV_PS_MANIFEST_WORDS * 4];
+    wchar_t temporary[NV_SHADER_CACHE_PATH], dir[NV_SHADER_CACHE_PATH];
+    NvShaderHash hash;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    DWORD wrote, bytes;
+    unsigned i, j;
+    int ok;
+    if (count > NV_PS_MANIFEST_LIMIT) return 0;
+    bytes = count * NV_PS_MANIFEST_WORDS * 4;
+    for (i = 0; i < count; i++) for (j = 0; j < NV_PS_MANIFEST_WORDS; j++)
+        nv_ps_put32(payload + (i * NV_PS_MANIFEST_WORDS + j) * 4, records[i][j]);
+    memcpy(header, "NVPSMAN1", 8);
+    nv_ps_put32(header + 8, NV_PS_MANIFEST_SCHEMA);
+    nv_ps_put32(header + 12, NV_PS_MANIFEST_WORDS * 4);
+    nv_ps_put32(header + 16, count);
+    memcpy(header + 24, family, 32);
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, payload, bytes);
+    nv_shader_hash_finish(&hash, header + 56);
+    wcscpy_s(dir, NV_SHADER_CACHE_PATH, path);
+    *wcsrchr(dir, L'\\') = 0;
+    for (i = 3; dir[i]; i++) if (dir[i] == L'\\' || dir[i] == L'/') {
+        wchar_t slash = dir[i]; dir[i] = 0;
+        CreateDirectoryW(dir, NULL); dir[i] = slash;
+    }
+    if (!CreateDirectoryW(dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return 0;
+    for (i = 0; i < 4 && file == INVALID_HANDLE_VALUE; i++) {
+        if (swprintf_s(temporary, NV_SHADER_CACHE_PATH, L"%s.%lu.%lu.%lu.tmp", path,
+                       GetCurrentProcessId(), GetCurrentThreadId(),
+                       (unsigned long)InterlockedIncrement(&serial)) < 0) return 0;
+        file = CreateFileW(temporary, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_EXISTS) return 0;
+    }
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    ok = WriteFile(file, header, sizeof header, &wrote, NULL) && wrote == sizeof header;
+    if (ok) ok = WriteFile(file, payload, bytes, &wrote, NULL) && wrote == bytes;
+    CloseHandle(file);
+    if (ok) ok = MoveFileExW(temporary, path, MOVEFILE_REPLACE_EXISTING) != 0;
+    if (!ok) DeleteFileW(temporary);
+    return ok;
+}
+
+#endif
diff --git a/src/video/nv2a_shader_cache.h b/src/video/nv2a_shader_cache.h
new file mode 100644
index 0000000..f833590
--- /dev/null
+++ b/src/video/nv2a_shader_cache.h
@@ -0,0 +1,272 @@
+/* Persistent D3DCompile bytecode. Cache failures always fall back to compiling;
+ * specialised shaders call this on their existing compiler worker threads. */
+#ifndef NV2A_SHADER_CACHE_H
+#define NV2A_SHADER_CACHE_H
+
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#define NV_SHADER_CACHE_SCHEMA 1u
+#define NV_SHADER_CACHE_MAX_CODE (16u * 1024u * 1024u)
+#define NV_SHADER_CACHE_PATH 1040
+
+/* SHA-256 keeps the filename and the bytecode checksum independent of runtime
+ * addresses, compiler struct padding, and ambiguous macro concatenations. */
+typedef struct {
+    uint32_t h[8];
+    uint64_t bytes;
+    unsigned used;
+    uint8_t block[64];
+} NvShaderHash;
+
+static uint32_t nv_shader_ror(uint32_t x, unsigned n)
+{
+    return (x >> n) | (x << (32 - n));
+}
+
+static void nv_shader_hash_block(NvShaderHash *s, const uint8_t *p)
+{
+    static const uint32_t k[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+    };
+    uint32_t w[64], a,b,c,d,e,f,g,h;
+    unsigned i;
+    for (i = 0; i < 16; i++)
+        w[i] = (uint32_t)p[i*4] << 24 | (uint32_t)p[i*4+1] << 16 |
+               (uint32_t)p[i*4+2] << 8 | p[i*4+3];
+    for (; i < 64; i++) {
+        uint32_t x = w[i-15], y = w[i-2];
+        w[i] = w[i-16] + (nv_shader_ror(x,7) ^ nv_shader_ror(x,18) ^ (x >> 3)) +
+               w[i-7] + (nv_shader_ror(y,17) ^ nv_shader_ror(y,19) ^ (y >> 10));
+    }
+    a=s->h[0]; b=s->h[1]; c=s->h[2]; d=s->h[3];
+    e=s->h[4]; f=s->h[5]; g=s->h[6]; h=s->h[7];
+    for (i = 0; i < 64; i++) {
+        uint32_t t1 = h + (nv_shader_ror(e,6) ^ nv_shader_ror(e,11) ^ nv_shader_ror(e,25)) +
+                      ((e & f) ^ (~e & g)) + k[i] + w[i];
+        uint32_t t2 = (nv_shader_ror(a,2) ^ nv_shader_ror(a,13) ^ nv_shader_ror(a,22)) +
+                      ((a & b) ^ (a & c) ^ (b & c));
+        h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    s->h[0]+=a; s->h[1]+=b; s->h[2]+=c; s->h[3]+=d;
+    s->h[4]+=e; s->h[5]+=f; s->h[6]+=g; s->h[7]+=h;
+}
+
+static void nv_shader_hash_init(NvShaderHash *s)
+{
+    static const uint32_t initial[8] = {
+        0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
+    };
+    memset(s, 0, sizeof *s);
+    memcpy(s->h, initial, sizeof initial);
+}
+
+static void nv_shader_hash_add(NvShaderHash *s, const void *data, size_t size)
+{
+    const uint8_t *p = (const uint8_t *)data;
+    s->bytes += size;
+    while (size) {
+        size_t n = 64 - s->used;
+        if (n > size) n = size;
+        memcpy(s->block + s->used, p, n);
+        s->used += (unsigned)n; p += n; size -= n;
+        if (s->used == 64) {
+            nv_shader_hash_block(s, s->block);
+            s->used = 0;
+        }
+    }
+}
+
+static void nv_shader_hash_finish(NvShaderHash *s, uint8_t out[32])
+{
+    uint64_t bits = s->bytes * 8;
+    uint8_t tail[72] = {0x80};
+    unsigned i, n = s->used < 56 ? 56 - s->used : 120 - s->used;
+    for (i = 0; i < 8; i++) tail[n+i] = (uint8_t)(bits >> (56-i*8));
+    nv_shader_hash_add(s, tail, n+8);
+    for (i = 0; i < 32; i++) out[i] = (uint8_t)(s->h[i/4] >> (24-(i%4)*8));
+}
+
+static void nv_shader_hash_number(NvShaderHash *s, uint64_t value)
+{
+    uint8_t bytes[8];
+    unsigned i;
+    for (i = 0; i < 8; i++) bytes[i] = (uint8_t)(value >> (i*8));
+    nv_shader_hash_add(s, bytes, sizeof bytes);
+}
+
+static void nv_shader_hash_string(NvShaderHash *s, const char *text)
+{
+    size_t n = text ? strlen(text) : 0;
+    nv_shader_hash_number(s, text ? n : UINT64_MAX);
+    if (n) nv_shader_hash_add(s, text, n);
+}
+
+static void nv_shader_cache_key(const void *source, size_t size, const char *name,
+                               const D3D_SHADER_MACRO *macros, const char *entry,
+                               const char *target, UINT flags1, UINT flags2,
+                               uint8_t key[32])
+{
+    NvShaderHash hash;
+    size_t i, count = 0;
+    if (macros) while (macros[count].Name) count++;
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_number(&hash, NV_SHADER_CACHE_SCHEMA);
+    nv_shader_hash_number(&hash, size);
+    nv_shader_hash_add(&hash, source, size);
+    nv_shader_hash_string(&hash, name);
+    nv_shader_hash_string(&hash, entry);
+    nv_shader_hash_string(&hash, target);
+    nv_shader_hash_number(&hash, flags1);
+    nv_shader_hash_number(&hash, flags2);
+    nv_shader_hash_number(&hash, count);
+    for (i = 0; i < count; i++) {
+        nv_shader_hash_string(&hash, macros[i].Name);
+        nv_shader_hash_string(&hash, macros[i].Definition);
+    }
+    nv_shader_hash_finish(&hash, key);
+}
+
+static int nv_shader_cache_path(const uint8_t key[32], wchar_t path[NV_SHADER_CACHE_PATH])
+{
+    wchar_t dir[NV_SHADER_CACHE_PATH], full[NV_SHADER_CACHE_PATH], enabled[8];
+    DWORD n = GetEnvironmentVariableW(L"RECOMP_SHADER_CACHE", enabled, 8);
+    size_t length;
+    unsigned i;
+    if (n == 1 && enabled[0] == L'0') return 0;
+    n = GetEnvironmentVariableW(L"RECOMP_SHADER_CACHE_DIR", dir, NV_SHADER_CACHE_PATH);
+    if (n >= NV_SHADER_CACHE_PATH) return 0;
+    if (!n) {
+        n = GetEnvironmentVariableW(L"LOCALAPPDATA", dir, NV_SHADER_CACHE_PATH);
+        if (!n || n >= NV_SHADER_CACHE_PATH - 40) return 0;
+        wcscat_s(dir, NV_SHADER_CACHE_PATH, L"\\xboxrecomp\\ShaderCache");
+    }
+    n = GetFullPathNameW(dir, NV_SHADER_CACHE_PATH, full, NULL);
+    if (!n || n >= NV_SHADER_CACHE_PATH - 80) return 0;
+    length = wcslen(full);
+    while (length && (full[length-1] == L'\\' || full[length-1] == L'/')) length--;
+    memcpy(path, full, length * sizeof *path);
+    path[length++] = L'\\';
+    for (i = 0; i < 32; i++) {
+        static const wchar_t hex[] = L"0123456789abcdef";
+        path[length++] = hex[key[i] >> 4];
+        path[length++] = hex[key[i] & 15];
+    }
+    wcscpy_s(path + length, NV_SHADER_CACHE_PATH - length, L".bin");
+    return 1;
+}
+
+typedef struct {
+    uint8_t magic[8];
+    uint32_t schema, size;
+    uint8_t key[32], checksum[32];
+} NvShaderCacheHeader;
+
+static ID3DBlob *nv_shader_cache_read(const wchar_t *path, const uint8_t key[32])
+{
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                              NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    NvShaderCacheHeader header;
+    LARGE_INTEGER length;
+    ID3DBlob *code = NULL;
+    NvShaderHash hash;
+    uint8_t checksum[32];
+    DWORD read;
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (!GetFileSizeEx(file, &length) ||
+        !ReadFile(file, &header, sizeof header, &read, NULL) || read != sizeof header ||
+        memcmp(header.magic, "NVSCACHE", 8) || header.schema != NV_SHADER_CACHE_SCHEMA ||
+        !header.size || header.size > NV_SHADER_CACHE_MAX_CODE ||
+        length.QuadPart != (LONGLONG)sizeof header + header.size ||
+        memcmp(header.key, key, 32) || FAILED(D3DCreateBlob(header.size, &code))) goto done;
+    if (!ReadFile(file, ID3D10Blob_GetBufferPointer(code), header.size, &read, NULL) ||
+        read != header.size) goto invalid;
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, ID3D10Blob_GetBufferPointer(code), header.size);
+    nv_shader_hash_finish(&hash, checksum);
+    if (memcmp(checksum, header.checksum, 32)) goto invalid;
+    goto done;
+invalid:
+    ID3D10Blob_Release(code);
+    code = NULL;
+done:
+    CloseHandle(file);
+    return code;
+}
+
+static void nv_shader_cache_write(const wchar_t *path, const uint8_t key[32], ID3DBlob *code)
+{
+    static volatile LONG serial;
+    wchar_t temporary[NV_SHADER_CACHE_PATH], dir[NV_SHADER_CACHE_PATH];
+    NvShaderCacheHeader header;
+    NvShaderHash hash;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    size_t size = ID3D10Blob_GetBufferSize(code), i;
+    DWORD wrote;
+    int ok;
+    if (!size || size > NV_SHADER_CACHE_MAX_CODE) return;
+    wcscpy_s(dir, NV_SHADER_CACHE_PATH, path);
+    *wcsrchr(dir, L'\\') = 0;
+    /* Parent creation is idempotent when several compiler workers arrive. */
+    for (i = 3; dir[i]; i++) if (dir[i] == L'\\' || dir[i] == L'/') {
+        wchar_t slash = dir[i]; dir[i] = 0;
+        CreateDirectoryW(dir, NULL); dir[i] = slash;
+    }
+    if (!CreateDirectoryW(dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return;
+    for (i = 0; i < 4 && file == INVALID_HANDLE_VALUE; i++) {
+        if (swprintf_s(temporary, NV_SHADER_CACHE_PATH, L"%s.%lu.%lu.%lu.tmp", path,
+                       GetCurrentProcessId(), GetCurrentThreadId(),
+                       (unsigned long)InterlockedIncrement(&serial)) < 0) return;
+        file = CreateFileW(temporary, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                           FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_EXISTS) return;
+    }
+    if (file == INVALID_HANDLE_VALUE) return;
+    memcpy(header.magic, "NVSCACHE", 8);
+    header.schema = NV_SHADER_CACHE_SCHEMA; header.size = (uint32_t)size;
+    memcpy(header.key, key, 32);
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, ID3D10Blob_GetBufferPointer(code), size);
+    nv_shader_hash_finish(&hash, header.checksum);
+    ok = WriteFile(file, &header, sizeof header, &wrote, NULL) && wrote == sizeof header;
+    if (ok) ok = WriteFile(file, ID3D10Blob_GetBufferPointer(code), (DWORD)size, &wrote, NULL) && wrote == size;
+    CloseHandle(file);
+    if (!ok || !MoveFileExW(temporary, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileW(temporary);
+}
+
+static HRESULT nv_shader_cache_compile(const void *source, size_t size, const char *name,
+                                      const D3D_SHADER_MACRO *macros, const char *entry,
+                                      const char *target, UINT flags1, UINT flags2,
+                                      ID3DBlob **code, ID3DBlob **errors, int *cache_hit)
+{
+    uint8_t key[32];
+    wchar_t path[NV_SHADER_CACHE_PATH];
+    int cache;
+    HRESULT hr;
+    *code = NULL;
+    if (errors) *errors = NULL;
+    if (cache_hit) *cache_hit = 0;
+    nv_shader_cache_key(source, size, name, macros, entry, target, flags1, flags2, key);
+    cache = nv_shader_cache_path(key, path);
+    if (cache && (*code = nv_shader_cache_read(path, key)) != NULL) {
+        if (cache_hit) *cache_hit = 1;
+        return S_OK;
+    }
+    hr = D3DCompile(source, size, name, macros, NULL, entry, target, flags1, flags2, code, errors);
+    if (SUCCEEDED(hr) && cache) nv_shader_cache_write(path, key, *code);
+    return hr;
+}
+
+#endif
diff --git a/src/video/nv2a_texture_hash.h b/src/video/nv2a_texture_hash.h
new file mode 100644
index 0000000..1940901
--- /dev/null
+++ b/src/video/nv2a_texture_hash.h
@@ -0,0 +1,84 @@
+/* Exact texture-content hash. Native integer lanes preserve the scalar hash;
+ * only CPU execution changes, never the amount or frequency of validation. */
+#ifndef NV2A_TEXTURE_HASH_H
+#define NV2A_TEXTURE_HASH_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+#include <intrin.h>
+#include <immintrin.h>
+#ifndef NV_HASH_CPUID
+#define NV_HASH_CPUID(result,leaf,subleaf) __cpuidex(result,leaf,subleaf)
+#endif
+#ifndef NV_HASH_XGETBV
+#define NV_HASH_XGETBV(index) _xgetbv(index)
+#endif
+static int hash_mem_cpu_native(void)
+{
+    int r[4];
+    NV_HASH_CPUID(r,0,0);
+    if(r[0]<7) return 0;
+    NV_HASH_CPUID(r,1,0);
+    /* XSAVE, OSXSAVE and AVX precede XGETBV. The OS must save XMM/YMM,
+     * opmask and both upper ZMM components, including for 256-bit EVEX. */
+    if(((uint32_t)r[2]&0x1C000000u)!=0x1C000000u) return 0;
+    if((NV_HASH_XGETBV(0)&0xE6u)!=0xE6u) return 0;
+    NV_HASH_CPUID(r,7,0);
+    /* AVX2 for the 256-bit logical shifts, AVX512F/DQ/VL for VPMULLQ. */
+    return ((uint32_t)r[1]&0x80030020u)==0x80030020u;
+}
+static volatile long s_hash_mem_native = -1;
+static int hash_mem_native_available(void)
+{
+    long available=s_hash_mem_native;
+    if(available<0) {
+        int detected=hash_mem_cpu_native();
+        _InterlockedCompareExchange(&s_hash_mem_native,detected,-1);
+        available=s_hash_mem_native;
+    }
+    return available!=0;
+}
+/* Keep feature instructions outside the generic scalar function. No global
+ * /arch option is required or used; the runtime guard owns every call here. */
+static __declspec(noinline) uint64_t hash_mem_native(const uint8_t *p,size_t n)
+{
+    __m256i lanes=_mm256_set_epi64x(0x27D4EB2F165667C5ull^n,0x165667B19E3779F9ull,
+                                   0xC2B2AE3D27D4EB4Full,0x9E3779B97F4A7C15ull);
+    __m256i prime=_mm256_set1_epi64x(0x100000001B3ull);
+    uint64_t w[4];
+    size_t i=0;
+    for(;i+32<=n;i+=32) {
+        lanes=_mm256_mullo_epi64(_mm256_xor_si256(lanes,
+                   _mm256_loadu_si256((const __m256i *)(p+i))),prime);
+        lanes=_mm256_xor_si256(lanes,_mm256_srli_epi64(lanes,31));
+    }
+    _mm256_storeu_si256((__m256i *)w,lanes);
+    for(;i<n;i++) w[0]=(w[0]^p[i])*0x100000001B3ull;
+    return w[0]^(w[1]*3)^(w[2]*5)^(w[3]*7);
+}
+#endif
+
+#ifndef NV_HASH_NATIVE_MIN
+#define NV_HASH_NATIVE_MIN 1024u
+#endif
+static uint64_t hash_mem(const uint8_t *p,size_t n)
+{
+    uint64_t a=0x9E3779B97F4A7C15ull,b=0xC2B2AE3D27D4EB4Full,
+             c=0x165667B19E3779F9ull,d=0x27D4EB2F165667C5ull^n;
+    size_t i=0;
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+    if(n>=NV_HASH_NATIVE_MIN && hash_mem_native_available()) return hash_mem_native(p,n);
+#endif
+    for(;i+32<=n;i+=32) {
+        uint64_t w[4];memcpy(w,p+i,32);
+        a=(a^w[0])*0x100000001B3ull;a^=a>>31;
+        b=(b^w[1])*0x100000001B3ull;b^=b>>31;
+        c=(c^w[2])*0x100000001B3ull;c^=c>>31;
+        d=(d^w[3])*0x100000001B3ull;d^=d>>31;
+    }
+    for(;i<n;i++) a=(a^p[i])*0x100000001B3ull;
+    return a^(b*3)^(c*5)^(d*7);
+}
+#endif
diff --git a/tests/dsp/dsp_interrupt_fastpath_test.c b/tests/dsp/dsp_interrupt_fastpath_test.c
new file mode 100644
index 0000000..f0adcc2
--- /dev/null
+++ b/tests/dsp/dsp_interrupt_fastpath_test.c
@@ -0,0 +1,59 @@
+/* Compare the instruction-boundary fast path with the unchanged full handler.
+ * Include the production source to exercise its private interrupt pipeline
+ * without exposing an extra runtime API or substituting an interrupt model. */
+#include "../../src/apu/dsp/interp/dsp_cpu.c"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "Interrupt fast-path check line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+int main(void)
+{
+    dsp_core_t *initial = calloc(1, sizeof *initial);
+    dsp_core_t *reference = malloc(sizeof *reference);
+    dsp_core_t *actual = malloc(sizeof *actual);
+    CHECK(initial && reference && actual);
+    dsp56k_reset_cpu(initial);
+    initial->pc = 0x100;
+    initial->interrupt_save_pc = 0x101;
+    initial->interrupt_instr_fetch = 8;
+    initial->interrupt_ipl_to_raise = 2;
+    initial->registers[DSP_REG_LC] = 3;
+    initial->registers[DSP_REG_LA] = 0x110;
+    /* Long-vector entry exercises stack and SR changes during the pipeline. */
+    initial->pram[8] = 0x0d0200;
+    initial->pram[9] = 0;
+
+    const unsigned pending_masks[] = {0, 1, 8, 15};
+    unsigned cases = 0;
+    for (unsigned state = DSP_INTERRUPT_NONE; state <= DSP_INTERRUPT_LONG; ++state)
+    for (unsigned pipeline = 0; pipeline <= 6; ++pipeline)
+    for (unsigned rep = 0; rep <= 2; ++rep)
+    for (unsigned flags = 0; flags < 8; ++flags)
+    for (unsigned compatibility = 0; compatibility < 2; ++compatibility)
+    for (unsigned mask = 0; mask < ARRAY_SIZE(pending_masks); ++mask) {
+        *reference = *initial;
+        reference->interrupt_state = (uint16_t)state;
+        reference->interrupt_pipeline_count = (uint16_t)pipeline;
+        reference->loop_rep = rep;
+        reference->is_stopped = (flags & 1) != 0;
+        reference->is_debugging = (flags & 2) != 0;
+        reference->is_waiting = (flags & 4) != 0;
+        reference->registers[DSP_REG_SR] =
+            (compatibility << DSP_SR_SC) | ((pipeline & 3) << DSP_SR_I0);
+        reference->interrupt_counter = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            reference->interrupt_is_pending[i] = (pending_masks[mask] >> i) & 1;
+            reference->interrupt_counter += reference->interrupt_is_pending[i];
+            reference->interrupt_ipl[i] = (int16_t)i;
+        }
+        *actual = *reference;
+        dsp_postexecute_interrupts(reference);
+        dsp_postexecute_interrupts_if_needed(actual);
+        CHECK(!memcmp(reference, actual, sizeof *actual));
+        ++cases;
+    }
+    printf("Interrupt fast path exact full-state equivalence passed: %u cases\n", cases);
+    free(initial); free(reference); free(actual);
+    return 0;
+}
diff --git a/tests/dsp/hrtf_filter_test.c b/tests/dsp/hrtf_filter_test.c
new file mode 100644
index 0000000..192774a
--- /dev/null
+++ b/tests/dsp/hrtf_filter_test.c
@@ -0,0 +1,97 @@
+/* Compare the production HRTF filter with its prior modulo-index reference.
+ * Every coefficient/history/PCM byte must match; no tolerance or reordered
+ * floating arithmetic can hide an audible behavior change. */
+#include "../../src/apu/apu_state.h"
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "HRTF check line %d: %s\n", __LINE__, #condition); exit(1); } } while (0)
+
+static void reference_process(HrtfFilter *f, float in[][2], float out[][2])
+{
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; n++) {
+        hrtf_filter_step_parameters(f);
+        for (int ch = 0; ch < 2; ch++) {
+            float *buf = f->ch[ch].buf;
+            float *coeff = f->ch[ch].hrir_coeff_cur;
+            buf[f->buf_pos] = in[n][ch];
+            float d = f->itd_cur * (ch == 0 ? +1.0f : -1.0f);
+            if (d < 0.0f) d = 0.0f;
+            int di = (int)d;
+            float dfrac = d - di;
+            float acc = 0.0f;
+            for (int k = 0; k < HRTF_NUM_TAPS; k++) {
+                int idx1 = (f->buf_pos - di - k + HRTF_BUFLEN) % HRTF_BUFLEN;
+                float s = buf[idx1];
+                if (dfrac > 0.0f) {
+                    int idx2 = (idx1 - 1 + HRTF_BUFLEN) % HRTF_BUFLEN;
+                    s = s * (1 - dfrac) + buf[idx2] * dfrac;
+                }
+                acc += coeff[k] * s;
+            }
+            out[n][ch] = acc;
+        }
+        f->buf_pos = (f->buf_pos + 1) % HRTF_BUFLEN;
+    }
+}
+
+static uint32_t random_state = 0x12345678;
+static float value(void)
+{
+    random_state = random_state * 1664525u + 1013904223u;
+    return ((int32_t)(random_state >> 8) - 0x7fffff) / 8388608.0f;
+}
+static void initialize(HrtfFilter *filter, int position, float current, float target)
+{
+    hrtf_filter_init(filter);
+    filter->buf_pos = position;
+    filter->itd_cur = current; filter->itd_tar = target;
+    for (int ch = 0; ch < 2; ++ch) {
+        for (int i = 0; i < HRTF_BUFLEN; ++i) filter->ch[ch].buf[i] = value();
+        for (int i = 0; i < HRTF_NUM_TAPS; ++i) {
+            filter->ch[ch].hrir_coeff_cur[i] = value() / 31;
+            filter->ch[ch].hrir_coeff_tar[i] = value() / 31;
+        }
+    }
+}
+static void input(float data[HRTF_SAMPLES_PER_FRAME][2], unsigned kind)
+{
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; ++n)
+        for (int ch = 0; ch < 2; ++ch)
+            data[n][ch] = kind == 0 ? 0.0f : kind == 1 ? (n == 0 ? 1.0f : 0.0f) : value();
+}
+int main(void)
+{
+    const float delays[] = {-42, -41.999f, -41.5f, -20.75f, -1.5f, -1, -0.5f,
+                            -0.0f, 0, 0.25f, 1, 1.5f, 20.5f, 41.5f, 41.999f, 42};
+    unsigned frames = 0;
+    for (int position = 0; position < HRTF_BUFLEN; ++position)
+    for (unsigned delay = 0; delay < sizeof delays / sizeof delays[0]; ++delay)
+    for (unsigned transition = 0; transition < 4; ++transition)
+    for (unsigned inplace = 0; inplace < 2; ++inplace) {
+        float target = transition == 0 ? delays[delay] : transition == 1 ? -42 : transition == 2 ? 42 : 0;
+        HrtfFilter reference, actual;
+        initialize(&reference, position, delays[delay], target); actual = reference;
+        for (unsigned frame = 0; frame < 4; ++frame) {
+            float left[HRTF_SAMPLES_PER_FRAME][2], right[HRTF_SAMPLES_PER_FRAME][2];
+            float left_out[HRTF_SAMPLES_PER_FRAME][2], right_out[HRTF_SAMPLES_PER_FRAME][2];
+            input(left, frame % 3); memcpy(right, left, sizeof left);
+            if (inplace) {
+                reference_process(&reference, left, left);
+                hrtf_filter_process(&actual, right, right);
+                CHECK(!memcmp(left, right, sizeof left));
+            } else {
+                reference_process(&reference, left, left_out);
+                hrtf_filter_process(&actual, right, right_out);
+                CHECK(!memcmp(left_out, right_out, sizeof left_out));
+                CHECK(!memcmp(left, right, sizeof left));
+            }
+            CHECK(!memcmp(&reference, &actual, sizeof reference));
+            ++frames;
+        }
+    }
+    printf("HRTF exact state/PCM equivalence passed: %u frames\n", frames);
+    return 0;
+}
diff --git a/tests/kernel_dispatch/contig_range_cache_test.c b/tests/kernel_dispatch/contig_range_cache_test.c
new file mode 100644
index 0000000..88b6e78
--- /dev/null
+++ b/tests/kernel_dispatch/contig_range_cache_test.c
@@ -0,0 +1,209 @@
+/* Exercise the production allocator and its positive DMA coverage hints.
+ * A private arena replaces only memory-layout initialization, not allocation. */
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static RECOMP_TLS unsigned lock_entries;
+static void counted_enter(CRITICAL_SECTION *lock)
+{
+    ++lock_entries;
+    EnterCriticalSection(lock);
+}
+#define EnterCriticalSection counted_enter
+#include "../../src/kernel/xbox_memory_layout.c"
+#undef EnterCriticalSection
+
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+#define CHECK(expr) do { if (!(expr)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #expr); exit(1); \
+} } while (0)
+
+static int uncached_range(uint32_t offset, uint32_t size)
+{
+    uint64_t end = (uint64_t)offset + (size ? size : 1u);
+    uint32_t begin, covered;
+    if (offset >= XBOX_CONTIG_SIZE || end > XBOX_CONTIG_SIZE)
+        return 0;
+    return contig_range_lookup(offset, end, &begin, &covered);
+}
+
+static void expect_range(uint32_t offset, uint32_t size, int result)
+{
+    CHECK(uncached_range(offset, size) == result);
+    CHECK(xbox_ContiguousRangeAllocated(offset, size) == result);
+}
+
+typedef struct {
+    HANDLE ready, proceed;
+    uint32_t positive, future;
+    unsigned first_locks, repeat_locks, miss_locks, new_locks;
+    int positive_before, positive_after, missed, found;
+} WORKER;
+
+static DWORD WINAPI check_worker(LPVOID argument)
+{
+    WORKER *w = argument;
+    lock_entries = 0;
+    w->positive_before = xbox_ContiguousRangeAllocated(w->positive, 0x3000);
+    w->first_locks = lock_entries;
+    lock_entries = 0;
+    for (unsigned i = 0; i < 1000; ++i)
+        if (!xbox_ContiguousRangeAllocated(w->positive + (i & 0xFFF), 1))
+            w->positive_before = 0;
+    w->repeat_locks = lock_entries;
+    lock_entries = 0;
+    w->missed = !xbox_ContiguousRangeAllocated(w->future, 1) &&
+                !xbox_ContiguousRangeAllocated(w->future, 1);
+    w->miss_locks = lock_entries;
+    SetEvent(w->ready);
+    WaitForSingleObject(w->proceed, INFINITE);
+    lock_entries = 0;
+    w->positive_after = xbox_ContiguousRangeAllocated(w->positive, 0x3000);
+    CHECK(lock_entries == 0);
+    w->found = xbox_ContiguousRangeAllocated(w->future, 0x1000);
+    w->new_locks = lock_entries;
+    lock_entries = 0;
+    CHECK(xbox_ContiguousRangeAllocated(w->future + 0xFFF, 0));
+    CHECK(lock_entries == 0);
+    return 0;
+}
+
+static double bench(int (*volatile query)(uint32_t, uint32_t), uint32_t offset)
+{
+    LARGE_INTEGER start, end, frequency;
+    volatile unsigned total = 0;
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&start);
+    for (unsigned i = 0; i < 200000; ++i)
+        total += query(offset + (i & 0xFFF), (i & 63) + 1);
+    QueryPerformanceCounter(&end);
+    CHECK(total == 200000);
+    return 1e9 * (double)(end.QuadPart - start.QuadPart) /
+           (double)frequency.QuadPart / 200000;
+}
+
+static int compare_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+
+int main(void)
+{
+    const size_t reservation = (size_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE;
+    uint8_t *arena = VirtualAlloc(NULL, reservation, MEM_RESERVE, PAGE_READWRITE);
+    uint32_t a, b, c, heap, fill, after_heap, split, fresh;
+    uint32_t isolated[40];
+    WORKER worker = {0};
+    HANDLE thread;
+    double cached[7], locked[7];
+    CHECK(arena);
+    CHECK(VirtualAlloc(arena + XBOX_CONTIG_BASE, XBOX_CONTIG_SIZE,
+                       MEM_COMMIT, PAGE_READWRITE));
+    CHECK(VirtualAlloc(arena + XBOX_HEAP_BASE, 0x10000,
+                       MEM_COMMIT, PAGE_READWRITE));
+    g_memory_offset = (ptrdiff_t)arena;
+    InitializeCriticalSection(&g_allocator_lock);
+    g_allocator_lock_initialized = 1;
+    SetEnvironmentVariableA("RECOMP_CONTIG_TRACE", NULL);
+
+    expect_range(0x1000, 1, 0);
+    expect_range(0, 0, 0);
+    heap = xbox_HeapAlloc(0x2000, 4096);
+    CHECK(heap == XBOX_HEAP_BASE);
+    a = xbox_ContiguousAlloc(1, 4096);
+    b = xbox_ContiguousAlloc(0x2000, 4096);
+    c = xbox_ContiguousAlloc(0x1000, 0x10000);
+    CHECK(a == XBOX_CONTIG_BASE + 0x1000);
+    CHECK(b == a + 0x1000);
+    CHECK(c == XBOX_CONTIG_BASE + 0x10000);
+    expect_range(0x1000, 0x3000, 1); /* Adjacent allocations are continuous. */
+    expect_range(0x1FFF, 0, 1);      /* Zero means one byte, including page tail. */
+    expect_range(0x3FFF, 1, 1);
+    expect_range(0x3FFF, 2, 0);
+    expect_range(0x4000, 1, 0);      /* Alignment holes do not become coverage. */
+    expect_range(0x10000, 0x1000, 1);
+    expect_range(0xFFF0, 32, 0);
+
+    /* Real heap ownership forces the next contiguous allocation to skip it. */
+    fill = xbox_ContiguousAlloc(XBOX_HEAP_BASE - (g_contig_next - XBOX_CONTIG_BASE), 4096);
+    CHECK(fill == c + 0x1000);
+    after_heap = xbox_ContiguousAlloc(0x1000, 4096);
+    CHECK(after_heap == XBOX_CONTIG_BASE + heap + 0x2000);
+    expect_range(heap - 1, 1, 1);
+    expect_range(heap, 1, 0);
+    expect_range(heap - 1, 2, 0);
+    expect_range(heap, 0x2001, 0);
+    expect_range(after_heap - XBOX_CONTIG_BASE, 0x1000, 1);
+    xbox_HeapFree(heap);
+    CHECK(xbox_HeapBlockSize(heap) == 0);
+    expect_range(heap, 0x2000, 0); /* Ordinary heap free does not change ownership. */
+
+    /* A cached union remains covered after entries coalesce and split. */
+    CHECK(xbox_ContiguousFree(a));
+    CHECK(xbox_ContiguousFree(b | 0x20000000u));
+    expect_range(0x1000, 0x3000, 1);
+    split = xbox_ContiguousAlloc(0x1000, 0x2000);
+    CHECK(split == b);
+    CHECK(xbox_ContiguousBlockSize(split) == 0x1000);
+    expect_range(0x1000, 0x3000, 1);
+    expect_range(0x3000, 0x1000, 1); /* Freed tail still backs DMA. */
+
+    /* Eviction and hash collisions must never fill the intervening gaps. */
+    for (unsigned i = 0; i < 40; ++i) {
+        isolated[i] = xbox_ContiguousAlloc(0x1000, 0x10000) - XBOX_CONTIG_BASE;
+        CHECK(isolated[i] && (isolated[i] & 0xFFFF) == 0);
+    }
+    for (unsigned round = 0; round < 3; ++round)
+        for (unsigned i = 0; i < 40; ++i) {
+            expect_range(isolated[i], 0x1000, 1);
+            expect_range(isolated[i] + 0x1000, 1, 0);
+        }
+    expect_range(a, 1, 0); /* This API accepts physical offsets, not aliases. */
+    expect_range(a | 0x20000000u, 1, 0);
+    expect_range(UINT32_MAX - 0x1000, 0x2000, 0);
+    expect_range(0x1000, UINT32_MAX, 0);
+    expect_range(XBOX_CONTIG_SIZE - 1, 2, 0);
+    expect_range(XBOX_CONTIG_SIZE, 0, 0);
+
+    worker.positive = 0x1000;
+    worker.future = ((g_contig_next + 0xFFFF) & ~0xFFFFu) - XBOX_CONTIG_BASE;
+    worker.ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    worker.proceed = CreateEventW(NULL, TRUE, FALSE, NULL);
+    CHECK(worker.ready && worker.proceed);
+    thread = CreateThread(NULL, 0, check_worker, &worker, 0, NULL);
+    CHECK(thread && WaitForSingleObject(worker.ready, 5000) == WAIT_OBJECT_0);
+    CHECK(worker.positive_before && worker.first_locks == 1);
+    CHECK(worker.repeat_locks == 0 && worker.missed && worker.miss_locks == 2);
+    CHECK(xbox_ContiguousFree(split));
+    CHECK(xbox_ContiguousAlloc(0x1000, 0x2000) == split);
+    fresh = xbox_ContiguousAlloc(0x1000, 0x10000);
+    CHECK(fresh - XBOX_CONTIG_BASE == worker.future);
+    SetEvent(worker.proceed);
+    CHECK(WaitForSingleObject(thread, 5000) == WAIT_OBJECT_0);
+    CHECK(worker.positive_after && worker.found && worker.new_locks == 1);
+    CloseHandle(thread);
+    CloseHandle(worker.ready);
+    CloseHandle(worker.proceed);
+
+    /* Informational medians exercise the actual exported query against the
+     * same exact locked lookup. No timing threshold is a regression gate. */
+    CHECK(xbox_ContiguousRangeAllocated(0x1000, 0x3000));
+    for (unsigned i = 0; i < 7; ++i) {
+        cached[i] = bench(xbox_ContiguousRangeAllocated, 0x1000);
+        locked[i] = bench(uncached_range, 0x1000);
+    }
+    qsort(cached, 7, sizeof cached[0], compare_double);
+    qsort(locked, 7, sizeof locked[0], compare_double);
+    printf("contiguous coverage cache passed; median cached=%.2f ns locked=%.2f ns\n",
+           cached[3], locked[3]);
+    DeleteCriticalSection(&g_allocator_lock);
+    CHECK(VirtualFree(arena, 0, MEM_RELEASE));
+    return 0;
+}
diff --git a/tests/kernel_dispatch/kernel_cs_test.c b/tests/kernel_dispatch/kernel_cs_test.c
new file mode 100644
index 0000000..010fbf0
--- /dev/null
+++ b/tests/kernel_dispatch/kernel_cs_test.c
@@ -0,0 +1,183 @@
+/* Permanent shadow caches must preserve native exclusion and recursion. */
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef void (*guest_fn)(void);
+extern guest_fn recomp_lookup_kernel(uint32_t);
+extern RECOMP_TLS uint32_t g_eax, g_esp;
+extern ptrdiff_t g_xbox_mem_offset;
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+#define THREADS 4
+#define COLLISIONS 40
+#define SHARED_ITERATIONS 5000
+#define COLLISION_ITERATIONS 100
+#define BENCH_ITERATIONS 100000
+static uint8_t *memory;
+static HANDLE start_event;
+static volatile LONG failed, active;
+static uint32_t shared_count, collision_count[COLLISIONS];
+static uint32_t imports[2];
+
+static PRTL_CRITICAL_SECTION guest_lock(unsigned i)
+{
+    /* Every address shares the table bucket and thread-cache bucket. */
+    return (PRTL_CRITICAL_SECTION)(memory + 0x10000 + i * 0x10000);
+}
+
+typedef struct { unsigned id, phase; } WORKER;
+static DWORD WINAPI worker(LPVOID p)
+{
+    WORKER *w = p;
+    WaitForSingleObject(start_event, INFINITE);
+    if (w->phase == 0) {
+        for (unsigned i = 0; i < SHARED_ITERATIONS; i++) {
+            PRTL_CRITICAL_SECTION lock = guest_lock(0);
+            /* The first call races lazy initialization across all workers. */
+            xbox_RtlEnterCriticalSection(lock);
+            xbox_RtlEnterCriticalSection(lock);
+            if (active) InterlockedExchange(&failed, 1);
+            active = 1;
+            shared_count++;
+            if ((i & 255) == 0) SwitchToThread();
+            active = 0;
+            xbox_RtlLeaveCriticalSection(lock);
+            xbox_RtlLeaveCriticalSection(lock);
+        }
+    } else if (w->phase == 1) {
+        for (unsigned i = 0; i < COLLISION_ITERATIONS; i++)
+            for (unsigned j = 0; j < COLLISIONS; j++) {
+                PRTL_CRITICAL_SECTION lock = guest_lock(j);
+                xbox_RtlEnterCriticalSection(lock);
+                collision_count[j]++;
+                xbox_RtlLeaveCriticalSection(lock);
+            }
+    } else {
+        /* Independent repeated locks expose table contention without a
+         * guest-lock bottleneck. Timing is informational, never a pass gate. */
+        PRTL_CRITICAL_SECTION lock = guest_lock(w->id);
+        for (unsigned i = 0; i < BENCH_ITERATIONS; i++) {
+            xbox_RtlEnterCriticalSection(lock);
+            xbox_RtlLeaveCriticalSection(lock);
+        }
+    }
+    return 0;
+}
+
+static int run_workers(unsigned phase)
+{
+    HANDLE threads[THREADS];
+    WORKER workers[THREADS];
+    ResetEvent(start_event);
+    for (unsigned i = 0; i < THREADS; i++) {
+        workers[i].id = i;
+        workers[i].phase = phase;
+        threads[i] = CreateThread(NULL, 0, worker, &workers[i], 0, NULL);
+        if (!threads[i]) abort();
+    }
+    SetEvent(start_event);
+    DWORD wait = WaitForMultipleObjects(THREADS, threads, TRUE, 30000);
+    if (wait != WAIT_OBJECT_0) {
+        fprintf(stderr, "FAIL: lock phase %u timed out\n", phase);
+        /* Worker parameters are on this stack; do not return with live users. */
+        ExitProcess(2);
+    }
+    for (unsigned i = 0; i < THREADS; i++) CloseHandle(threads[i]);
+    return !failed;
+}
+
+static uint32_t invoke(unsigned slot)
+{
+    guest_fn fn = recomp_lookup_kernel(imports[slot]);
+    uint32_t *sp;
+    if (!fn) abort();
+    g_esp = 0x700000;
+    sp = (uint32_t *)(memory + g_esp);
+    sp[0] = 0xBEEF0001;
+    sp[1] = 0x10000;
+    fn();
+    if (g_esp != 0x700008) InterlockedExchange(&failed, 1);
+    return g_eax;
+}
+
+static DWORD WINAPI probe_try(LPVOID p)
+{
+    int expected = *(int *)p;
+    uint32_t got = invoke(0);
+    if (got != (uint32_t)expected) InterlockedExchange(&failed, 1);
+    if (got) invoke(1);
+    return 0;
+}
+
+static int try_from_other_thread(int expected)
+{
+    HANDLE thread = CreateThread(NULL, 0, probe_try, &expected, 0, NULL);
+    if (!thread) return 0;
+    if (WaitForSingleObject(thread, 5000) != WAIT_OBJECT_0) ExitProcess(3);
+    CloseHandle(thread);
+    return !failed;
+}
+
+int main(int argc, char **argv)
+{
+    LARGE_INTEGER freq, begin, end;
+    PRTL_CRITICAL_SECTION lock;
+    _putenv_s("RECOMP_CS_MODE", "");
+    _putenv_s("RECOMP_CS_TRACE_CRT", "");
+    _putenv_s("RECOMP_CS_WATCH", "");
+    _putenv_s("RECOMP_CS_COUNTERS", argc > 1 && !strcmp(argv[1], "counters") ? "1" : "0");
+    _putenv_s("RECOMP_KERNEL_LOG_BUDGET", "0");
+    memory = VirtualAlloc(NULL, 16 * 1024 * 1024,
+                          MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    start_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!memory || !start_event) return 10;
+    g_xbox_mem_offset = (ptrdiff_t)memory;
+    for (unsigned i = 0; i < COLLISIONS; i++)
+        memset(guest_lock(i), 0xA5, 32);
+    imports[0] = 0x80000000u | 306; /* TryEnter */
+    imports[1] = 0x80000000u | 294; /* Leave */
+    memcpy(memory + 0x600000, imports, sizeof imports);
+    xbox_kernel_set_thunk_address(0x600000, 2);
+    xbox_kernel_bridge_init();
+    memcpy(imports, memory + 0x600000, sizeof imports);
+
+    if (!run_workers(0) || shared_count != THREADS * SHARED_ITERATIONS ||
+        !run_workers(1)) return 1;
+    for (unsigned i = 0; i < COLLISIONS; i++)
+        if (collision_count[i] != THREADS * COLLISION_ITERATIONS) return 2;
+
+    lock = guest_lock(0);
+    xbox_RtlEnterCriticalSection(lock);
+    xbox_RtlEnterCriticalSection(lock);
+    if (!try_from_other_thread(0)) return 3;
+    xbox_RtlLeaveCriticalSection(lock);
+    if (!try_from_other_thread(0)) return 4;
+    xbox_RtlLeaveCriticalSection(lock);
+    /* Try+bridge Leave must free the same native shadow, on every thread. */
+    if (!try_from_other_thread(1) || !try_from_other_thread(1)) return 5;
+    if (invoke(0) != 1 || invoke(0) != 1) return 6;
+    xbox_RtlLeaveCriticalSection(lock);
+    if (!try_from_other_thread(0)) return 7;
+    xbox_RtlLeaveCriticalSection(lock);
+    if (!try_from_other_thread(1)) return 8;
+
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&begin);
+    if (!run_workers(2)) return 9;
+    QueryPerformanceCounter(&end);
+    for (unsigned i = 0; i < COLLISIONS; i++)
+        for (unsigned j = 0; j < 32; j++)
+            if (((uint8_t *)guest_lock(i))[j] != 0xA5) return 11;
+    printf("PASS: lazy initialization, recursive exclusion, 40 colliding locks, "
+           "bridge Try/Leave and unchanged guest fields; %u independent lock pairs in %.2f ms\n",
+           THREADS * BENCH_ITERATIONS,
+           (end.QuadPart - begin.QuadPart) * 1000.0 / freq.QuadPart);
+    CloseHandle(start_event);
+    VirtualFree(memory, 0, MEM_RELEASE);
+    return 0;
+}
diff --git a/tests/kernel_dispatch/kernel_file_sharing_test.c b/tests/kernel_dispatch/kernel_file_sharing_test.c
new file mode 100644
index 0000000..37b0f04
--- /dev/null
+++ b/tests/kernel_dispatch/kernel_file_sharing_test.c
@@ -0,0 +1,108 @@
+/* A real host sharing conflict must survive the Xbox error conversion. */
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef void (*guest_fn)(void);
+extern guest_fn recomp_lookup_kernel(uint32_t);
+extern RECOMP_TLS uint32_t g_eax, g_esp;
+extern ptrdiff_t g_xbox_mem_offset;
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+int main(void)
+{
+    wchar_t base[MAX_PATH], dir[MAX_PATH] = {0}, path[MAX_PATH] = {0};
+    HANDLE exclusive = INVALID_HANDLE_VALUE, root = INVALID_HANDLE_VALUE, opened = NULL;
+    XBOX_ANSI_STRING name;
+    XBOX_OBJECT_ATTRIBUTES oa;
+    XBOX_IO_STATUS_BLOCK ios;
+    NTSTATUS status;
+    uint8_t *memory = NULL;
+    guest_fn convert;
+    int result = 1, directory_created = 0;
+    uint32_t *sp;
+
+    if (!GetTempPathW(MAX_PATH, base) ||
+        !GetTempFileNameW(base, L"xfs", 0, dir))
+        goto done;
+    if (!DeleteFileW(dir) || !CreateDirectoryW(dir, NULL))
+        goto done;
+    directory_created = 1;
+    if (swprintf_s(path, MAX_PATH, L"%s\\sharing.bin", dir) < 0)
+        goto done;
+    exclusive = CreateFileW(path, GENERIC_READ | GENERIC_WRITE, 0, NULL,
+                            CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+    root = CreateFileW(dir, FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                       NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (exclusive == INVALID_HANDLE_VALUE || root == INVALID_HANDLE_VALUE)
+        goto done;
+    memset(&name, 0, sizeof name);
+    name.Buffer = "sharing.bin";
+    name.Length = (USHORT)strlen(name.Buffer);
+    name.MaximumLength = name.Length + 1;
+    memset(&oa, 0, sizeof oa);
+    oa.RootDirectory = root;
+    oa.ObjectName = &name;
+    memset(&ios, 0xA5, sizeof ios);
+    status = xbox_NtCreateFile(&opened,
+        XBOX_GENERIC_READ | XBOX_SYNCHRONIZE | XBOX_FILE_READ_ATTRIBUTES,
+        &oa, &ios, NULL, 0x80, 1, XBOX_FILE_OPEN,
+        XBOX_FILE_SYNCHRONOUS_IO_NONALERT | XBOX_FILE_NON_DIRECTORY_FILE);
+    if (status != STATUS_SHARING_VIOLATION || ios.Status != status ||
+        ios.Information != 0 || opened != NULL ||
+        xbox_RtlNtStatusToDosError(status) != ERROR_SHARING_VIOLATION) {
+        fprintf(stderr, "FAIL: sharing conflict status=%08X ios=%08X information=%llu handle=%p\n",
+                (unsigned)status, (unsigned)ios.Status,
+                (unsigned long long)ios.Information, opened);
+        goto done;
+    }
+
+    /* Translated games use the bridge's independent status mapping. */
+    memory = VirtualAlloc(NULL, 16 * 1024 * 1024,
+                          MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!memory)
+        goto done;
+    g_xbox_mem_offset = (ptrdiff_t)memory;
+    *(uint32_t *)(memory + 0x10000) = 0x80000000u | 301;
+    xbox_kernel_set_thunk_address(0x10000, 1);
+    xbox_kernel_bridge_init();
+    convert = recomp_lookup_kernel(*(uint32_t *)(memory + 0x10000));
+    if (!convert)
+        goto done;
+    g_esp = 0x20000;
+    sp = (uint32_t *)(memory + g_esp);
+    sp[0] = 0xBEEF0001;
+    sp[1] = (uint32_t)status;
+    convert();
+    if (g_eax != ERROR_SHARING_VIOLATION || g_esp != 0x20008) {
+        fprintf(stderr, "FAIL: bridge lost sharing error: eax=%08X esp=%08X\n", g_eax, g_esp);
+        goto done;
+    }
+
+    /* Sharing was enforced, and the same request can succeed after release. */
+    CloseHandle(exclusive);
+    exclusive = INVALID_HANDLE_VALUE;
+    status = xbox_NtCreateFile(&opened,
+        XBOX_GENERIC_READ | XBOX_SYNCHRONIZE | XBOX_FILE_READ_ATTRIBUTES,
+        &oa, &ios, NULL, 0x80, 1, XBOX_FILE_OPEN,
+        XBOX_FILE_SYNCHRONOUS_IO_NONALERT | XBOX_FILE_NON_DIRECTORY_FILE);
+    if (status != STATUS_SUCCESS || ios.Status != STATUS_SUCCESS || !opened) {
+        fprintf(stderr, "FAIL: unchanged open failed after host lock closed: %08X\n", (unsigned)status);
+        goto done;
+    }
+    puts("PASS: sharing conflict stays denied with matching NTSTATUS/IOS/DOS error, then opens after release");
+    result = 0;
+
+done:
+    if (opened && opened != INVALID_HANDLE_VALUE) xbox_NtClose(opened);
+    if (root != INVALID_HANDLE_VALUE) CloseHandle(root);
+    if (exclusive != INVALID_HANDLE_VALUE) CloseHandle(exclusive);
+    if (memory) VirtualFree(memory, 0, MEM_RELEASE);
+    if (*path) DeleteFileW(path);
+    if (directory_created) RemoveDirectoryW(dir);
+    return result;
+}
diff --git a/tests/kernel_dispatch/kernel_handle_thread_test.c b/tests/kernel_dispatch/kernel_handle_thread_test.c
new file mode 100644
index 0000000..95ff65e
--- /dev/null
+++ b/tests/kernel_dispatch/kernel_handle_thread_test.c
@@ -0,0 +1,327 @@
+/* Real event/file imports share the bridge's actual private handle table. */
+#include "../../src/kernel/kernel_bridge.c"
+
+#define WORKERS 12
+#define ROUNDS 32
+#define CHECK(c) do { if (!(c)) { \
+    fprintf(stderr, "FAIL: line %d: %s (error %lu)\n", __LINE__, #c, GetLastError()); \
+    exit(1); \
+} } while (0)
+
+recomp_func_t recomp_lookup(uint32_t address) { (void)address; abort(); }
+recomp_func_t recomp_lookup_manual(uint32_t address) { (void)address; abort(); }
+
+enum { CLOSE, CREATE_EVENT, CREATE_FILE, READ_FILE, SET_EVENT, WAIT_EVENT, WRITE_FILE, SERVICES };
+static const uint32_t ordinals[SERVICES] = {187, 189, 190, 219, 225, 233, 236};
+static uint32_t services[SERVICES];
+static uint8_t *memory;
+static uint32_t root_token;
+static wchar_t directory[MAX_PATH];
+
+typedef struct {
+    CRITICAL_SECTION lock;
+    CONDITION_VARIABLE changed;
+    unsigned count, generation;
+} barrier_t;
+static barrier_t barrier;
+
+static void rendezvous(void)
+{
+    unsigned generation;
+    EnterCriticalSection(&barrier.lock);
+    generation = barrier.generation;
+    if (++barrier.count == WORKERS + 1) {
+        barrier.count = 0;
+        barrier.generation++;
+        WakeAllConditionVariable(&barrier.changed);
+    } else {
+        while (generation == barrier.generation)
+            CHECK(SleepConditionVariableCS(&barrier.changed, &barrier.lock, 10000));
+    }
+    LeaveCriticalSection(&barrier.lock);
+}
+
+static uint32_t invoke(unsigned service, uint32_t stack, const uint32_t *args, unsigned count)
+{
+    recomp_func_t fn;
+    uint32_t *sp = (uint32_t *)(memory + stack);
+    sp[0] = 0xBEEF0001;
+    memcpy(sp + 1, args, count * sizeof *args);
+    g_esp = stack;
+    fn = recomp_lookup_kernel(services[service]);
+    CHECK(fn != NULL);
+    fn();
+    CHECK(g_esp == stack + 4 + count * 4);
+    return g_eax;
+}
+
+static uint32_t arena(unsigned id) { return 0x20000 + id * 0x1000; }
+static uint32_t guest_word(uint32_t va) { return *(uint32_t *)(memory + va); }
+
+static void close_token(uint32_t token, uint32_t stack)
+{
+    CHECK(invoke(CLOSE, stack, &token, 1) == STATUS_SUCCESS);
+}
+
+static void file_name(unsigned id, unsigned round, char *name, size_t bytes)
+{
+    CHECK(sprintf_s(name, bytes, "worker-%02u-%02u.bin", id, round) > 0);
+}
+
+static void delete_file(unsigned id, unsigned round)
+{
+    char name[40];
+    wchar_t path[MAX_PATH];
+    file_name(id, round, name, sizeof name);
+    CHECK(swprintf_s(path, MAX_PATH, L"%s\\%hs", directory, name) > 0);
+    CHECK(DeleteFileW(path));
+}
+
+static void open_pair(unsigned id, unsigned round, uint32_t *event_token, uint32_t *file_token)
+{
+    uint32_t base = arena(id);
+    uint32_t event_args[] = {base + 0x100, 0, 0, 0};
+    uint32_t file_args[] = {base + 0x104,
+        XBOX_GENERIC_READ | XBOX_GENERIC_WRITE | XBOX_SYNCHRONIZE,
+        base + 0x160, base + 0x120, 0, 0, 0, XBOX_FILE_CREATE,
+        XBOX_FILE_SYNCHRONOUS_IO_NONALERT | XBOX_FILE_NON_DIRECTORY_FILE};
+    uint32_t io_args[] = {0, 0, 0, 0, base + 0x120, base + 0x280, 32, base + 0x300};
+    uint32_t *oa = (uint32_t *)(memory + base + 0x160);
+    uint16_t *name = (uint16_t *)(memory + base + 0x190);
+    uint32_t *payload = (uint32_t *)(memory + base + 0x280);
+    unsigned j;
+    char *filename = (char *)(memory + base + 0x200);
+    file_name(id, round, filename, 64);
+    memset(oa, 0, 12);
+    oa[0] = root_token;
+    oa[1] = base + 0x190;
+    name[0] = (uint16_t)strlen(filename);
+    name[1] = name[0] + 1;
+    *(uint32_t *)(name + 2) = base + 0x200;
+    *(uint64_t *)(memory + base + 0x300) = 0;
+    CHECK(invoke(CREATE_EVENT, base, event_args, 4) == STATUS_SUCCESS);
+    *event_token = guest_word(base + 0x100);
+    CHECK(invoke(CREATE_FILE, base, file_args, 9) == STATUS_SUCCESS);
+    *file_token = guest_word(base + 0x104);
+    CHECK(*event_token && *file_token && *event_token != *file_token);
+    for (j = 0; j < 8; ++j) payload[j] = 0xCA000000u | id << 16 | round << 8 | j;
+    io_args[0] = *file_token;
+    CHECK(invoke(WRITE_FILE, base, io_args, 8) == STATUS_SUCCESS);
+    CHECK(guest_word(base + 0x124) == 32);
+    io_args[5] = base + 0x2A0;
+    memset(memory + base + 0x2A0, 0, 32);
+    CHECK(invoke(READ_FILE, base, io_args, 8) == STATUS_SUCCESS);
+    CHECK(guest_word(base + 0x124) == 32);
+    CHECK(memcmp(memory + base + 0x280, memory + base + 0x2A0, 32) == 0);
+}
+
+static DWORD WINAPI io_worker(LPVOID parameter)
+{
+    unsigned id = (unsigned)(uintptr_t)parameter, round;
+    uint32_t event_token = 0, file_token = 0;
+    for (round = 0; round < ROUNDS; ++round) {
+        uint32_t next_event, next_file;
+        rendezvous();
+        /* Half the workers create before closing their previous pair. The
+         * other half close first, so registrations and takes overlap on
+         * distinct live objects without racing an object's own native use.
+         */
+        if (round && (id & 1)) {
+            close_token(event_token, arena(id));
+            close_token(file_token, arena(id));
+            delete_file(id, round - 1);
+        }
+        open_pair(id, round, &next_event, &next_file);
+        if (round && !(id & 1)) {
+            close_token(event_token, arena(id));
+            close_token(file_token, arena(id));
+            delete_file(id, round - 1);
+        }
+        event_token = next_event;
+        file_token = next_file;
+        rendezvous();
+        rendezvous();
+    }
+    rendezvous();
+    close_token(event_token, arena(id));
+    close_token(file_token, arena(id));
+    delete_file(id, ROUNDS - 1);
+    rendezvous();
+    return 0;
+}
+
+static void check_live_pairs(void)
+{
+    uint32_t tokens[WORKERS * 2];
+    HANDLE handles[WORKERS * 2];
+    unsigned i, j;
+    for (i = 0; i < WORKERS * 2; ++i) {
+        uint32_t va = arena(i / 2) + 0x100 + (i & 1) * 4;
+        DWORD flags;
+        tokens[i] = guest_word(va);
+        handles[i] = bridge_read_handle(va);
+        CHECK((tokens[i] & 0xFF000000u) == BRIDGE_HANDLE_TAG);
+        CHECK(handles[i] && handles[i] == bridge_resolve_handle(tokens[i]));
+        CHECK(GetHandleInformation(handles[i], &flags));
+        for (j = 0; j < i; ++j)
+            CHECK(tokens[i] != tokens[j] && handles[i] != handles[j]);
+    }
+    /* Signal one guest event at a time, and observe all events through real
+     * wait imports. A token collision cannot pass this identity check.
+     */
+    *(uint64_t *)(memory + 0x100300) = 0;
+    for (i = 0; i < WORKERS; ++i) {
+        uint32_t set_args[] = {tokens[i * 2], 0};
+        CHECK(invoke(SET_EVENT, 0x100000, set_args, 2) == STATUS_SUCCESS);
+        for (j = 0; j < WORKERS; ++j) {
+            uint32_t wait_args[] = {tokens[j * 2], 0, 0x100300};
+            CHECK(invoke(WAIT_EVENT, 0x100000, wait_args, 3) ==
+                  (j <= i ? STATUS_SUCCESS : STATUS_TIMEOUT));
+        }
+    }
+}
+
+static HANDLE shared_handle;
+static uint32_t shared_token, results[WORKERS];
+static HANDLE taken[WORKERS];
+static int take_mode;
+static DWORD WINAPI same_handle_worker(LPVOID parameter)
+{
+    unsigned id = (unsigned)(uintptr_t)parameter;
+    rendezvous();
+    if (take_mode) taken[id] = bridge_take_handle(shared_token);
+    else results[id] = bridge_handle_token(shared_handle);
+    rendezvous();
+    return 0;
+}
+
+static void same_handle_cohort(int taking)
+{
+    HANDLE threads[WORKERS];
+    unsigned i, winners = 0;
+    take_mode = taking;
+    for (i = 0; i < WORKERS; ++i) {
+        threads[i] = CreateThread(NULL, 0, same_handle_worker, (LPVOID)(uintptr_t)i, 0, NULL);
+        CHECK(threads[i]);
+    }
+    rendezvous();
+    rendezvous();
+    CHECK(WaitForMultipleObjects(WORKERS, threads, TRUE, 10000) == WAIT_OBJECT_0);
+    for (i = 0; i < WORKERS; ++i) {
+        if (taking) {
+            CHECK(taken[i] == NULL || taken[i] == shared_handle);
+            winners += taken[i] != NULL;
+        } else CHECK(results[i] == shared_token);
+        CHECK(CloseHandle(threads[i]));
+    }
+    if (taking) CHECK(winners == 1 && bridge_resolve_handle(shared_token) == NULL);
+}
+
+static void table_edges(void)
+{
+    uint32_t invalid[] = {BRIDGE_HANDLE_TAG, BRIDGE_HANDLE_TAG | BRIDGE_HANDLE_MAX,
+                          BRIDGE_HANDLE_TAG | BRIDGE_HANDLE_MASK};
+    HANDLE wide = (HANDLE)(uintptr_t)UINT64_C(0x123456780000);
+    HANDLE overflow;
+    DWORD flags;
+    unsigned i;
+    uint32_t token;
+    CHECK(bridge_handle_token(NULL) == 0 && bridge_handle_token(INVALID_HANDLE_VALUE) == 0);
+    token = bridge_handle_token(wide);
+    CHECK(token == (BRIDGE_HANDLE_TAG | 1));
+    CHECK(bridge_handle_token(wide) == token && bridge_resolve_handle(token) == wide);
+    bridge_write_handle(0x18000, wide);
+    CHECK(guest_word(0x18000) == token && bridge_read_handle(0x18000) == wide);
+    CHECK(bridge_take_handle(token) == wide && bridge_take_handle(token) == NULL);
+    CHECK(bridge_resolve_handle(0xFFFFFFFEu) == (HANDLE)(intptr_t)-2);
+    CHECK(bridge_resolve_handle(0xFFFFFFFFu) == (HANDLE)(intptr_t)-1);
+    CHECK(bridge_resolve_handle(0xDEAD0001u) == (HANDLE)(uintptr_t)0xDEAD0001u);
+    CHECK(bridge_resolve_handle(0xFE000000u) == (HANDLE)(uintptr_t)0xFE000000u);
+    CHECK(bridge_take_handle(0xDEAD0001u) == NULL);
+    for (i = 0; i < sizeof invalid / sizeof *invalid; ++i) {
+        *(uint32_t *)(memory + 0x18000) = invalid[i];
+        CHECK(bridge_read_handle(0x18000) == NULL);
+        CHECK(bridge_resolve_handle(invalid[i]) == NULL && bridge_take_handle(invalid[i]) == NULL);
+    }
+    *(uint32_t *)(memory + 0x18000) = 0xBEEF0010u;
+    CHECK(bridge_read_handle(0x18000) == (HANDLE)(uintptr_t)0xBEEF0010u);
+
+    /* Populate exact private bounds without O(N^2) registrations. Exhaustion
+     * must retain the caller's ownership and still deduplicate existing slots.
+     */
+    AcquireSRWLockExclusive(&s_handle_table_lock);
+    for (i = 1; i < BRIDGE_HANDLE_MAX; ++i)
+        bridge_handle_store(i, (HANDLE)((uintptr_t)wide + i * 16));
+    ReleaseSRWLockExclusive(&s_handle_table_lock);
+    overflow = CreateEventW(NULL, TRUE, FALSE, NULL);
+    CHECK(overflow);
+    CHECK(bridge_handle_token(overflow) == 0 && GetHandleInformation(overflow, &flags));
+    CHECK(bridge_handle_token((HANDLE)((uintptr_t)wide + (BRIDGE_HANDLE_MAX - 1) * 16)) ==
+          (BRIDGE_HANDLE_TAG | (BRIDGE_HANDLE_MAX - 1)));
+    CHECK(bridge_take_handle(BRIDGE_HANDLE_TAG | 1) == (HANDLE)((uintptr_t)wide + 16));
+    CHECK(bridge_handle_token(overflow) == (BRIDGE_HANDLE_TAG | 1));
+    CHECK(bridge_take_handle(BRIDGE_HANDLE_TAG | 1) == overflow && CloseHandle(overflow));
+    AcquireSRWLockExclusive(&s_handle_table_lock);
+    for (i = 1; i < BRIDGE_HANDLE_MAX; ++i) bridge_handle_store(i, NULL);
+    ReleaseSRWLockExclusive(&s_handle_table_lock);
+
+    shared_handle = CreateEventW(NULL, TRUE, FALSE, NULL);
+    CHECK(shared_handle);
+    shared_token = bridge_handle_token(shared_handle);
+    same_handle_cohort(0);
+    same_handle_cohort(1);
+    CHECK(CloseHandle(shared_handle));
+}
+
+int main(void)
+{
+    HANDLE root, threads[WORKERS];
+    wchar_t temporary[MAX_PATH];
+    DWORD count, live_count = 0;
+    unsigned i, round;
+    CHECK(_putenv_s("RECOMP_KERNEL_LOG_BUDGET", "0") == 0);
+    CHECK(_putenv_s("RECOMP_GUEST_LOCK", "0") == 0);
+    memory = VirtualAlloc(NULL, 16 * 1024 * 1024, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    CHECK(memory);
+    g_xbox_mem_offset = (ptrdiff_t)memory;
+    InitializeCriticalSection(&barrier.lock);
+    InitializeConditionVariable(&barrier.changed);
+    for (i = 0; i < SERVICES; ++i) *(uint32_t *)(memory + 0x10000 + i * 4) = 0x80000000u | ordinals[i];
+    xbox_kernel_set_thunk_address(0x10000, SERVICES);
+    xbox_kernel_bridge_init();
+    for (i = 0; i < SERVICES; ++i) services[i] = guest_word(0x10000 + i * 4);
+    table_edges();
+    CHECK(GetTempPathW(MAX_PATH, temporary));
+    CHECK(GetTempFileNameW(temporary, L"xht", 0, directory));
+    CHECK(DeleteFileW(directory) && CreateDirectoryW(directory, NULL));
+    root = CreateFileW(directory, FILE_LIST_DIRECTORY,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+        OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    CHECK(root != INVALID_HANDLE_VALUE);
+    root_token = bridge_handle_token(root);
+    for (i = 0; i < WORKERS; ++i) {
+        threads[i] = CreateThread(NULL, 0, io_worker, (LPVOID)(uintptr_t)i, 0, NULL);
+        CHECK(threads[i]);
+    }
+    for (round = 0; round < ROUNDS; ++round) {
+        rendezvous();
+        rendezvous();
+        check_live_pairs();
+        CHECK(GetProcessHandleCount(GetCurrentProcess(), &count));
+        if (!round) live_count = count;
+        CHECK(count == live_count);
+        rendezvous();
+    }
+    rendezvous();
+    rendezvous();
+    CHECK(GetProcessHandleCount(GetCurrentProcess(), &count) && count + WORKERS * 2 == live_count);
+    CHECK(WaitForMultipleObjects(WORKERS, threads, TRUE, 10000) == WAIT_OBJECT_0);
+    for (i = 0; i < WORKERS; ++i) CHECK(CloseHandle(threads[i]));
+    CHECK(bridge_take_handle(root_token) == root && CloseHandle(root));
+    for (i = 1; i < BRIDGE_HANDLE_MAX; ++i) CHECK(bridge_handle_load(i) == NULL);
+    CHECK(RemoveDirectoryW(directory));
+    DeleteCriticalSection(&barrier.lock);
+    CHECK(VirtualFree(memory, 0, MEM_RELEASE));
+    puts("PASS: concurrent event/file imports retain unique tokens, exact identities/data and no native-handle leaks");
+    return 0;
+}
diff --git a/tests/kernel_dispatch/kernel_log_test.c b/tests/kernel_dispatch/kernel_log_test.c
new file mode 100644
index 0000000..60420ee
--- /dev/null
+++ b/tests/kernel_dispatch/kernel_log_test.c
@@ -0,0 +1,124 @@
+/* Exercise the real dispatcher across guest threads with no game assets. */
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <io.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef void (*guest_fn)(void);
+extern guest_fn recomp_lookup_kernel(uint32_t);
+extern RECOMP_TLS uint32_t g_eax, g_esp;
+extern ptrdiff_t g_xbox_mem_offset;
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+static uint8_t *memory;
+static uint32_t service;
+
+static void dispatch(guest_fn fn, uint32_t stack)
+{
+    g_esp = stack;
+    *(uint32_t *)(memory + stack) = 0xBEEF0001;
+    fn();
+    if (g_esp != stack + 4 || g_eax != 0)
+        abort();
+}
+
+static DWORD WINAPI worker(LPVOID stack)
+{
+    guest_fn fn = recomp_lookup_kernel(service);
+    unsigned i;
+    if (!fn)
+        return 1;
+    for (i = 0; i < 10000; ++i)
+        dispatch(fn, (uint32_t)(uintptr_t)stack);
+    return 0;
+}
+
+static unsigned occurrences(const char *text, const char *needle)
+{
+    unsigned count = 0;
+    while ((text = strstr(text, needle)) != NULL) {
+        count++;
+        text += strlen(needle);
+    }
+    return count;
+}
+
+int main(int argc, char **argv)
+{
+    int summary = argc == 2 && strcmp(argv[1], "summary") == 0;
+    int budget = argc == 2 && strcmp(argv[1], "budget") == 0;
+    FILE *captured;
+    int saved_stderr;
+    HANDLE threads[2];
+    char output[4096];
+    size_t length;
+    unsigned i;
+    guest_fn fn;
+    if (_putenv_s("RECOMP_KERNEL_LOG_BUDGET", budget ? "3" : "0") ||
+        _putenv_s("RECOMP_KERNEL_SUMMARY", summary ? "1" : "") ||
+        _putenv_s("RECOMP_GUEST_LOCK", "0"))
+        return 10;
+    memory = VirtualAlloc(NULL, 16 * 1024 * 1024,
+                          MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!memory)
+        return 11;
+    g_xbox_mem_offset = (ptrdiff_t)memory;
+    *(uint32_t *)(memory + 0x10000) = 0x80000000u | 103;
+    xbox_kernel_set_thunk_address(0x10000, 1);
+    xbox_kernel_bridge_init();
+    service = *(uint32_t *)(memory + 0x10000);
+
+    fflush(stderr);
+    captured = tmpfile();
+    saved_stderr = _dup(_fileno(stderr));
+    if (!captured || saved_stderr < 0 ||
+        _dup2(_fileno(captured), _fileno(stderr)) != 0)
+        return 12;
+    for (i = 0; i < 2; ++i) {
+        threads[i] = CreateThread(NULL, 0, worker,
+                                  (LPVOID)(uintptr_t)(0x20000 + i * 0x1000), 0, NULL);
+        if (!threads[i])
+            return 13;
+    }
+    if (WaitForMultipleObjects(2, threads, TRUE, 5000) != WAIT_OBJECT_0)
+        return 14;
+    for (i = 0; i < 2; ++i) {
+        DWORD result = 1;
+        GetExitCodeThread(threads[i], &result);
+        CloseHandle(threads[i]);
+        if (result)
+            return 15;
+    }
+    /* Pass the old mandatory-summary threshold, then dispatch once more. */
+    Sleep(2100);
+    fn = recomp_lookup_kernel(service);
+    if (!fn)
+        return 16;
+    dispatch(fn, 0x22000);
+    fflush(stderr);
+    _dup2(saved_stderr, _fileno(stderr));
+    _close(saved_stderr);
+    rewind(captured);
+    length = fread(output, 1, sizeof output - 1, captured);
+    output[length] = '\0';
+    fclose(captured);
+    VirtualFree(memory, 0, MEM_RELEASE);
+
+    if (occurrences(output, "[KERNEL] #") != (budget ? 3u : 0u) ||
+        occurrences(output, "[KERNEL] summary:") != (summary ? 1u : 0u) ||
+        (budget && (occurrences(output, "[KERNEL] #1:") != 1 ||
+                    occurrences(output, "[KERNEL] #2:") != 1 ||
+                    occurrences(output, "[KERNEL] #3:") != 1)) ||
+        (summary && (!strstr(output, "20001 total calls") ||
+                     !strstr(output, "ordinal 103 x20001")))) {
+        fprintf(stderr, "FAIL: kernel log mode %s:\n%s", argc > 1 ? argv[1] : "quiet", output);
+        return 1;
+    }
+    printf("PASS: kernel log mode %s preserves quiet gameplay and explicit diagnostics\n",
+           argc > 1 ? argv[1] : "quiet");
+    return 0;
+}
diff --git a/tests/kernel_dispatch/nv2a_command_fence_test.c b/tests/kernel_dispatch/nv2a_command_fence_test.c
new file mode 100644
index 0000000..c57fdd2
--- /dev/null
+++ b/tests/kernel_dispatch/nv2a_command_fence_test.c
@@ -0,0 +1,274 @@
+/* Exercise real executor dispatch and the production completion publisher.
+ * Only guest arena setup and GPU readback readiness are supplied by the test. */
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static int readback_busy;
+static unsigned readback_polls;
+static int fail_next_malloc;
+static void *test_malloc(size_t bytes)
+{
+    if (fail_next_malloc) { fail_next_malloc = 0; return NULL; }
+    return malloc(bytes);
+}
+static int test_writeback_busy(void)
+{
+    ++readback_polls;
+    return readback_busy;
+}
+#define nv2a_d3d_writeback_busy test_writeback_busy
+#define malloc test_malloc
+#include "../../src/kernel/xbox_memory_layout.c"
+#undef malloc
+#undef nv2a_d3d_writeback_busy
+
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+extern void nv2a_pb_exec_method(uint32_t, uint32_t, uint32_t);
+
+#define CHECK(expr) do { if (!(expr)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #expr); exit(1); \
+} } while (0)
+
+static volatile uint32_t *guest(uint32_t va)
+{
+    return (volatile uint32_t *)((uintptr_t)va + g_memory_offset);
+}
+static void method(uint32_t address, uint32_t value)
+{
+    nv2a_pb_exec_method(0, address, value);
+}
+
+int main(void)
+{
+    uint8_t *arena = VirtualAlloc(NULL, 0x100000, MEM_RESERVE | MEM_COMMIT,
+                                  PAGE_READWRITE);
+    uint8_t *registers = calloc(1, 0x1000000);
+    volatile uint32_t *regs = (volatile uint32_t *)registers;
+    volatile uint32_t *get = (volatile uint32_t *)(registers + NV2A_USER_DMA_GET);
+    volatile uint32_t *put = (volatile uint32_t *)(registers + NV2A_USER_DMA_PUT);
+    LONG generation;
+    unsigned polls;
+    XBOX_NV2A_CAPTURE_STATE snapshot;
+    CHECK(arena && registers);
+    g_memory_base = arena;
+    g_memory_size = 0x100000;
+    g_memory_offset = (ptrdiff_t)arena;
+    xbox_nv2a_wake_init(&g_nv2a_wake);
+    *guest(0x10000) = 0x20000;
+    *guest(0x20030) = 0x30000;
+    *guest(0x2002C) = 99; /* The next submitted counter is not completed work. */
+    *guest(0x30000) = 23;
+    *get = 111; *put = 999;
+    CHECK(xbox_Nv2aCommandFence(0x10000, 0xC, 0) == -1);
+    CHECK(xbox_Nv2aMirrorFence(0x10000, 0x2C, 0x30) == 0);
+    CHECK(xbox_Nv2aCommandFence(0x10000, 0xC, 0) == 0);
+
+    /* Startup/idle cannot invent a first release, even before DMA_PUT moves. */
+    generation = xbox_nv2a_wake_snapshot(&g_nv2a_wake);
+    fence_mirrors_tick(0); fence_mirrors_tick(1);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 23 && *get == 111 && !readback_polls);
+    CHECK(xbox_nv2a_wake_snapshot(&g_nv2a_wake) == generation);
+
+    /* Actual dispatch filters the configured DMA, offset and 3D subchannel. */
+    method(0x01A8, 0xD); method(0x1D6C, 0); method(0x1D70, 100);
+    nv2a_pb_exec_method(1, 0x01A8, 0xC);
+    method(0x1D70, 101);
+    method(0x01A8, 0xC); method(0x1D6C, 4); method(0x1D70, 102);
+    nv2a_pb_exec_method(1, 0x1D6C, 0);
+    method(0x1D70, 103);
+    CHECK(!command_fences_pending());
+    method(0x1D6C, 0);
+    nv2a_pb_exec_method(1, 0x1D70, 104);
+    CHECK(!command_fences_pending());
+
+    /* Zero is a real release; a busy prior readback defers its publication. */
+    readback_busy = 1;
+    method(0x1D70, 0);
+    CHECK(command_fences_pending());
+    nv2a_publish_readback_complete(regs);
+    *guest(0x2002C) = 12345;
+    fence_mirrors_tick(0); fence_mirrors_tick(1);
+    CHECK(*guest(0x30000) == 23 && *get == 111);
+    CHECK(xbox_nv2a_wake_snapshot(&g_nv2a_wake) == generation);
+    readback_busy = 0;
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 0 && *guest(0x2002C) == 12345 && *get == 111);
+    CHECK(!command_fences_pending());
+    CHECK(xbox_nv2a_wake_snapshot(&g_nv2a_wake) == generation + 1);
+    polls = readback_polls;
+    nv2a_publish_readback_complete(regs);
+    CHECK(readback_polls == polls); /* No work adds no driver polls. */
+
+    /* Latest execution order wins across wrap, never a numeric MAX. */
+    *guest(0x30000) = 1;
+    method(0x1D70, UINT32_MAX); method(0x1D70, 0);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 0);
+    method(0x1D70, UINT32_MAX - 1); method(0x1D70, 1);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 1);
+    method(0x1D70, 3); method(0x1D70, 5);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 5);
+
+    /* Retain the target at execution, not a later device/get-pointer chain. */
+    *guest(0x22030) = 0x31000;
+    *guest(0x31000) = 0xDEADBEEF;
+    readback_busy = 1;
+    method(0x1D70, 7);
+    *guest(0x10000) = 0x22000;
+    *guest(0x20030) = 0x31000;
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 5 && *guest(0x31000) == 0xDEADBEEF);
+    readback_busy = 0;
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 7 && *guest(0x31000) == 0xDEADBEEF);
+    method(0x1D70, 9);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x31000) == 9);
+
+    /* Multiple targets before one readback completion must all be retained.
+     * Returning to the first target is a new ordered write, not a reorder. */
+    readback_busy = 1;
+    method(0x1D70, 10);
+    CHECK(xbox_Nv2aCommandFence(0x10000, 0xC, 0) == -1);
+    *guest(0x22030) = 0x30000;
+    method(0x1D70, 11);
+    *guest(0x22030) = 0x31000;
+    method(0x1D70, 12);
+    method(0x1D70, 14); /* Consecutive writes coalesce only at the tail. */
+    CHECK(g_fence_mirrors[0].command_head && g_fence_mirrors[0].command_tail);
+    CHECK(g_fence_mirrors[0].command_head->target == 0x30000);
+    CHECK(g_fence_mirrors[0].command_tail->target == 0x31000);
+    CHECK(g_fence_mirrors[0].command_tail->value == 14);
+    xbox_Nv2aCaptureSnapshot(&snapshot);
+    CHECK(snapshot.version == 1 && snapshot.bytes == sizeof snapshot);
+    CHECK(snapshot.mirrors[0].command_queue_count == 3);
+    CHECK(snapshot.mirrors[0].device_bytes == XBOX_NV2A_CAPTURE_DEVICE_BYTES);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 7 && *guest(0x31000) == 9);
+    readback_busy = 0;
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x30000) == 11 && *guest(0x31000) == 14);
+    CHECK(!g_fence_mirrors[0].command_head && !g_fence_mirrors[0].command_tail);
+
+    /* A target-change CRT allocation failure uses the native heap without
+     * publishing any fence/GET/notification or polling prior GPU work. */
+    method(0x1D70, 18);
+    *guest(0x22030) = 0x30000;
+    fail_next_malloc = 1;
+    polls = readback_polls;
+    generation = xbox_nv2a_wake_snapshot(&g_nv2a_wake);
+    method(0x1D70, 20);
+    CHECK(!fail_next_malloc && g_fence_mirrors[0].command_tail->native_heap);
+    CHECK(*guest(0x31000) == 14 && *guest(0x30000) == 11 && *get == 111);
+    CHECK(readback_polls == polls && !g_notify_count &&
+          xbox_nv2a_wake_snapshot(&g_nv2a_wake) == generation);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x31000) == 18 && *guest(0x30000) == 20 && *get == 111);
+    *guest(0x22030) = 0x31000;
+    *guest(0x31000) = 9;
+
+    /* Unreadable chains cannot change guest bytes or invent pending work. */
+    *guest(0x10000) = 0;
+    method(0x1D70, 11);
+    *guest(0x10000) = 0xFFFFFFF0;
+    method(0x1D70, 11);
+    *guest(0x10000) = 0x22000;
+    *guest(0x22030) = 0;
+    method(0x1D70, 11);
+    CHECK(!command_fences_pending() && *guest(0x31000) == 9);
+    *guest(0x22030) = 0x31000;
+
+    /* A cap retains even an executed fence. Publishing it alongside an old
+     * GET could let guest reserve logic reuse the unread part of that lap. */
+    s_scan_incomplete = 1;
+    readback_busy = 1;
+    method(0x1D70, 13);
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x31000) == 9 && *get == 111);
+    readback_busy = 0;
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x31000) == 9 && *get == 111 && s_scan_incomplete);
+    s_get_held = 1; s_get_held_value = 222;
+    readback_busy = 1;
+    method(0x1D70, 15);
+    nv2a_publish_readback_complete(regs);
+    CHECK(s_get_held && *get == 111 && *guest(0x31000) == 9);
+    readback_busy = 0;
+    nv2a_publish_readback_complete(regs);
+    CHECK(!s_get_held && *get == 222 && *put == 999 && s_scan_incomplete);
+    CHECK(*guest(0x31000) == 9 && command_fences_pending());
+    s_scan_incomplete = 0;
+    nv2a_publish_readback_complete(regs);
+    CHECK(*guest(0x31000) == 15 && !command_fences_pending());
+
+    /* Publication failure retains the exact target/value for a later retry. */
+    method(0x1D70, 17);
+    g_memory_size = 0x29000;
+    nv2a_publish_readback_complete(regs);
+    CHECK(command_fences_pending() && *guest(0x31000) == 15);
+    g_memory_size = 0x100000;
+    nv2a_publish_readback_complete(regs);
+    CHECK(!command_fences_pending() && *guest(0x31000) == 17);
+
+    /* Other titles retain the original generic counter-snapshot behavior. */
+    *guest(0x12000) = 0x24000;
+    *guest(0x24030) = 0x34000;
+    *guest(0x2402C) = 76;
+    *guest(0x34000) = 55;
+    CHECK(xbox_Nv2aMirrorFence(0x12000, 0x2C, 0x30) == 0);
+    fence_mirrors_tick(0);
+    *guest(0x2402C) = 77;
+    fence_mirrors_tick(1);
+    CHECK(*guest(0x34000) == 76 && *guest(0x31000) == 17);
+
+    /* Diagnostics distinguish the real aperture from a guest software
+     * channel, retain raw device fields, and never query/read back the GPU. */
+    g_nv2a_memory = registers;
+    *guest(0x22008) = 0x2000;
+    *guest(0x237C0) = 0x14000;
+    *guest(0x14040) = 0x4444; *guest(0x14044) = 0x5555;
+    *guest(0x224F8) = XBOX_NV2A_BASE;
+    *(uint32_t *)(registers + NV2A_PFIFO_DMA_SUBROUTINE) = 0x7777;
+    CHECK(xbox_Nv2aNotifyEvent(0x10000, 0x196C, 5) == 0);
+    g_notify_count = 7;
+    s_scan_incomplete = 1;
+    polls = readback_polls;
+    SetLastError(0x12345678);
+    xbox_Nv2aCaptureSnapshot(&snapshot);
+    CHECK(GetLastError() == 0x12345678 && readback_polls == polls);
+    CHECK(snapshot.mmio_valid && snapshot.user_put == 999 && snapshot.user_get == 222);
+    CHECK(snapshot.scan_incomplete == 1 && !snapshot.get_held);
+    CHECK(snapshot.notify_count == 7 && snapshot.notify_param == 5);
+    CHECK(snapshot.mirror_count == 2 && !snapshot.counter_mirrors && !snapshot.frame_counters);
+    CHECK(snapshot.mirrors[0].device_ptr_va == 0x10000 && snapshot.mirrors[0].device_va == 0x22000);
+    CHECK(snapshot.mirrors[0].channel_valid && snapshot.mirrors[0].channel_va == 0x14000);
+    CHECK(snapshot.mirrors[0].channel_put == 0x4444 && snapshot.mirrors[0].channel_get == 0x5555);
+    CHECK(snapshot.mirrors[0].pfifo_valid && snapshot.mirrors[0].pfifo_subroutine == 0x7777);
+    CHECK(*(uint32_t *)(snapshot.mirrors[0].device + 8) == 0x2000);
+    CHECK(snapshot.mirrors[0].fence_valid && snapshot.mirrors[0].fence_value == 17);
+    CHECK(snapshot.mirrors[0].command_mode && !snapshot.mirrors[0].command_queue_count);
+    *guest(0x237C0) = XBOX_NV2A_BASE + 0x800000;
+    xbox_Nv2aCaptureSnapshot(&snapshot);
+    CHECK(snapshot.mirrors[0].channel_valid && snapshot.mirrors[0].channel_put == 999 &&
+          snapshot.mirrors[0].channel_get == 222);
+    g_nv2a_memory = NULL;
+    *guest(0x10000) = UINT32_MAX - 8;
+    xbox_Nv2aCaptureSnapshot(&snapshot);
+    CHECK(!snapshot.mmio_valid && !snapshot.mirrors[0].device_valid &&
+          !snapshot.mirrors[0].device_bytes);
+    xbox_Nv2aCaptureSnapshot(NULL);
+
+    puts("PASS: real semaphore dispatch, no idle early fence, readback/cap/GET "
+         "ordering, uint32 wrap, captured targets, generic fallback and read-only state capture");
+    g_memory_base = NULL;
+    free(registers);
+    CHECK(VirtualFree(arena, 0, MEM_RELEASE));
+    return 0;
+}
diff --git a/tests/kernel_dispatch/nv2a_dma_sync_test.c b/tests/kernel_dispatch/nv2a_dma_sync_test.c
new file mode 100644
index 0000000..f49c566
--- /dev/null
+++ b/tests/kernel_dispatch/nv2a_dma_sync_test.c
@@ -0,0 +1,263 @@
+/* Real publication/completion code, with only GPU readiness supplied here. */
+#include "kernel.h"
+#include "xbox_memory_layout.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static int readback_busy;
+static int test_writeback_busy(void) { return readback_busy; }
+#define nv2a_d3d_writeback_busy test_writeback_busy
+#include "../../src/kernel/xbox_memory_layout.c"
+#undef nv2a_d3d_writeback_busy
+
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #x); ExitProcess(1); \
+} } while (0)
+
+static volatile uint32_t *registers;
+#define REG(offset) (*(volatile uint32_t *)((char *)registers + (offset)))
+static HANDLE waiting;
+static volatile LONG wait_calls, wrong_wait, missed_wake;
+static int inject_completion;
+static BOOL (WINAPI *native_wait)(volatile VOID *, PVOID, SIZE_T, DWORD);
+static VOID (WINAPI *native_wake)(PVOID);
+static uint32_t observed_sequence, observed_get;
+static unsigned observed_completions;
+
+static VOID WINAPI ordered_wake(PVOID address)
+{
+    if (observed_sequence && (uint32_t)g_notify_count == observed_sequence) {
+        CHECK(REG(NV2A_USER_DMA_GET) == observed_get);
+        CHECK(REG(NV2A_PFIFO_DMA_GET) == observed_get);
+        ++observed_completions;
+    }
+    native_wake(address);
+}
+
+static BOOL WINAPI observed_wait(volatile VOID *address, PVOID compare,
+                                 SIZE_T size, DWORD timeout)
+{
+    if (size != sizeof(LONG) || timeout != 1) InterlockedExchange(&wrong_wait, 1);
+    InterlockedIncrement(&wait_calls);
+    SetEvent(waiting);
+    if (inject_completion) {
+        inject_completion = 0;
+        nv2a_publish_consumed(registers, REG(NV2A_PFIFO_DMA_PUT), s_notify_executed);
+        /* Completion occurs after the final predicate but before registration.
+         * Waiting on the old generation must return immediately. */
+        if (!native_wait(address, compare, size, timeout))
+            InterlockedExchange(&missed_wake, 1);
+        return TRUE;
+    }
+    return native_wait(address, compare, size, timeout);
+}
+
+static DWORD WINAPI waiter(LPVOID ignored)
+{
+    (void)ignored;
+    xbox_Nv2aDmaWait(XBOX_NV2A_BASE);
+    return 0;
+}
+
+static HANDLE start_wait(void)
+{
+    ResetEvent(waiting);
+    HANDLE thread = CreateThread(NULL, 0, waiter, NULL, 0, NULL);
+    CHECK(thread && WaitForSingleObject(waiting, 5000) == WAIT_OBJECT_0);
+    return thread;
+}
+
+static void finish_wait(HANDLE thread)
+{
+    CHECK(WaitForSingleObject(thread, 5000) == WAIT_OBJECT_0);
+    CHECK(CloseHandle(thread));
+}
+
+static void test_waits(void)
+{
+    HANDLE thread;
+    unsigned before;
+    native_wait = g_nv2a_wake.wait_address;
+    CHECK(native_wait && g_nv2a_wake.wake_all);
+    g_nv2a_wake.wait_address = observed_wait;
+    waiting = CreateEventW(NULL, TRUE, FALSE, NULL);
+    CHECK(waiting);
+    g_nv2a_ack_thread = (HANDLE)(uintptr_t)1; /* API checks ownership, not handle use. */
+
+    before = wait_calls;
+    xbox_Nv2aDmaWait(XBOX_NV2A_BASE + 4); /* Unknown base keeps guest polling. */
+    xbox_Nv2aDmaWait(XBOX_NV2A_BASE);     /* Already idle requires no host wait. */
+    CHECK(wait_calls == before);
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x12000);
+    inject_completion = 1;
+    xbox_Nv2aDmaWait(XBOX_NV2A_BASE);
+    CHECK(wait_calls == before + 1 && !missed_wake && !wrong_wait);
+
+    /* A generation-only wake and an older completed boundary cannot report
+     * idle when the producer has published a newer PUT. */
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x13000);
+    thread = start_wait();
+    xbox_nv2a_wake_publish(&g_nv2a_wake);
+    CHECK(WaitForSingleObject(thread, 0) == WAIT_TIMEOUT);
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x14000);
+    nv2a_publish_consumed(registers, 0x13000, s_notify_executed);
+    CHECK(REG(NV2A_PGRAPH_STATUS) && WaitForSingleObject(thread, 0) == WAIT_TIMEOUT);
+    nv2a_publish_consumed(registers, 0x14000, s_notify_executed);
+    finish_wait(thread);
+
+    /* Even equal pointers are not idle while the original status register is
+     * nonzero. A raw guest status write has no notification; timeout notices it. */
+    REG(NV2A_PGRAPH_STATUS) = 0x80;
+    thread = start_wait();
+    CHECK(WaitForSingleObject(thread, 0) == WAIT_TIMEOUT);
+    REG(NV2A_PGRAPH_STATUS) = 0;
+    finish_wait(thread);
+
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x15000);
+    thread = start_wait();
+    InterlockedExchange(&g_nv2a_ack_stop, 1);
+    xbox_nv2a_wake_publish(&g_nv2a_wake);
+    finish_wait(thread);
+    CHECK(REG(NV2A_USER_DMA_GET) == 0x14000 && REG(NV2A_PGRAPH_STATUS));
+    g_nv2a_ack_stop = 0;
+
+    /* Native API unavailable retains the yield path and exact predicate. */
+    g_nv2a_wake.wait_address = NULL;
+    thread = CreateThread(NULL, 0, waiter, NULL, 0, NULL);
+    CHECK(thread && WaitForSingleObject(thread, 0) == WAIT_TIMEOUT);
+    nv2a_publish_consumed(registers, 0x15000, s_notify_executed);
+    finish_wait(thread);
+    g_nv2a_wake.wait_address = native_wait;
+    g_nv2a_ack_thread = NULL;
+    CHECK(CloseHandle(waiting));
+}
+
+static void test_notifications(void)
+{
+    LONG generation;
+    native_wake = g_nv2a_wake.wake_all;
+    g_nv2a_wake.wake_all = ordered_wake;
+    CHECK(xbox_Nv2aNotifyEvent(0x10000, 0x196C, 5) == 0);
+    generation = xbox_nv2a_wake_snapshot(&g_nv2a_wake);
+    xbox_Nv2aNop(0); xbox_Nv2aNop(4);
+    CHECK(!s_notify_executed && !g_notify_count);
+    xbox_Nv2aNop(5); xbox_Nv2aNop(5);
+    CHECK(s_notify_executed == 2 && !g_notify_count);
+    CHECK(xbox_nv2a_wake_snapshot(&g_nv2a_wake) == generation);
+    s_scan_incomplete = 1;
+    nv2a_publish_readback_complete(registers);
+    CHECK(!g_notify_count); /* Cap/idle cannot expose an executed NOP. */
+
+    /* A held older checkpoint captures its sequence before a newer partial
+     * submission executes another NOP. Releasing the old readback publishes
+     * only the old sequence, after the old GET, even with a newer live PUT. */
+    s_get_held = 1; s_get_held_value = 0x16000;
+    s_get_held_notify = s_notify_executed;
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x17000);
+    xbox_Nv2aNop(5);
+    readback_busy = 1;
+    nv2a_publish_readback_complete(registers);
+    CHECK(!g_notify_count && REG(NV2A_USER_DMA_GET) == 0x15000);
+    readback_busy = 0;
+    observed_sequence = 2; observed_get = 0x16000;
+    nv2a_publish_readback_complete(registers);
+    CHECK(g_notify_count == 2 && s_notify_executed == 3 && !s_get_held);
+    CHECK(REG(NV2A_USER_DMA_GET) == 0x16000 && REG(NV2A_PFIFO_DMA_GET) == 0x16000);
+    CHECK(REG(NV2A_USER_DMA_PUT) == 0x17000 && REG(NV2A_PGRAPH_STATUS));
+    nv2a_publish_readback_complete(registers);
+    CHECK(g_notify_count == 2); /* Newer capped NOP remains pending. */
+    CHECK(observed_completions);
+    observed_sequence = 3; observed_get = 0x17000;
+    nv2a_publish_consumed(registers, 0x17000, s_notify_executed);
+    CHECK(g_notify_count == 3 && !REG(NV2A_PGRAPH_STATUS));
+    s_scan_incomplete = 0;
+
+    /* Notification count is an exact unsigned event sequence across wrap. */
+    s_notify_executed = UINT32_MAX;
+    g_notify_count = -1;
+    xbox_Nv2aNop(5);
+    CHECK(s_notify_executed == 0 && g_notify_count == -1);
+    nv2a_publish_consumed(registers, 0x17000, s_notify_executed);
+    CHECK(g_notify_count == 0);
+    observed_sequence = 0;
+    g_nv2a_wake.wake_all = native_wake;
+}
+
+static volatile LONG producer_ready, producer_done;
+static DWORD WINAPI producer(LPVOID ignored)
+{
+    (void)ignored;
+    for (uint32_t i = 1; i <= 20000; ++i) {
+        xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, i);
+        InterlockedExchange(&producer_ready, (LONG)i);
+        while (InterlockedCompareExchange(&producer_done, 0, 0) != (LONG)i)
+            YieldProcessor();
+    }
+    return 0;
+}
+
+static void test_concurrent_stores(void)
+{
+    HANDLE thread = CreateThread(NULL, 0, producer, NULL, 0, NULL);
+    CHECK(thread);
+    for (LONG i = 1; i <= 20000; ++i) {
+        while (InterlockedCompareExchange(&producer_ready, 0, 0) != i)
+            YieldProcessor();
+        nv2a_publish_consumed(registers, (uint32_t)i, s_notify_executed);
+        InterlockedExchange(&producer_done, i);
+        AcquireSRWLockExclusive(&g_nv2a_dma_lock);
+        CHECK(REG(NV2A_USER_DMA_PUT) == REG(NV2A_PFIFO_DMA_PUT));
+        CHECK(REG(NV2A_USER_DMA_GET) == REG(NV2A_PFIFO_DMA_GET));
+        CHECK(REG(NV2A_PGRAPH_STATUS) ==
+            (REG(NV2A_PFIFO_DMA_PUT) != REG(NV2A_PFIFO_DMA_GET)));
+        ReleaseSRWLockExclusive(&g_nv2a_dma_lock);
+    }
+    finish_wait(thread);
+}
+
+int main(void)
+{
+    uint8_t *arena = VirtualAlloc(NULL, 0x100000, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    uint8_t *mmio = calloc(1, XBOX_NV2A_SIZE);
+    CHECK(arena && mmio);
+    g_memory_base = arena; g_memory_size = 0x100000;
+    g_memory_offset = (ptrdiff_t)arena; g_nv2a_memory = mmio;
+    registers = (volatile uint32_t *)mmio;
+    xbox_nv2a_wake_init(&g_nv2a_wake);
+
+    xbox_Nv2aDmaPublish(0x14040, 0x12345678);
+    CHECK(*(uint32_t *)(arena + 0x14040) == 0x12345678 && !g_nv2a_dma_sync);
+    CHECK(!REG(NV2A_PFIFO_DMA_PUT) && !REG(NV2A_PFIFO_DMA_GET));
+    REG(NV2A_USER_DMA_GET) = 0x11000;
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x12000);
+    CHECK(g_nv2a_dma_sync && REG(NV2A_PFIFO_DMA_GET) == 0x11000);
+    CHECK(REG(NV2A_USER_DMA_PUT) == 0x12000 && REG(NV2A_PFIFO_DMA_PUT) == 0x12000);
+    CHECK(REG(NV2A_PGRAPH_STATUS));
+    nv2a_publish_consumed(registers, 0x12000, 0);
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x12000);
+    CHECK(!REG(NV2A_PGRAPH_STATUS)); /* Same completed PUT is already idle. */
+    xbox_Nv2aDmaPublish(0x14040, 0x87654321);
+    CHECK(*(uint32_t *)(arena + 0x14040) == 0x87654321 &&
+          REG(NV2A_USER_DMA_PUT) == 0x12000 && !REG(NV2A_PGRAPH_STATUS));
+
+    /* Neither register payload nor completion order is a numeric maximum. */
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, UINT32_MAX - 3);
+    xbox_Nv2aDmaPublish(XBOX_NV2A_BASE + NV2A_USER_DMA_PUT, 0x4000);
+    nv2a_publish_consumed(registers, UINT32_MAX - 3, 0);
+    CHECK(REG(NV2A_PFIFO_DMA_GET) == UINT32_MAX - 3 && REG(NV2A_PGRAPH_STATUS));
+    nv2a_publish_consumed(registers, 0x4000, 0);
+    CHECK(REG(NV2A_USER_DMA_GET) == 0x4000 && !REG(NV2A_PGRAPH_STATUS));
+
+    test_waits();
+    test_notifications();
+    test_concurrent_stores();
+    CHECK(!wrong_wait && !missed_wake);
+    puts("PASS: exact DMA publication/consumption, software fallback, busy/wrap ordering, "
+         "concurrent stores, native wait races and deferred NOP/readback checkpoints");
+    g_nv2a_memory = NULL; g_memory_base = NULL;
+    free(mmio); CHECK(VirtualFree(arena, 0, MEM_RELEASE));
+    return 0;
+}
diff --git a/tests/kernel_dispatch/nv2a_fence_wait_test.c b/tests/kernel_dispatch/nv2a_fence_wait_test.c
new file mode 100644
index 0000000..0adeef9
--- /dev/null
+++ b/tests/kernel_dispatch/nv2a_fence_wait_test.c
@@ -0,0 +1,120 @@
+/* Direct fence waits keep the original unsigned distance predicate. */
+#include "kernel/nv2a_notify_wait.h"
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+    XBOX_NV2A_WAKE wake;
+    volatile uint32_t completed;
+    volatile LONG stop, wait_calls;
+    HANDLE started, waiting;
+    int inject;
+} FIXTURE;
+static FIXTURE *active;
+static BOOL (WINAPI *native_wait)(volatile VOID *, PVOID, SIZE_T, DWORD);
+static volatile LONG bad_timeout, missed_wake;
+
+static BOOL WINAPI measured_wait(volatile VOID *address, PVOID compare,
+                                 SIZE_T size, DWORD timeout)
+{
+    FIXTURE *f = active;
+    if (size != sizeof(LONG) || timeout != 1) InterlockedExchange(&bad_timeout, 1);
+    InterlockedIncrement(&f->wait_calls);
+    SetEvent(f->waiting);
+    if (f->inject) {
+        f->inject = 0;
+        f->completed = 1;
+        xbox_nv2a_wake_publish(&f->wake);
+        if (!native_wait(address, compare, size, timeout))
+            InterlockedExchange(&missed_wake, 1);
+        return TRUE;
+    }
+    return native_wait(address, compare, size, timeout);
+}
+
+static int initialize(FIXTURE *f)
+{
+    memset(f, 0, sizeof *f);
+    f->completed = 0xFFFFFFFEu;
+    xbox_nv2a_wake_init(&f->wake);
+    if (!f->wake.wait_address || !f->wake.wake_all) return 0;
+    native_wait = f->wake.wait_address;
+    f->wake.wait_address = measured_wait;
+    f->started = CreateEventW(NULL, TRUE, FALSE, NULL);
+    f->waiting = CreateEventW(NULL, TRUE, FALSE, NULL);
+    active = f;
+    return f->started && f->waiting;
+}
+
+static void cleanup(FIXTURE *f)
+{
+    CloseHandle(f->started);
+    CloseHandle(f->waiting);
+}
+
+static DWORD WINAPI worker(LPVOID parameter)
+{
+    FIXTURE *f = parameter;
+    SetEvent(f->started);
+    xbox_nv2a_fence_wait(&f->wake, &f->completed, 3, 2, &f->stop);
+    return 0;
+}
+
+static int concurrent_completion(unsigned kind)
+{
+    FIXTURE f;
+    HANDLE thread;
+    if (!initialize(&f)) return 0;
+    if (kind == 3) {
+        f.wake.wait_address = NULL;
+        f.wake.wake_all = NULL;
+    }
+    thread = CreateThread(NULL, 0, worker, &f, 0, NULL);
+    if (!thread) ExitProcess(20);
+    if (WaitForSingleObject(kind == 3 ? f.started : f.waiting, 5000) != WAIT_OBJECT_0)
+        ExitProcess(21);
+    xbox_nv2a_wake_publish(&f.wake); /* Wake cannot change completion rules. */
+    if (WaitForSingleObject(thread, 0) != WAIT_TIMEOUT) ExitProcess(22);
+    if (kind == 1) InterlockedExchange(&f.stop, 1);
+    else f.completed = 1;
+    if (kind != 2) xbox_nv2a_wake_publish(&f.wake);
+    if (WaitForSingleObject(thread, 5000) != WAIT_OBJECT_0) ExitProcess(23);
+    CloseHandle(thread);
+    if (kind == 1 && f.completed != 0xFFFFFFFEu) ExitProcess(24);
+    cleanup(&f);
+    return !bad_timeout && !missed_wake;
+}
+
+int main(void)
+{
+    static const struct { uint32_t submitted, completed, limit; int pending; } cases[] = {
+        { 0x1234, 0x1200, 0x20, 1 }, { 0x1234, 0x1214, 0x20, 0 },
+        { 0x1234, 0x1215, 0x20, 0 }, { 3, 0xFFFFFFFEu, 2, 1 },
+        { 3, 1, 2, 0 }, { 3, 2, 2, 0 }, { 3, 3, 2, 0 },
+        { 0xFFFFFFFEu, 1, 2, 1 }, { 0xFFFFFFFEu, 0xFFFFFFFCu, 2, 0 },
+        { 3, 2, 0, 1 }, { 3, 3, 0, 0 }, { 3, 4, 0, 1 },
+        { 3, 4, 0xFFFFFFFFu, 0 }, { 3, 0xFFFFFFFEu, 0xFFFFFFFFu, 0 }
+    };
+    FIXTURE f;
+    for (unsigned i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+        volatile uint32_t completed = cases[i].completed;
+        if (xbox_nv2a_fence_pending(&completed, cases[i].submitted, cases[i].limit)
+                != cases[i].pending || completed != cases[i].completed)
+            return 1;
+    }
+    if (!initialize(&f)) return 2;
+    f.completed = 1;
+    xbox_nv2a_fence_wait(&f.wake, &f.completed, 3, 2, &f.stop);
+    if (f.wait_calls || f.completed != 1) return 3;
+    cleanup(&f);
+    if (!initialize(&f)) return 4;
+    f.inject = 1;
+    xbox_nv2a_fence_wait(&f.wake, &f.completed, 3, 2, &f.stop);
+    if (f.wait_calls != 1 || f.completed != 1 || missed_wake || bad_timeout) return 5;
+    cleanup(&f);
+    for (unsigned kind = 0; kind < 4; kind++)
+        if (!concurrent_completion(kind)) return 6 + kind;
+    puts("PASS: exact unsigned fence distances, wrap boundaries, early completion, "
+         "check-to-wait race, spurious/stop wakes and bounded fallback");
+    return 0;
+}
diff --git a/tests/kernel_dispatch/nv2a_notify_wait_test.c b/tests/kernel_dispatch/nv2a_notify_wait_test.c
new file mode 100644
index 0000000..2f5a9a8
--- /dev/null
+++ b/tests/kernel_dispatch/nv2a_notify_wait_test.c
@@ -0,0 +1,155 @@
+/* Exercise the exact host wait helper without GPU devices or game assets. */
+#include "kernel/nv2a_notify_wait.h"
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+    XBOX_NV2A_WAKE wake;
+    volatile uint32_t get, put;
+    volatile LONG notifications, stop, ready_count, wait_calls;
+    HANDLE started, waiting;
+    int inject_completion;
+} FIXTURE;
+static FIXTURE *active_fixture;
+static BOOL (WINAPI *real_wait)(volatile VOID *, PVOID, SIZE_T, DWORD);
+static __declspec(thread) int t_wait_reported;
+static volatile LONG bad_timeout, missed_wake;
+
+static BOOL WINAPI observed_wait(volatile VOID *address, PVOID observed,
+                                 SIZE_T size, DWORD timeout)
+{
+    FIXTURE *f = active_fixture;
+    if (size != sizeof(LONG) || timeout != 1) InterlockedExchange(&bad_timeout, 1);
+    InterlockedIncrement(&f->wait_calls);
+    if (!t_wait_reported) {
+        t_wait_reported = 1;
+        InterlockedIncrement(&f->ready_count);
+        SetEvent(f->waiting);
+    }
+    /* This hook is entered AFTER the helper's second predicate check but
+     * BEFORE the native atomic wait. Its wake happens before any waiter can
+     * be registered, so an event-only implementation would lose it. */
+    if (f->inject_completion) {
+        f->inject_completion = 0;
+        f->get = f->put;
+        xbox_nv2a_wake_publish(&f->wake);
+        if (!real_wait(address, observed, size, timeout))
+            InterlockedExchange(&missed_wake, 1);
+        return TRUE;
+    }
+    return real_wait(address, observed, size, timeout);
+}
+
+static int init_fixture(FIXTURE *f)
+{
+    memset(f, 0, sizeof *f);
+    xbox_nv2a_wake_init(&f->wake);
+    if (!f->wake.wait_address || !f->wake.wake_all) return 0;
+    real_wait = f->wake.wait_address;
+    f->wake.wait_address = observed_wait;
+    f->put = 1;
+    f->started = CreateEventW(NULL, TRUE, FALSE, NULL);
+    f->waiting = CreateEventW(NULL, TRUE, FALSE, NULL);
+    active_fixture = f;
+    t_wait_reported = 0;
+    return f->started && f->waiting;
+}
+
+static void close_fixture(FIXTURE *f)
+{
+    CloseHandle(f->started);
+    CloseHandle(f->waiting);
+}
+
+static DWORD WINAPI waiter(LPVOID parameter)
+{
+    FIXTURE *f = parameter;
+    SetEvent(f->started);
+    xbox_nv2a_notify_wait(&f->wake, &f->get, &f->put,
+                         &f->notifications, 0, &f->stop);
+    return 0;
+}
+
+static int finish(HANDLE thread)
+{
+    if (WaitForSingleObject(thread, 5000) != WAIT_OBJECT_0) {
+        fprintf(stderr, "FAIL: guest wait did not complete\n");
+        /* Fixtures live on the calling stack; never return with a live user. */
+        ExitProcess(20);
+    }
+    CloseHandle(thread);
+    return !bad_timeout && !missed_wake;
+}
+
+static int completion_case(unsigned kind)
+{
+    FIXTURE f;
+    HANDLE thread;
+    if (!init_fixture(&f)) return 0;
+    if (kind == 4) { /* The host API is unavailable: retain yield fallback. */
+        f.wake.wait_address = NULL;
+        f.wake.wake_all = NULL;
+        if (!xbox_nv2a_wake_wait(&f.wake, 0)) return 0;
+    }
+    thread = CreateThread(NULL, 0, waiter, &f, 0, NULL);
+    if (!thread) return 0;
+    if (WaitForSingleObject(kind == 4 ? f.started : f.waiting, 5000) != WAIT_OBJECT_0)
+        ExitProcess(21);
+    /* A host wake alone must not pretend that the GPU completed work. */
+    xbox_nv2a_wake_publish(&f.wake);
+    if (WaitForSingleObject(thread, 0) != WAIT_TIMEOUT) ExitProcess(22);
+    if (kind == 1) InterlockedIncrement(&f.notifications);
+    else if (kind == 2) InterlockedExchange(&f.stop, 1);
+    else f.get = f.put;
+    /* Guest-origin GET changes are found through the bounded timeout even
+     * when there is no corresponding executor notification. */
+    if (kind != 3) xbox_nv2a_wake_publish(&f.wake);
+    int okay = finish(thread);
+    close_fixture(&f);
+    return okay;
+}
+
+static int multiple_waiters(void)
+{
+    FIXTURE f;
+    HANDLE threads[4];
+    DWORD started = GetTickCount();
+    if (!init_fixture(&f)) return 0;
+    for (unsigned i = 0; i < 4; i++) {
+        threads[i] = CreateThread(NULL, 0, waiter, &f, 0, NULL);
+        if (!threads[i]) ExitProcess(23);
+    }
+    while (InterlockedCompareExchange(&f.ready_count, 0, 0) != 4) {
+        if (GetTickCount() - started > 5000) ExitProcess(24);
+        Sleep(1);
+    }
+    f.get = f.put;
+    xbox_nv2a_wake_publish(&f.wake);
+    if (WaitForMultipleObjects(4, threads, TRUE, 5000) != WAIT_OBJECT_0) ExitProcess(25);
+    for (unsigned i = 0; i < 4; i++) CloseHandle(threads[i]);
+    close_fixture(&f);
+    return !bad_timeout;
+}
+
+int main(void)
+{
+    FIXTURE f;
+    if (!init_fixture(&f)) return 10;
+    f.get = f.put; /* Completed before entering the helper: no host wait. */
+    xbox_nv2a_notify_wait(&f.wake, &f.get, &f.put, &f.notifications, 0, &f.stop);
+    if (f.wait_calls != 0) return 1;
+    close_fixture(&f);
+
+    if (!init_fixture(&f)) return 11;
+    f.inject_completion = 1;
+    xbox_nv2a_notify_wait(&f.wake, &f.get, &f.put, &f.notifications, 0, &f.stop);
+    if (f.wait_calls != 1 || missed_wake || bad_timeout) return 2;
+    close_fixture(&f);
+
+    for (unsigned kind = 0; kind < 5; kind++)
+        if (!completion_case(kind)) return 3 + kind;
+    if (!multiple_waiters()) return 8;
+    puts("PASS: early completion, check-to-wait race, GET/NOP/stop wakes, "
+         "spurious wake, bounded fallback and multiple guest waiters");
+    return 0;
+}
diff --git a/tests/kernel_dispatch/nv2a_pb_hitch_test.c b/tests/kernel_dispatch/nv2a_pb_hitch_test.c
new file mode 100644
index 0000000..406c366
--- /dev/null
+++ b/tests/kernel_dispatch/nv2a_pb_hitch_test.c
@@ -0,0 +1,490 @@
+/* Use deterministic clocks and a synthetic command stream: tracing must not
+ * change decoding, callback order or guest command bytes. No GPU is started. */
+#include "kernel/kernel.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+static int64_t test_wall, test_cpu;
+static unsigned clock_calls, kick_calls;
+static uint8_t *memory;
+static uint32_t mutate_payload_va;
+static struct { uint32_t subch, method, param; } commands[64];
+static unsigned command_count;
+static unsigned snapshot_calls;
+
+static BOOL WINAPI test_qpc(LARGE_INTEGER *value)
+{
+    clock_calls++;
+    value->QuadPart = test_wall;
+    return TRUE;
+}
+
+static BOOL WINAPI test_frequency(LARGE_INTEGER *value)
+{
+    value->QuadPart = 1000000;
+    return TRUE;
+}
