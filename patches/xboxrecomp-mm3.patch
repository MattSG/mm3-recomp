diff --git a/tests/dsp/dsp_interrupt_fastpath_test.c b/tests/dsp/dsp_interrupt_fastpath_test.c
new file mode 100644
index 0000000..f0adcc2
--- /dev/null
+++ b/tests/dsp/dsp_interrupt_fastpath_test.c
@@ -0,0 +1,59 @@
+/* Compare the instruction-boundary fast path with the unchanged full handler.
+ * Include the production source to exercise its private interrupt pipeline
+ * without exposing an extra runtime API or substituting an interrupt model. */
+#include "../../src/apu/dsp/interp/dsp_cpu.c"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "Interrupt fast-path check line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+int main(void)
+{
+    dsp_core_t *initial = calloc(1, sizeof *initial);
+    dsp_core_t *reference = malloc(sizeof *reference);
+    dsp_core_t *actual = malloc(sizeof *actual);
+    CHECK(initial && reference && actual);
+    dsp56k_reset_cpu(initial);
+    initial->pc = 0x100;
+    initial->interrupt_save_pc = 0x101;
+    initial->interrupt_instr_fetch = 8;
+    initial->interrupt_ipl_to_raise = 2;
+    initial->registers[DSP_REG_LC] = 3;
+    initial->registers[DSP_REG_LA] = 0x110;
+    /* Long-vector entry exercises stack and SR changes during the pipeline. */
+    initial->pram[8] = 0x0d0200;
+    initial->pram[9] = 0;
+
+    const unsigned pending_masks[] = {0, 1, 8, 15};
+    unsigned cases = 0;
+    for (unsigned state = DSP_INTERRUPT_NONE; state <= DSP_INTERRUPT_LONG; ++state)
+    for (unsigned pipeline = 0; pipeline <= 6; ++pipeline)
+    for (unsigned rep = 0; rep <= 2; ++rep)
+    for (unsigned flags = 0; flags < 8; ++flags)
+    for (unsigned compatibility = 0; compatibility < 2; ++compatibility)
+    for (unsigned mask = 0; mask < ARRAY_SIZE(pending_masks); ++mask) {
+        *reference = *initial;
+        reference->interrupt_state = (uint16_t)state;
+        reference->interrupt_pipeline_count = (uint16_t)pipeline;
+        reference->loop_rep = rep;
+        reference->is_stopped = (flags & 1) != 0;
+        reference->is_debugging = (flags & 2) != 0;
+        reference->is_waiting = (flags & 4) != 0;
+        reference->registers[DSP_REG_SR] =
+            (compatibility << DSP_SR_SC) | ((pipeline & 3) << DSP_SR_I0);
+        reference->interrupt_counter = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            reference->interrupt_is_pending[i] = (pending_masks[mask] >> i) & 1;
+            reference->interrupt_counter += reference->interrupt_is_pending[i];
+            reference->interrupt_ipl[i] = (int16_t)i;
+        }
+        *actual = *reference;
+        dsp_postexecute_interrupts(reference);
+        dsp_postexecute_interrupts_if_needed(actual);
+        CHECK(!memcmp(reference, actual, sizeof *actual));
+        ++cases;
+    }
+    printf("Interrupt fast path exact full-state equivalence passed: %u cases\n", cases);
+    free(initial); free(reference); free(actual);
+    return 0;
+}
diff --git a/tests/dsp/dsp_pcm_queue_test.c b/tests/dsp/dsp_pcm_queue_test.c
new file mode 100644
index 0000000..b379753
--- /dev/null
+++ b/tests/dsp/dsp_pcm_queue_test.c
@@ -0,0 +1,120 @@
+#include "apu_state.h"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "PCM queue check failed at line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg;
+int dsp_test_fail_alloc;
+uint8_t *g_apu_ram_ptr;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    (void)address;
+    CHECK(0); /* Queue-only checks must not read or write guest memory. */
+    return NULL;
+}
+
+extern uint64_t dsp_test_pcm_allocations, dsp_test_pcm_copied, dsp_test_pcm_moved;
+void dsp_test_publish_pcm_frame(MCPXAPUState *d, const uint8_t *pcm);
+
+static void fill_frame(uint8_t *frame, unsigned sequence)
+{
+    for (unsigned i = 0; i < 1024; i++)
+        frame[i] = (uint8_t)(sequence * 17 + i * 23 + (sequence >> 8));
+}
+
+static void publish(MCPXAPUState *d, unsigned sequence)
+{
+    uint8_t frame[1024];
+    fill_frame(frame, sequence);
+    dsp_test_publish_pcm_frame(d, frame);
+}
+
+static void check_frame(MCPXAPUState *d, unsigned sequence)
+{
+    uint8_t frame[1024];
+    fill_frame(frame, sequence);
+    CHECK(!memcmp(d->monitor.frame_buf, frame, sizeof(frame)));
+}
+
+int main(void)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    CHECK(d);
+
+    /* Move the head, wrap at the old end, fail a growth, then grow the
+     * wrapped queue. Every retained frame must remain in its original order. */
+    for (unsigned i = 0; i < 5; i++) publish(d, i);
+    CHECK(d->monitor.ep_pcm_capacity == 4096);
+    for (unsigned i = 0; i < 3; i++) {
+        check_frame(d, i);
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+    for (unsigned i = 5; i < 8; i++) publish(d, i);
+    uint64_t dropped = d->monitor.ep_pcm_dropped_frames;
+    dsp_test_fail_alloc = 1;
+    publish(d, 99);
+    dsp_test_fail_alloc = 0;
+    CHECK(d->monitor.ep_pcm_capacity == 4096);
+    CHECK(d->monitor.ep_pcm_queued == 4096);
+    CHECK(d->monitor.ep_pcm_dropped_frames == dropped + 1);
+    publish(d, 8);
+    CHECK(d->monitor.ep_pcm_capacity == 8192);
+    for (unsigned i = 3; i < 9; i++) {
+        check_frame(d, i);
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+    CHECK(!d->monitor.ep_pcm_ready && !d->monitor.ep_pcm_queued);
+    CHECK(!d->monitor.ep_pcm_head);
+
+    /* Compare a stream of bursts, consumes and overflows to an independent
+     * FIFO model. The model stores sequence numbers rather than PCM offsets. */
+    unsigned model[65], count = 0;
+    uint32_t random = 0x762d81ab;
+    for (unsigned sequence = 0; sequence < 20000; sequence++) {
+        random = random * 1664525u + 1013904223u;
+        if ((random >> 28) < 5) {
+            if (count) {
+                check_frame(d, model[0]);
+                memmove(model, model + 1, --count * sizeof(*model));
+            }
+            mcpx_apu_dsp_pcm_consumed(d);
+        } else {
+            uint64_t drops_before = d->monitor.ep_pcm_dropped_frames;
+            publish(d, sequence);
+            if (count < 65) {
+                model[count++] = sequence;
+                CHECK(d->monitor.ep_pcm_dropped_frames == drops_before);
+            } else CHECK(d->monitor.ep_pcm_dropped_frames == drops_before + 1);
+        }
+        CHECK(d->monitor.ep_pcm_ready == (count != 0));
+        CHECK(d->monitor.ep_pcm_queued == (count ? count - 1 : 0) * 1024);
+        CHECK(d->monitor.ep_pcm_capacity <= 65536);
+        if (count) check_frame(d, model[0]);
+    }
+    while (count) {
+        check_frame(d, model[0]);
+        memmove(model, model + 1, --count * sizeof(*model));
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+
+    /* Consumption copies only the next frame even with a full backlog.
+     * Allocation growth from zero through 64 frames takes seven allocations. */
+    free(d->monitor.ep_pcm_queue);
+    memset(&d->monitor, 0, sizeof(d->monitor));
+    dsp_test_pcm_allocations = dsp_test_pcm_copied = dsp_test_pcm_moved = 0;
+    for (unsigned i = 0; i < 65; i++) publish(d, i);
+    CHECK(dsp_test_pcm_allocations == 7);
+    CHECK(d->monitor.ep_pcm_queued == 65536);
+    dsp_test_pcm_copied = dsp_test_pcm_moved = 0;
+    for (unsigned i = 0; i < 65; i++) {
+        check_frame(d, i);
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+    CHECK(dsp_test_pcm_copied == 65536 && !dsp_test_pcm_moved);
+    printf("PCM queue: ordered wrap/growth/OOM/bursts; 7 growth allocations, "
+           "65536 copied bytes and 0 shifted bytes for a 64-frame drain\n");
+    free(d->monitor.ep_pcm_queue);
+    free(d);
+    return 0;
+}
diff --git a/tests/dsp/hrtf_filter_test.c b/tests/dsp/hrtf_filter_test.c
new file mode 100644
index 0000000..192774a
--- /dev/null
+++ b/tests/dsp/hrtf_filter_test.c
@@ -0,0 +1,97 @@
+/* Compare the production HRTF filter with its prior modulo-index reference.
+ * Every coefficient/history/PCM byte must match; no tolerance or reordered
+ * floating arithmetic can hide an audible behavior change. */
+#include "../../src/apu/apu_state.h"
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "HRTF check line %d: %s\n", __LINE__, #condition); exit(1); } } while (0)
+
+static void reference_process(HrtfFilter *f, float in[][2], float out[][2])
+{
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; n++) {
+        hrtf_filter_step_parameters(f);
+        for (int ch = 0; ch < 2; ch++) {
+            float *buf = f->ch[ch].buf;
+            float *coeff = f->ch[ch].hrir_coeff_cur;
+            buf[f->buf_pos] = in[n][ch];
+            float d = f->itd_cur * (ch == 0 ? +1.0f : -1.0f);
+            if (d < 0.0f) d = 0.0f;
+            int di = (int)d;
+            float dfrac = d - di;
+            float acc = 0.0f;
+            for (int k = 0; k < HRTF_NUM_TAPS; k++) {
+                int idx1 = (f->buf_pos - di - k + HRTF_BUFLEN) % HRTF_BUFLEN;
+                float s = buf[idx1];
+                if (dfrac > 0.0f) {
+                    int idx2 = (idx1 - 1 + HRTF_BUFLEN) % HRTF_BUFLEN;
+                    s = s * (1 - dfrac) + buf[idx2] * dfrac;
+                }
+                acc += coeff[k] * s;
+            }
+            out[n][ch] = acc;
+        }
+        f->buf_pos = (f->buf_pos + 1) % HRTF_BUFLEN;
+    }
+}
+
+static uint32_t random_state = 0x12345678;
+static float value(void)
+{
+    random_state = random_state * 1664525u + 1013904223u;
+    return ((int32_t)(random_state >> 8) - 0x7fffff) / 8388608.0f;
+}
+static void initialize(HrtfFilter *filter, int position, float current, float target)
+{
+    hrtf_filter_init(filter);
+    filter->buf_pos = position;
+    filter->itd_cur = current; filter->itd_tar = target;
+    for (int ch = 0; ch < 2; ++ch) {
+        for (int i = 0; i < HRTF_BUFLEN; ++i) filter->ch[ch].buf[i] = value();
+        for (int i = 0; i < HRTF_NUM_TAPS; ++i) {
+            filter->ch[ch].hrir_coeff_cur[i] = value() / 31;
+            filter->ch[ch].hrir_coeff_tar[i] = value() / 31;
+        }
+    }
+}
+static void input(float data[HRTF_SAMPLES_PER_FRAME][2], unsigned kind)
+{
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; ++n)
+        for (int ch = 0; ch < 2; ++ch)
+            data[n][ch] = kind == 0 ? 0.0f : kind == 1 ? (n == 0 ? 1.0f : 0.0f) : value();
+}
+int main(void)
+{
+    const float delays[] = {-42, -41.999f, -41.5f, -20.75f, -1.5f, -1, -0.5f,
+                            -0.0f, 0, 0.25f, 1, 1.5f, 20.5f, 41.5f, 41.999f, 42};
+    unsigned frames = 0;
+    for (int position = 0; position < HRTF_BUFLEN; ++position)
+    for (unsigned delay = 0; delay < sizeof delays / sizeof delays[0]; ++delay)
+    for (unsigned transition = 0; transition < 4; ++transition)
+    for (unsigned inplace = 0; inplace < 2; ++inplace) {
+        float target = transition == 0 ? delays[delay] : transition == 1 ? -42 : transition == 2 ? 42 : 0;
+        HrtfFilter reference, actual;
+        initialize(&reference, position, delays[delay], target); actual = reference;
+        for (unsigned frame = 0; frame < 4; ++frame) {
+            float left[HRTF_SAMPLES_PER_FRAME][2], right[HRTF_SAMPLES_PER_FRAME][2];
+            float left_out[HRTF_SAMPLES_PER_FRAME][2], right_out[HRTF_SAMPLES_PER_FRAME][2];
+            input(left, frame % 3); memcpy(right, left, sizeof left);
+            if (inplace) {
+                reference_process(&reference, left, left);
+                hrtf_filter_process(&actual, right, right);
+                CHECK(!memcmp(left, right, sizeof left));
+            } else {
+                reference_process(&reference, left, left_out);
+                hrtf_filter_process(&actual, right, right_out);
+                CHECK(!memcmp(left_out, right_out, sizeof left_out));
+                CHECK(!memcmp(left, right, sizeof left));
+            }
+            CHECK(!memcmp(&reference, &actual, sizeof reference));
+            ++frames;
+        }
+    }
+    printf("HRTF exact state/PCM equivalence passed: %u frames\n", frames);
+    return 0;
+}
diff --git a/tests/dsp/vp_attenuation_test.c b/tests/dsp/vp_attenuation_test.c
new file mode 100644
index 0000000..aa08d7c
--- /dev/null
+++ b/tests/dsp/vp_attenuation_test.c
@@ -0,0 +1,143 @@
+/* Compile the production VP so this covers its initialization and lookup,
+ * including reset behavior. Compare every uint16_t input against the former
+ * formula, with exact float and mixed PCM equality rather than a tolerance. */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t pow_calls;
+static float counted_powf(float base, float exponent)
+{
+    ++pow_calls;
+    return powf(base, exponent);
+}
+#define powf counted_powf
+#include "../../src/apu/apu_vp.c"
+#undef powf
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "VP attenuation check line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+uint8_t *g_apu_ram_ptr;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    (void)address;
+    CHECK(0); /* No guest-memory access is needed for volume conversion. */
+    return NULL;
+}
+
+static float reference_attenuate(uint16_t volume)
+{
+    volume &= 0xFFF;
+    return volume == 0xFFF ? 0.0f : powf(10.0f, volume / (64.0f * -20.0f));
+}
+
+static void check_all_inputs(MCPXAPUState *d)
+{
+    float expected_pcm[32], actual_pcm[32];
+    int16_t expected_s16[32], actual_s16[32];
+    for (unsigned input = 0; input <= UINT16_MAX; ++input) {
+        float expected = reference_attenuate((uint16_t)input);
+        float actual = attenuate(d, (uint16_t)input);
+        CHECK(!memcmp(&expected, &actual, sizeof(expected)));
+        for (unsigned sample = 0; sample < 32; ++sample) {
+            float pcm = (float)((int)sample - 16) / 16.0f;
+            float start = (input & 1) ? 0.0f : 1.0f;
+            expected_pcm[sample] = (start + (expected - start) / 32 * (sample + 1)) * pcm;
+            actual_pcm[sample] = (start + (actual - start) / 32 * (sample + 1)) * pcm;
+        }
+        CHECK(!memcmp(expected_pcm, actual_pcm, sizeof(expected_pcm)));
+        src_float_to_short_array(expected_pcm, expected_s16, 32);
+        src_float_to_short_array(actual_pcm, actual_s16, 32);
+        CHECK(!memcmp(expected_s16, actual_s16, sizeof(expected_s16)));
+    }
+}
+
+static __declspec(noinline) float bench_reference(const volatile uint16_t *inputs, unsigned count)
+{
+    float sum = 0.0f;
+    for (unsigned repeat = 0; repeat < 1024; ++repeat)
+        for (unsigned i = 0; i < count; ++i)
+            sum += reference_attenuate(inputs[i]);
+    return sum;
+}
+
+static __declspec(noinline) float bench_cached(MCPXAPUState *d, const volatile uint16_t *inputs, unsigned count)
+{
+    float sum = 0.0f;
+    for (unsigned repeat = 0; repeat < 1024; ++repeat)
+        for (unsigned i = 0; i < count; ++i)
+            sum += attenuate(d, inputs[i]);
+    return sum;
+}
+
+static void benchmark(MCPXAPUState *d)
+{
+    uint16_t inputs[8192];
+    uint32_t random = 0x12345678;
+    LARGE_INTEGER frequency, begin, middle, end;
+    QueryPerformanceFrequency(&frequency);
+    for (unsigned i = 0; i < 8192; ++i) {
+        random = random * 1664525u + 1013904223u;
+        inputs[i] = (uint16_t)(random >> 16);
+    }
+    for (unsigned trial = 0; trial < 5; ++trial) {
+        QueryPerformanceCounter(&begin);
+        float before = bench_reference(inputs, 8192);
+        QueryPerformanceCounter(&middle);
+        float after = bench_cached(d, inputs, 8192);
+        QueryPerformanceCounter(&end);
+        CHECK(!memcmp(&before, &after, sizeof(before)));
+        printf("trial=%u calls=8388608 reference_ms=%.3f cached_ms=%.3f sum=%.9g\n",
+               trial + 1, 1000.0 * (middle.QuadPart - begin.QuadPart) / frequency.QuadPart,
+               1000.0 * (end.QuadPart - middle.QuadPart) / frequency.QuadPart, after);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    MCPXAPUState *other = calloc(1, sizeof(*other));
+    CHECK(d && other);
+    mcpx_apu_vp_init(d);
+    CHECK(pow_calls == 4095);
+    check_all_inputs(d);
+    CHECK(pow_calls == 4095);
+    CHECK(attenuate(d, 0) == 1.0f && attenuate(d, 0xFFF) == 0.0f);
+    CHECK(attenuate(d, 0xFFE) > 0.0f);
+    mcpx_apu_vp_reset(d);
+    check_all_inputs(d);
+    CHECK(pow_calls == 4095);
+    mcpx_apu_vp_init(other);
+    CHECK(pow_calls == 8190);
+    CHECK(!memcmp(d->vp.attenuation, other->vp.attenuation, sizeof(d->vp.attenuation)));
+    {
+        int saved_rounding = fegetround();
+        const int modes[] = {FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO, FE_TONEAREST};
+        float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME] = {{0}};
+        d->regs[NV_PAPU_TVL2D] = d->regs[NV_PAPU_TVL3D] = d->regs[NV_PAPU_TVLMP] = 0xFFFF;
+        for (unsigned mode = 0; mode < sizeof(modes) / sizeof(modes[0]); ++mode) {
+            CHECK(!fesetround(modes[mode]));
+            mcpx_apu_vp_frame(d, mixbins);
+            uint64_t warmed_calls = pow_calls;
+            check_all_inputs(d);
+            mcpx_apu_vp_frame(d, mixbins);
+            CHECK(pow_calls == warmed_calls);
+        }
+        CHECK(!fesetround(saved_rounding));
+        mcpx_apu_vp_frame(d, mixbins);
+    }
+    if (argc > 1 && !strcmp(argv[1], "--bench")) benchmark(d);
+    puts("PASS: 65536 encodings in all 4 rounding modes, gain ramps/PCM, reset, separate instances; no warm powf calls");
+    mcpx_apu_vp_finalize(d);
+    mcpx_apu_vp_finalize(other);
+    free(other);
+    free(d);
+    return 0;
+}
