diff --git a/tests/nv2a_shader_lookup/README.md b/tests/nv2a_shader_lookup/README.md
new file mode 100644
index 0000000..11cb680
--- /dev/null
+++ b/tests/nv2a_shader_lookup/README.md
@@ -0,0 +1,52 @@
+# Exact shader lookup and vertex upload retries
+
+The three CPU lookup regressions use the production `spec_find`/`spec_request`
+helpers. They check every byte of a key, a deliberately selected hash-bucket
+collision, queued/claimed/ready/failed transitions, publication from another
+thread, all 4096 occupied slots, live-queue saturation/retry, prewarm promotion,
+deduplication and table allocation replacement. An EMPTY slot is never retained
+as a negative lookup result.
+
+The five GPU regressions run on the renderer's selected D3D11 adapter. They feed
+valid NV2A instructions (`MOV oPos,v0; MOV oD0,c[n]; END`) and real float
+constant arrays into the normal interpreted vertex shader, then inspect actual
+render-target pixels. Red/green/blue outputs independently prove that the new
+program or constants were consumed. Cases cover:
+
+- Initial version zero, including failures of the initial program, constant and
+  per-draw buffer Maps followed by successful retries of that same version.
+- Failed changed program and changed constants Maps, including successful
+  program upload followed by failed constant upload.
+- Failed per-draw vertex constants, with no stale-offset draw.
+- Real raw/index ring DISCARD wraps, failed raw/index Maps and subsequent
+  NO_OVERWRITE reuse. Abandoned uploads never advance past an undrawn span;
+  a wrap still resets its cursor to the start of the new backing allocation.
+
+For worker scheduling and all four specialized shader variants, also run the
+existing `tests/nv2a_ps_prewarm` GPU/scheduler suite. Shader bytecode SHA keys,
+manifest schema/family identity and graphics output are unchanged.
+
+From the game repository after loading `scripts/enter-env.ps1`:
+
+```powershell
+cmake -S tools/xboxrecomp/tests/nv2a_shader_lookup -B conformance_tmp/stutter-shader-lookup-test -G Ninja -DCMAKE_BUILD_TYPE=Release
+cmake --build conformance_tmp/stutter-shader-lookup-test
+ctest --test-dir conformance_tmp/stutter-shader-lookup-test --output-on-failure
+./conformance_tmp/stutter-shader-lookup-test/nv2a_shader_lookup.exe benchmark conformance_tmp/texture-stutter-shader-cache
+```
+
+The optional benchmark loads a complete manifest using the production
+source/family/schema/SHA/exact-length validation. It prints the actual record
+count and compares the original serial FNV index, an exact previous-key front
+cache, the existing scalar four-lane hash as an index, their combination, and
+the final production lookup. It alternates candidate order, consumes every
+result through opaque noinline functions and reports nine-sample medians; no
+timing threshold is part of CTest. No private manifest records are committed.
+
+On the Ryzen 9 PRO 7940HS, the final isolated run used 148 valid 216-byte keys
+and 4096 slots. Original FNV lookup cost 176–178 ns. Production combined lookup
+cost 6.14 ns for one repeated key, 13.95 ns for four draws per key and 38.21 ns
+for all keys alternating. This saves approximately 0.12–0.15 ms per 850 lookups
+in these synthetic patterns. It does not establish a whole-game frame-rate or
+hitch improvement. The four-lane hash changes only bucket selection; exact
+key comparison resolves collisions and the front cache rereads published state.
diff --git a/tests/nv2a_shader_lookup/test_shader_lookup.c b/tests/nv2a_shader_lookup/test_shader_lookup.c
new file mode 100644
index 0000000..a1b5353
--- /dev/null
+++ b/tests/nv2a_shader_lookup/test_shader_lookup.c
@@ -0,0 +1,177 @@
+/* Benchmark candidate table indexing on validated real learned PS keys. */
+#include "../../src/video/nv2a_d3d11.c"
+ptrdiff_t xbox_GetMemoryOffset(void) { return 0; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va,uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t n) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start,uint32_t *version))[4] { return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { return NULL; }
+#define CHECK(x) do { if(!(x)) {fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);exit(1);} } while(0)
+
+static PsKey number(unsigned i) { PsKey k={0};k.fin0=i;return k; }
+static void fixture(void)
+{
+    s_spec=calloc(PS_SPEC_SLOTS,sizeof *s_spec);CHECK(s_spec);
+    InitializeCriticalSection(&s_spec_cs);InitializeConditionVariable(&s_spec_cv);
+    s_spec_head=s_spec_tail=s_spec_warm_head=s_spec_warm_tail=0;
+}
+static PsSpec *ready(const PsKey *key)
+{
+    PsSpec *e=spec_find(key);CHECK(e);
+    e->key=*key;e->ps=(ID3D11PixelShader *)e;InterlockedExchange(&e->state,2);return e;
+}
+static DWORD WINAPI publish(void *arg)
+{
+    PsSpec *e=(PsSpec *)arg;Sleep(1);e->ps=(ID3D11PixelShader *)e;
+    InterlockedExchange(&e->state,2);return 0;
+}
+static void test_lookup(void)
+{
+    PsKey k=number(1);PsSpec *first=ready(&k),*e;unsigned i;
+    CHECK(spec_find(&k)==first && spec_request(&k,0)==first->ps);
+    /* Every key byte participates in identity, regardless of hash collisions. */
+    for(i=0;i<sizeof k;i++) {
+        PsKey changed=k;((uint8_t *)&changed)[i]^=0x80;e=ready(&changed);
+        CHECK(e!=first && spec_find(&changed)==e && spec_find(&k)==first);
+    }
+    /* Ready publication must become visible to repeated front-cache requests. */
+    k=number(900);CHECK(!spec_request(&k,0));e=spec_find(&k);CHECK(e->state==1);
+    InterlockedExchange(&e->state,4);CHECK(!spec_request(&k,0));
+    e->ps=(ID3D11PixelShader *)e;InterlockedExchange(&e->state,2);
+    CHECK(spec_request(&k,0)==e->ps);InterlockedExchange(&e->state,3);
+    CHECK(!spec_request(&k,0));
+    k=number(901);CHECK(!spec_request(&k,0));e=spec_find(&k);
+    InterlockedExchange(&e->state,4);
+    {
+        HANDLE worker=CreateThread(NULL,0,publish,e,0,NULL);DWORD until=GetTickCount()+5000;
+        CHECK(worker);
+        while(!spec_request(&k,0) && (LONG)(GetTickCount()-until)<0) SwitchToThread();
+        CHECK(WaitForSingleObject(worker,5000)==WAIT_OBJECT_0 && spec_request(&k,0)==e->ps);
+        CloseHandle(worker);
+    }
+    /* Force an actual four-lane bucket collision, not just random coverage. */
+    {
+        uint64_t h=hash_mem((const uint8_t *)&k,sizeof k);unsigned bucket=(unsigned)(h^(h>>32))&(PS_SPEC_SLOTS-1);
+        PsKey other;PsSpec *a=ready(&k),*b;
+        for(i=902;i<100000;i++) {other=number(i);h=hash_mem((const uint8_t *)&other,sizeof other);
+            if(((unsigned)(h^(h>>32))&(PS_SPEC_SLOTS-1))==bucket) break;}
+        CHECK(i<100000);b=ready(&other);CHECK(a!=b && spec_find(&k)==a && spec_find(&other)==b);
+    }
+    puts("PASS: complete exact-key identity and queued/claimed/ready/failed state publication on repeated lookups");
+}
+static void test_full(void)
+{
+    unsigned i;PsKey k;
+    for(i=0;i<PS_SPEC_SLOTS;i++) {k=number(i);ready(&k);}
+    k=number(17);PsSpec *old=spec_find(&k);CHECK(old && spec_find(&k)==old);
+    k=number(PS_SPEC_SLOTS+1);CHECK(!spec_find(&k) && !spec_request(&k,0));
+    for(i=0;i<PS_SPEC_SLOTS;i++) {k=number(i);CHECK(spec_find(&k) && !memcmp(&spec_find(&k)->key,&k,sizeof k));}
+    puts("PASS: actual 4096-entry table saturation returns NULL for missing keys and retains every existing key");
+}
+static void test_queue(void)
+{
+    PsKey k=number(1);PsSpec *e;
+    s_spec_head=PS_SPEC_QUEUE;s_spec_tail=0;
+    CHECK(!spec_request(&k,0));e=spec_find(&k);CHECK(e && e->state==0);
+    CHECK(!spec_request(&k,0) && spec_find(&k)->state==0);
+    s_spec_tail=1;CHECK(!spec_request(&k,0));CHECK(e->state==1);
+    CHECK(s_spec_q[0]==e && s_spec_head==PS_SPEC_QUEUE+1);
+    /* Prewarmed queued work must still promote to the live queue. */
+    k=number(2);CHECK(!spec_request(&k,1));e=spec_find(&k);CHECK(e->prewarm && !e->promoted);
+    CHECK(!spec_request(&k,0) && !e->promoted); /* Live queue is full. */
+    s_spec_tail=2;CHECK(!spec_request(&k,0));CHECK(e->promoted && s_spec_q[1]==e);
+    CHECK(!spec_request(&k,0) && s_spec_head==PS_SPEC_QUEUE+2);
+    /* Reinitialize like standalone scheduler tests do: an old front pointer
+     * must never survive a changed allocation or cache a fresh EMPTY slot. */
+    k=number(999);ready(&k);CHECK(spec_find(&k)->state==2);
+    DeleteCriticalSection(&s_spec_cs);free(s_spec);fixture();
+    e=spec_find(&k);CHECK(e && e->state==0);CHECK(!spec_request(&k,0) && e->state==1);
+    puts("PASS: queue-full EMPTY lookup remains retryable, warm live promotion survives full queue and repeated requests deduplicate");
+}
+
+typedef PsSpec *(*Lookup)(const PsKey *);
+static PsSpec *table,*last;
+static uint32_t fnv(const PsKey *key)
+{
+    uint32_t h=2166136261u;unsigned i;const uint8_t *p=(const uint8_t *)key;
+    for(i=0;i<sizeof *key;i++) h=(h^p[i])*16777619u;return h;
+}
+static uint32_t lanes(const PsKey *key)
+{uint64_t h=hash_mem((const uint8_t *)key,sizeof *key);return (uint32_t)(h^(h>>32));}
+static PsSpec *find_hash(const PsKey *key,int four_lanes)
+{
+    uint32_t h=four_lanes?lanes(key):fnv(key),i;
+    for(i=0;i<PS_SPEC_SLOTS;i++) {
+        PsSpec *e=&table[(h+i)&(PS_SPEC_SLOTS-1)];
+        if(!InterlockedCompareExchange(&e->state,0,0)||!memcmp(&e->key,key,sizeof *key)) return e;
+    }
+    return NULL;
+}
+static __declspec(noinline) PsSpec *baseline(const PsKey *key) {return find_hash(key,0);}
+static __declspec(noinline) PsSpec *four_lane(const PsKey *key) {return find_hash(key,1);}
+static PsSpec *find_front(const PsKey *key,int four_lanes)
+{
+    PsSpec *e;
+    if(last && InterlockedCompareExchange(&last->state,0,0) && !memcmp(&last->key,key,sizeof *key)) return last;
+    e=find_hash(key,four_lanes);
+    if(e && InterlockedCompareExchange(&e->state,0,0)) last=e;
+    return e;
+}
+static __declspec(noinline) PsSpec *front(const PsKey *key) {return find_front(key,0);}
+static __declspec(noinline) PsSpec *combined(const PsKey *key) {return find_front(key,1);}
+static __declspec(noinline) PsSpec *production(const PsKey *key) {return spec_find(key);}
+static volatile uintptr_t sink;
+static __declspec(noinline) double measure(Lookup lookup,const PsKey *keys,unsigned count,unsigned batch)
+{
+    LARGE_INTEGER f;int64_t start;unsigned i;const unsigned iterations=200000;
+    QueryPerformanceFrequency(&f);start=qpc();
+    for(i=0;i<iterations;i++) sink^=(uintptr_t)lookup(&keys[(i/batch)%count]);
+    return (qpc()-start)*1e9/f.QuadPart/iterations;
+}
+static void benchmark(const char *cache)
+{
+    wchar_t path[NV_SHADER_CACHE_PATH];uint8_t family[32];
+    uint32_t records[NV_PS_MANIFEST_LIMIT][NV_PS_MANIFEST_WORDS];
+    PsKey keys[NV_PS_MANIFEST_LIMIT];unsigned count=0,i,kind,pattern,sample,j;
+    PsSpec *tables[5];Lookup lookup[5]={baseline,front,four_lane,combined,production};
+    const char *names[5]={"FNV","FNV+front","four-lane","four-lane+front","production"};
+    double timings[5][9];
+    if(cache) CHECK(!_putenv_s("RECOMP_SHADER_CACHE_DIR",cache));
+    _putenv_s("RECOMP_SHADER_CACHE","1");spec_family(family);
+    CHECK(nv_ps_manifest_path(family,path) && nv_ps_manifest_read(path,family,records,&count) && count);
+    for(i=0;i<count;i++) {CHECK(records[i][41]<=3);memcpy(&keys[i],records[i],sizeof(PsKey));}
+    printf("LOOKUP actual validated manifest: %u keys, %zu-byte keys, %u slots, schema %u; source/family/SHA/length validated\n",
+           count,sizeof(PsKey),PS_SPEC_SLOTS,NV_PS_MANIFEST_SCHEMA);
+    for(kind=0;kind<5;kind++) {
+        table=s_spec=tables[kind]=calloc(PS_SPEC_SLOTS,sizeof(PsSpec));CHECK(table);last=NULL;
+        for(i=0;i<count;i++) {PsSpec *e=lookup[kind](&keys[i]);CHECK(e);e->key=keys[i];InterlockedExchange(&e->state,2);}
+        for(i=0;i<count;i++) CHECK(!memcmp(&lookup[kind](&keys[i])->key,&keys[i],sizeof(PsKey)));
+    }
+    for(pattern=0;pattern<3;pattern++) {
+        unsigned n=pattern==0?1:count,batch=pattern==1?4:1;
+        for(sample=0;sample<9;sample++) for(j=0;j<5;j++) {
+            kind=(sample+j)%5;table=s_spec=tables[kind];last=NULL;
+            timings[kind][sample]=measure(lookup[kind],keys,n,batch);
+        }
+        printf("LOOKUP pattern=%s, median of 9 x 200000 calls:\n",pattern==0?"one repeated key":pattern==1?"4 draws/key":"all keys alternating");
+        for(kind=0;kind<5;kind++) {
+            for(i=0;i<9;i++) for(j=i+1;j<9;j++) if(timings[kind][j]<timings[kind][i]) {
+                double t=timings[kind][i];timings[kind][i]=timings[kind][j];timings[kind][j]=t;
+            }
+            printf("  %-16s %.2f ns/call, %.3f ms total, %.3f ms/850 draws\n",names[kind],timings[kind][4],timings[kind][4]*.2,timings[kind][4]*850/1e6);
+        }
+    }
+    for(kind=0;kind<5;kind++) free(tables[kind]);s_spec=NULL;
+}
+int main(int argc,char **argv)
+{
+    CHECK(argc>=2);
+    if(!strcmp(argv[1],"benchmark")) {benchmark(argc>2?argv[2]:NULL);return 0;}
+    fixture();
+    if(!strcmp(argv[1],"lookup")) test_lookup();
+    else if(!strcmp(argv[1],"full")) test_full();
+    else if(!strcmp(argv[1],"queue")) test_queue();
+    else CHECK(0);
+    return 0;
+}
diff --git a/tests/nv2a_shader_lookup/test_vertex_retry.c b/tests/nv2a_shader_lookup/test_vertex_retry.c
new file mode 100644
index 0000000..510b04e
--- /dev/null
+++ b/tests/nv2a_shader_lookup/test_vertex_retry.c
@@ -0,0 +1,161 @@
+/* Failed dynamic uploads must never draw stale vertex programs/constants. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_1.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static ID3D11Resource *fail_resource;
+static unsigned draws, maps_program, maps_constants, maps_ub;
+static HRESULT map_resource(ID3D11DeviceContext *,ID3D11Resource *,UINT,D3D11_MAP,UINT,D3D11_MAPPED_SUBRESOURCE *);
+static void draw_indexed(ID3D11DeviceContext *c,UINT n,UINT start,INT base)
+{ draws++;c->lpVtbl->DrawIndexed(c,n,start,base); }
+#undef ID3D11DeviceContext_Map
+#undef ID3D11DeviceContext_DrawIndexed
+#define ID3D11DeviceContext_Map map_resource
+#define ID3D11DeviceContext_DrawIndexed draw_indexed
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x100000];
+static uint32_t instructions[136][4],program_version,constant_version;
+static float constants[192][4];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va,uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t n) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start,uint32_t *version))[4]
+{ *start=0;*version=program_version;return (const uint32_t (*)[4])instructions; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{ *version=constant_version;return (const float (*)[4])constants; }
+#define CHECK(x) do { if(!(x)) {fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);exit(1);} } while(0)
+static HRESULT map_resource(ID3D11DeviceContext *c,ID3D11Resource *r,UINT sub,D3D11_MAP type,
+                            UINT flags,D3D11_MAPPED_SUBRESOURCE *m)
+{
+    if(r==(ID3D11Resource *)s_cb_prog) maps_program++;
+    if(r==(ID3D11Resource *)s_cb_vconst) maps_constants++;
+    if(r==(ID3D11Resource *)s_cb_ub) maps_ub++;
+    if(r==fail_resource) {fail_resource=NULL;return E_OUTOFMEMORY;}
+    return c->lpVtbl->Map(c,r,sub,type,flags,m);
+}
+static NvD3DState state(void)
+{
+    NvD3DState st={0};st.color_addr=0x20000;st.color_pitch=64*4;
+    st.surface_format=0x28;st.clip_w=st.clip_h=64;st.color_mask=0x01010101;
+    st.front_face=0x901;return st;
+}
+static void program(unsigned color_constant)
+{
+    memset(instructions,0,sizeof instructions);
+    /* MOV oPos,v0; MOV oD0,c[color_constant]; END. Identity xyzw swizzle. */
+    instructions[0][1]=(1u<<21)|0x1B;
+    instructions[0][2]=2u<<26;
+    instructions[0][3]=(15u<<12)|(1u<<11);
+    instructions[1][1]=(1u<<21)|(color_constant<<13)|0x1B;
+    instructions[1][2]=3u<<26;
+    instructions[1][3]=(15u<<12)|(1u<<11)|(3u<<3)|1;
+}
+static void triangle(void)
+{
+    NvD3DState st=state();float pos[3][4]={{8,8,0,1},{56,8,0,1},{8,56,0,1}};
+    NvD3DAttrib a[16]={0};float def[16][4]={{0}};uint32_t idx[3]={0,1,2};
+    a[0].enabled=1;a[0].type=2;a[0].size=4;a[0].stride=16;a[0].data=(const uint8_t *)pos;
+    nv2a_d3d_draw_ub(&st,NV_D3D_TRIANGLES,a,def,1,idx,3,0,2,NULL);
+}
+static void clear(void)
+{ NvD3DState st=state();nv2a_d3d_clear(&st,0xF0,0xFF000000,0,0,0,63,63); }
+static uint32_t pixel(void)
+{
+    Surface *s=surface_find(0x20000);ID3D11Texture2D *stage;
+    D3D11_TEXTURE2D_DESC d;D3D11_MAPPED_SUBRESOURCE m;uint32_t out;
+    CHECK(s);surface_resolve(s);ID3D11Texture2D_GetDesc(s->tex,&d);
+    d.Usage=D3D11_USAGE_STAGING;d.BindFlags=d.MiscFlags=0;d.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&d,NULL,&stage)));
+    ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)stage,(ID3D11Resource *)s->tex);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)stage,0,D3D11_MAP_READ,0,&m)));
+    memcpy(&out,(uint8_t *)m.pData+16*m.RowPitch+16*4,4);
+    ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)stage,0);ID3D11Texture2D_Release(stage);
+    return out;
+}
+static void first_draw(void)
+{
+    clear();triangle();CHECK(draws==1 && maps_program==1 && maps_constants==1 && maps_ub==1);
+    CHECK(pixel()==0xFFFF0000u);
+}
+static void test_version_zero(void)
+{
+    clear();fail_resource=(ID3D11Resource *)s_cb_prog;triangle();
+    CHECK(draws==0 && !fail_resource && maps_program==1 && maps_constants==0 && pixel()==0xFF000000u);
+    fail_resource=(ID3D11Resource *)s_cb_vconst;triangle();
+    CHECK(draws==0 && !fail_resource && maps_program==2 && maps_constants==1 && pixel()==0xFF000000u);
+    fail_resource=(ID3D11Resource *)s_cb_ub;triangle();
+    CHECK(draws==0 && !fail_resource && maps_program==2 && maps_constants==2 && maps_ub==1 && pixel()==0xFF000000u);
+    triangle();CHECK(draws==1 && maps_program==2 && maps_constants==2 && maps_ub==2);
+    CHECK(pixel()==0xFFFF0000u);
+    triangle();CHECK(draws==2 && maps_program==2 && maps_constants==2 && maps_ub==3);
+    CHECK(pixel()==0xFFFF0000u);
+    puts("PASS: valid version-zero MOV program/constants/per-draw failed uploads all retry, produce actual red pixels and reuse successful unchanged versions");
+}
+static void test_program(void)
+{
+    first_draw();program(1);program_version=1;clear();
+    UINT raw=s_raw_pos,index=s_ib_pos;fail_resource=(ID3D11Resource *)s_cb_prog;
+    triangle();CHECK(!fail_resource && draws==1 && maps_program==2);
+    CHECK(s_raw_pos==raw && s_ib_pos==index && pixel()==0xFF000000u);
+    triangle();CHECK(draws==2 && maps_program==3 && maps_constants==1);
+    CHECK(pixel()==0xFF00FF00u);
+    puts("PASS: failed changed program Map skips stale draw, retains ring positions and retries same version to actual green pixels");
+}
+static void test_constants(void)
+{
+    first_draw();constant_version=1;constants[0][0]=0;constants[0][2]=1;clear();
+    UINT raw=s_raw_pos,index=s_ib_pos;fail_resource=(ID3D11Resource *)s_cb_vconst;
+    triangle();CHECK(!fail_resource && draws==1 && maps_constants==2 && maps_program==1);
+    CHECK(s_raw_pos==raw && s_ib_pos==index && pixel()==0xFF000000u);
+    triangle();CHECK(draws==2 && maps_constants==3 && maps_program==1);
+    CHECK(pixel()==0xFF0000FFu);
+    /* A successful new program remains valid when its following constant Map
+     * fails: retry the constants without reuploading the successful program. */
+    program(1);program_version=2;constant_version=2;clear();fail_resource=(ID3D11Resource *)s_cb_vconst;
+    triangle();CHECK(draws==2 && maps_program==2 && maps_constants==4 && pixel()==0xFF000000u);
+    triangle();CHECK(draws==3 && maps_program==2 && maps_constants==5 && pixel()==0xFF00FF00u);
+    puts("PASS: failed constants retry, including after successful changed program; exact blue/green GPU pixels");
+}
+static void test_ub(void)
+{
+    first_draw();clear();UINT raw=s_raw_pos,index=s_ib_pos;
+    fail_resource=(ID3D11Resource *)s_cb_ub;triangle();CHECK(!fail_resource && draws==1 && maps_ub==2);
+    CHECK(s_raw_pos==raw && s_ib_pos==index && pixel()==0xFF000000u);
+    triangle();CHECK(draws==2 && maps_ub==3 && maps_program==1 && maps_constants==1);
+    CHECK(pixel()==0xFFFF0000u);
+    puts("PASS: failed per-draw vertex constants skip stale offsets; same-data retry produces exact red pixels");
+}
+static void test_rings(void)
+{
+    first_draw();program(1);program_version=1;clear();
+    s_raw_pos=VB_BYTES-16;s_ib_pos=IB_BYTES-4;fail_resource=(ID3D11Resource *)s_cb_prog;
+    triangle();CHECK(draws==1 && !fail_resource && s_raw_pos==0 && s_ib_pos==0 && pixel()==0xFF000000u);
+    triangle();CHECK(draws==2 && s_raw_pos==256 && s_ib_pos==256 && pixel()==0xFF00FF00u);
+    clear();fail_resource=(ID3D11Resource *)s_raw;triangle();CHECK(draws==2 && !fail_resource);
+    CHECK(s_raw_pos==256 && s_ib_pos==256 && pixel()==0xFF000000u);
+    triangle();CHECK(draws==3 && pixel()==0xFF00FF00u);
+    clear();fail_resource=(ID3D11Resource *)s_ib;UINT raw=s_raw_pos,index=s_ib_pos;
+    triangle();CHECK(draws==3 && !fail_resource && s_raw_pos==raw && s_ib_pos==index && pixel()==0xFF000000u);
+    triangle();CHECK(draws==4 && pixel()==0xFF00FF00u);
+    puts("PASS: failed program after real DISCARD wrap, raw/index Map failures and NO_OVERWRITE retries preserve ring positions and exact pixels");
+}
+int main(int argc,char **argv)
+{
+    CHECK(argc==2);_putenv_s("RECOMP_PS_SPEC","0");_putenv_s("RECOMP_MSAA","1");
+    _putenv_s("RECOMP_RENDER_SCALE","1");_putenv_s("RECOMP_FPS_LIMIT","0");
+    program(0);constants[0][0]=constants[0][3]=1;constants[1][1]=constants[1][3]=1;
+    CHECK(nv2a_d3d_init());
+    if(!strcmp(argv[1],"version_zero")) test_version_zero();
+    else if(!strcmp(argv[1],"program")) test_program();
+    else if(!strcmp(argv[1],"constants")) test_constants();
+    else if(!strcmp(argv[1],"ub")) test_ub();
+    else if(!strcmp(argv[1],"rings")) test_rings();
+    else CHECK(0);
+    return 0;
+}
