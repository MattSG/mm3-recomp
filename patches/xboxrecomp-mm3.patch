 ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
@@ -11,6 +12,130 @@ const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4] { retu
