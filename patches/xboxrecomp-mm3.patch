+        "max_ms=%.3f max_qpc_ms=%.3f va=%08X method=%04X subch=%u "
+        "count=%u param=%08X\n",
+        finished * ms, hitch->started * ms, wall, thread, start, end,
+        cpu / 10000.0, gap, words,
